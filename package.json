{
  "name": "keystarter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/validate.mjs && vite",
    "build": "node scripts/seo/generate-seo-data.mjs && node scripts/validate.mjs && npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "oxlint --ignore-pattern **/keystarter-v4/** --ignore-pattern **/tmp/** --ignore-pattern **/temp/** --ignore-pattern **/dist-seo-*/**",
    "precommit": "node scripts/validate.mjs && npm run typecheck && npm run lint",
    "preview": "vite preview",
    "build:seo": "vite build && python ../../_archive/seo_inject.py",
    "lint:portal": "node scripts/check-fixed-elements.mjs",
    "postinstall": "git config core.hooksPath .githooks",
    "validate": "node scripts/validate.mjs",
    "validate:fix": "node scripts/validate.mjs --fix",
    "prebuild": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "ssh2": "^1.17.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "sideEffects": [
    "./src/i18n.ts"
  ]
}
