#!/usr/bin/env bash
set -euo pipefail

TS=$(date +%Y%m%d-%H%M%S)
FRONT=/var/www/keystarter-frontend
BK=/var/www/backups/keystarter-frontend-$TS

mkdir -p /var/www/backups
cp -a "$FRONT" "$BK"
tar -xzf /tmp/dist-v33-contact-sales.tar.gz -C "$FRONT"
chown -R www-data:www-data "$FRONT"
find "$FRONT" -type d -exec chmod 755 {} +
find "$FRONT" -type f -exec chmod 644 {} +

echo "BACKUP=$BK"
echo "--- NEW JS ---"
grep -o 'index-[A-Za-z0-9_-]*\.js' "$FRONT/index.html" | head -1
echo "--- MD5 ---"
md5sum "$FRONT/index.html"
