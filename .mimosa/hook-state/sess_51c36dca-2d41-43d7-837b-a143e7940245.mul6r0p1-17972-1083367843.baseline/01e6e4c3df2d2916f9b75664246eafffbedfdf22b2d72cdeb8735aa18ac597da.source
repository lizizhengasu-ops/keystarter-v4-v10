import { useState, useEffect } from "react";
import { fetchProducts } from "../api/woocommerce";

export default function B2BPage() {
  const [products, setProducts] = useState([]);
  const [form, setForm] = useState({name:"",email:"",company:"",phone:"",productId:"",quantity:5,message:""});
  const [submitting, setSubmitting] = useState(false);
  const [done, setDone] = useState(false);
  const [err, setErr] = useState("");

  useEffect(() => { fetchProducts().then(setProducts).catch(() => {}); }, []);

  const handleChange = (e) => setForm({...form, [e.target.name]: e.target.value});
  const handleSubmit = async (e) => {
    e.preventDefault(); setSubmitting(true); setErr("");
    try {
      const r = await fetch("/api/b2b/inquiry", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(form) });
      if (!r.ok) throw new Error("Submit failed");
      setDone(true);
    } catch(e) { setErr(e.message); }
    setSubmitting(false);
  };

  if (done) return (
    <div className="min-h-screen bg-[#f5f5f7] text-[#1d1d1f] antialiased flex items-center justify-center">
      <div className="text-center max-w-md"><div className="text-4xl mb-4">?</div><h2 className="text-xl font-bold mb-2">Inquiry Received</h2><p className="text-sm text-[#86868b]">Our sales team will contact you within 24 hours.</p></div>
    </div>
  );

  return (
    <div className="bg-[#f5f5f7] text-[#1d1d1f] antialiased">
      <div className="bg-gradient-to-r from-[#1a1a2e] via-[#16213e] to-[#0f3460] text-white px-6 py-20 text-center">
        <h1 className="text-4xl sm:text-5xl font-bold mb-4">Enterprise Procurement</h1>
        <p className="text-lg font-light max-w-2xl mx-auto mb-8">Microsoft volume licensing for enterprises. Bulk pricing, dedicated support, instant delivery.</p>
      </div>
      <div className="max-w-3xl mx-auto px-6 py-16">
        <h2 className="text-2xl font-bold mb-6">Request a Quote</h2>
        <form onSubmit={handleSubmit} className="space-y-4">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><label className="text-xs font-semibold text-[#86868b]">Name</label><input name="name" required onChange={handleChange} className="w-full mt-1 p-2.5 border border-[#e8e8ed] rounded-lg text-sm" /></div>
            <div><label className="text-xs font-semibold text-[#86868b]">Email</label><input name="email" type="email" required onChange={handleChange} className="w-full mt-1 p-2.5 border border-[#e8e8ed] rounded-lg text-sm" /></div>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><label className="text-xs font-semibold text-[#86868b]">Company</label><input name="company" onChange={handleChange} className="w-full mt-1 p-2.5 border border-[#e8e8ed] rounded-lg text-sm" /></div>
            <div><label className="text-xs font-semibold text-[#86868b]">Phone</label><input name="phone" onChange={handleChange} className="w-full mt-1 p-2.5 border border-[#e8e8ed] rounded-lg text-sm" /></div>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><label className="text-xs font-semibold text-[#86868b]">Product</label>
              <select name="productId" onChange={handleChange} className="w-full mt-1 p-2.5 border border-[#e8e8ed] rounded-lg text-sm">
                <option value="">Select a product...</option>
                {products.map(p => <option key={p.id} value={p.id}>{p.name} - ${p.price}</option>)}
              </select>
            </div>
            <div><label className="text-xs font-semibold text-[#86868b]">Quantity</label><input name="quantity" type="number" min="1" value={form.quantity} onChange={handleChange} className="w-full mt-1 p-2.5 border border-[#e8e8ed] rounded-lg text-sm" /></div>
          </div>
          <div><label className="text-xs font-semibold text-[#86868b]">Message</label><textarea name="message" rows="4" onChange={handleChange} className="w-full mt-1 p-2.5 border border-[#e8e8ed] rounded-lg text-sm"></textarea></div>
          {err && <p className="text-red-500 text-xs">{err}</p>}
          <button disabled={submitting} className="w-full bg-[#0078d4] hover:bg-[#0062b1] text-white font-semibold py-3 rounded-xl transition disabled:opacity-50">{submitting ? "Submitting..." : "Submit Inquiry"}</button>
        </form>
      </div>
    </div>
  );
}
