          <a class="blog-card" href="blog-article.html?slug=windows-iot-enterprise-vs-windows-11-pro"><div class="img"><img src="assets/img/prod/wp-content__uploads__2026__08__04-windows-iot-enterprise-vs-windows-11-pro-cover.jpg" alt="Windows IoT vs Pro"></div><span class="tag">GUIDE</span><h3>Windows IoT Enterprise vs Windows 11 Pro</h3><p>LTSC lifecycle, kiosk scenarios and which SKU fits.</p></a>
          <a class="blog-card" href="blog-article.html?slug=how-to-activate-windows-11"><div class="img"><img src="assets/img/box-win11-pro.webp" alt="Windows 11 Pro"></div><span class="tag">GUIDE</span><h3>How to Activate Windows 11</h3><p>Step-by-step activation with a product key.</p></a>
          <a class="blog-card" href="blog-post.html?slug=windows-microsoft-ai-news-2026-08-27"><div class="img"><img src="assets/img/prod/og-cover.png" alt="Microsoft AI news"></div><span class="tag">NEWS</span><h3>Windows &amp; Microsoft AI News: ALLAM in Foundry</h3><p>Microsoft partnerships and AI gateway security.</p></a>
        </div>
      </div>
    </section>

    <section class="trust" id="{p}-trust">
      <div class="wrap trust-in">
        <div class="{p}-craft" data-craft="issue-flow">
          <svg viewBox="0 0 420 120" preserveAspectRatio="none" aria-hidden="true">
            <rect x="0" y="0" width="420" height="120" fill="none" stroke="currentColor" stroke-width="1"/>
            <path d="M40 0 V120 M140 0 V120 M240 0 V120 M340 0 V120 M0 40 H420 M0 80 H420" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="3 4"/>
            <path d="M70 120 L70 30 L170 30 L170 78 L300 78 L300 120" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="70" cy="30" r="3" fill="currentColor"/>
            <circle cx="170" cy="78" r="3" fill="currentColor"/>
            <circle cx="300" cy="78" r="3" fill="currentColor"/>
          </svg>
        </div>
        <div><span class="eyebrow">Payments you can rely on</span><h2 class="h2">Secure checkout, verified delivery</h2><p>Encrypted payment, genuine licenses and a numbered record for every order.</p></div>
        <div class="pay-badges"><span>VISA</span><span>MASTERCARD</span><span>PAYPAL</span><span>AMEX</span></div>
        <ul class="metrics"><li><b>10 min</b><span>avg delivery</span></li><li><b>100%</b><span>verified</span></li><li><b>14 day</b><span>refund</span></li></ul>
      </div>
    </section>

    <section class="newsletter" id="{p}-newsletter" data-newsletter>
      <div class="wrap newsletter-in">
        <div><span class="eyebrow">Stay updated</span><h3>Guides and offers, once a week.</h3></div>
        <form data-form><input type="email" placeholder="Your email" aria-label="Email"><button class="btn btn-accent" type="submit">Subscribe</button></form>
      </div>
    </section>'''
    if style in ("nova", "quartz"):
        common = common_nq(style, hero, best, newarr, story)
    if style == "terminal":
        persona = re.search(r'<section class="persona-strip".*?</section>', common, re.S).group(0)
        offers = re.search(r'<section class="offers".*?</section>', common, re.S).group(0)
        common = common.replace(persona + "\n\n", "").replace(offers + "\n\n", "")
        common = common.replace('<section class="sam"', offers + "\n\n    <section class=\"sam\"", 1)
        common = common.rstrip("\n") + "\n\n" + persona + "\n"
    return common


def product_page(style):
