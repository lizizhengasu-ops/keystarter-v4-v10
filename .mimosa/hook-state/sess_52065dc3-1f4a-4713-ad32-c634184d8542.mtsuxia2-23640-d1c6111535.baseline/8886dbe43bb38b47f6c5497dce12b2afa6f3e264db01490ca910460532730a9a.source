def page(style, title, desc, body, extra_scripts="", canonical="https://keys-starter.com/"):
    brand = STYLES[style]["brand"]
    return f'''<!doctype html>
<html lang="en" data-theme="{style}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content="{desc}">
  <link rel="canonical" href="{canonical}">
  <link rel="alternate" hreflang="en" href="{canonical}">
  <link rel="alternate" hreflang="ja" href="{canonical}?lang=ja">
  <link rel="alternate" hreflang="ko" href="{canonical}?lang=ko">
  <link rel="alternate" hreflang="es" href="{canonical}?lang=es">
  <link rel="alternate" hreflang="pt" href="{canonical}?lang=pt">
  <link rel="alternate" hreflang="fr" href="{canonical}?lang=fr">
  <link rel="alternate" hreflang="x-default" href="{canonical}">
  <link rel="stylesheet" href="assets/css/style.css">
  <link rel="stylesheet" href="assets/css/refined.css">
  <script type="application/ld+json">
  {{"@context":"https://schema.org","@type":"WebSite","name":"KeyStarter","url":"https://keys-starter.com/","potentialAction":{{"@type":"SearchAction","target":"https://keys-starter.com/products?q={{search_term_string}}","query-input":"required name=search_term_string"}}}}
  </script>
</head>
<body>
{chrome(style)}

  <main>
{body}
  </main>

{footer(style)}

{scripts(extra_scripts)}
</body>
</html>'''


def alias_rule(classes, prefix):
    aliases = sorted({prefix + "-" + re.sub(r"[^a-z0-9-]+", "-", c).strip("-") for c in classes if c})
    if not aliases:
        return ""
    return "\n" + ", ".join("." + a for a in aliases) + " { box-sizing: border-box; }\n"


BASE_CSS = r'''
:root {
  --ks-bg: #f6f7f9;
  --ks-ink: #0f1115;
  --ks-muted: #5b6270;
  --ks-line: #e2e6eb;
  --ks-card: #ffffff;
  --ks-accent: #635bff;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f0f1f6;
  --ks-warn: #b45309;
  --ks-font: "Plus Jakarta Sans", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 8px;
  --ks-shadow: 0 1px 2px rgba(15,17,21,.05), 0 10px 30px -22px rgba(15,17,21,.25);
  --ks-header: rgba(255,255,255,.86);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: var(--ks-font);
  background: var(--ks-bg);
  color: var(--ks-ink);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
input, select, textarea { font: inherit; color: inherit; }

.wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
.section { padding: 64px 0; }
.section.tight { padding: 44px 0; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
.section-head h1, .section-head h2, .section-head h3 { margin: 6px 0 0; }
.eyebrow {
  font-family: var(--ks-mono);
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--ks-accent);
  font-weight: 600;
}
.h1 { font-size: clamp(38px, 5.4vw, 72px); line-height: .98; letter-spacing: -.04em; margin: 12px 0; font-weight: 700; }
.h2 { font-size: clamp(26px, 3vw, 40px); line-height: 1.05; letter-spacing: -.03em; margin: 0; font-weight: 700; }
.h3 { font-size: 18px; line-height: 1.2; margin: 8px 0; font-weight: 650; }
.lead { font-size: 17px; color: var(--ks-muted); max-width: 620px; }
.muted { color: var(--ks-muted); }
.icon { width: 18px; height: 18px; vertical-align: middle; }
.icon-lg { width: 22px; height: 22px; }
.lg { width: 24px; height: 24px; }
.no { display: none; }

.announce {
  position: relative;
  z-index: 20;
  font-size: 12px;
  padding: 8px 18px;
  text-align: center;
  border-bottom: 1px solid var(--ks-line);
  background: var(--ks-card);
  color: var(--ks-muted);
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}
.announce a { color: var(--ks-accent); font-weight: 600; }
.promo-msg { font-family: var(--ks-mono); letter-spacing: .08em; font-size: 10px; color: var(--ks-ink); }

.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--ks-header);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--ks-line);
}
.header-in { display: flex; align-items: center; justify-content: space-between; min-height: 66px; gap: 20px; }
.brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; }
.brand small { display: block; font-family: var(--ks-mono); font-size: 9px; letter-spacing: .1em; color: var(--ks-muted); font-weight: 500; }
.brand-logo { width: 28px; height: 28px; object-fit: contain; }
.nav { display: flex; gap: 4px; font-size: 14px; }
.nav a { padding: 8px 11px; border-radius: 6px; color: var(--ks-muted); }
.nav a:hover, .nav a.active { color: var(--ks-ink); background: var(--ks-soft); }
.header-actions { display: flex; align-items: center; gap: 6px; }
.header-actions button { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 8px; color: var(--ks-muted); }
.header-actions button:hover { background: var(--ks-soft); color: var(--ks-ink); }
.count { font-size: 11px; margin-left: 3px; }
.lang { position: relative; }
.lang > button { width: auto; padding: 0 8px; gap: 4px; }
.lang .menu { display: none; position: absolute; right: 0; top: calc(100% + 6px); background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 10px; box-shadow: var(--ks-shadow); padding: 6px; min-width: 150px; z-index: 80; }
.lang.open .menu { display: grid; }
.lang .menu button { text-align: left; padding: 8px 10px; border-radius: 6px; }
.lang .menu button:hover { background: var(--ks-soft); }
.burger { display: none; }

.mega {
  display: none;
  position: absolute;
  left: 0; right: 0;
  top: 100%;
  background: var(--ks-card);
  border-bottom: 1px solid var(--ks-line);
  box-shadow: var(--ks-shadow);
  padding: 14px 24px;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  max-width: 720px;
  margin: 0 auto;
  border-radius: 0 0 12px 12px;
}
.header:hover .mega { display: grid; }
.mega a { display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: 8px; }
.mega a:hover { background: var(--ks-soft); }
.mega img { width: 46px; height: 46px; object-fit: contain; }
.mega span { flex: 1; font-size: 13px; font-weight: 600; }
.mega b { font-size: 13px; color: var(--ks-accent); }

.search-panel { display: none; padding: 16px 24px; border-bottom: 1px solid var(--ks-line); background: var(--ks-card); }
.search-panel.open { display: block; }
.search-box { max-width: 760px; margin: 0 auto; display: flex; align-items: center; gap: 12px; border: 1px solid var(--ks-line); border-radius: 10px; padding: 10px 14px; background: var(--ks-bg); }
.search-box input { flex: 1; border: 0; background: none; outline: none; font-size: 15px; }
.search-sign { font-family: var(--ks-mono); font-size: 11px; color: var(--ks-accent); letter-spacing: .08em; }

.cart-drawer { display: none; position: fixed; right: 0; top: 0; bottom: 0; width: 340px; max-width: 90vw; background: var(--ks-card); border-left: 1px solid var(--ks-line); box-shadow: -18px 0 50px rgba(15,17,21,.12); padding: 28px; z-index: 100; }
.cart-drawer.open { display: block; }
.cart-drawer h3 { margin: 0 0 8px; }
.cart-drawer p { color: var(--ks-muted); font-size: 14px; margin-bottom: 22px; }

.age-gate { position: fixed; inset: 0; z-index: 200; display: grid; place-content: center; background: rgba(15,17,21,.72); color: #fff; padding: 24px; text-align: center; }
.age-gate.done { display: none; }
.age-gate p { max-width: 420px; }

.mobile-nav { display: none; }
.chat-pop { position: fixed; right: 20px; bottom: 20px; z-index: 90; background: var(--ks-ink); color: #fff; padding: 12px 18px; border-radius: 999px; font-weight: 600; box-shadow: 0 12px 30px rgba(15,17,21,.25); }
.toast { position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 16px); background: var(--ks-ink); color: #fff; padding: 11px 16px; border-radius: 8px; opacity: 0; pointer-events: none; transition: .25s; z-index: 300; font-size: 14px; }
.toast.show { opacity: 1; transform: translate(-50%, 0); }

.footer { border-top: 1px solid var(--ks-line); background: var(--ks-card); margin-top: 40px; }
.footer-in { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; padding: 48px 24px 28px; }
.footer-in h4 { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--ks-muted); margin: 0 0 12px; }
.footer-in a { display: block; color: var(--ks-muted); padding: 4px 0; font-size: 14px; }
.footer-in a:hover { color: var(--ks-ink); }
.footer-lede { color: var(--ks-muted); font-size: 14px; max-width: 300px; }
.pay { display: flex; gap: 8px; margin-top: 18px; flex-wrap: wrap; }
.pay span, .pay-badge, .pay-badges span { font-family: var(--ks-mono); font-size: 10px; letter-spacing: .06em; padding: 5px 8px; border: 1px solid var(--ks-line); border-radius: 5px; color: var(--ks-muted); }
.footer-bottom { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-top: 1px solid var(--ks-line); padding: 16px 24px; font-size: 12px; color: var(--ks-muted); }

.breadcrumb { font-size: 13px; color: var(--ks-muted); margin: 18px 0 8px; }
.breadcrumb a { color: var(--ks-accent); }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
  transition: .16s ease;
}
.btn-lg { padding: 13px 20px; font-size: 15px; }
.btn-accent, .btn-primary { background: var(--ks-accent); color: var(--ks-accent-ink); }
.btn-accent:hover, .btn-primary:hover { filter: brightness(.96); transform: translateY(-1px); }
.btn-amber { background: var(--ks-warn); color: #fff; }
.btn-amber:hover { filter: brightness(.96); }
.btn-ghost { background: transparent; border-color: var(--ks-line); color: var(--ks-ink); }
.btn-ghost:hover { border-color: var(--ks-ink); }

.hero { padding: 72px 0 64px; position: relative; overflow: hidden; }
.hero .eyebrow { display: block; margin-bottom: 8px; }
.persona-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 1180px; margin: 0 auto; padding: 0 24px; }
.persona-card { display: flex; align-items: center; gap: 14px; border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; padding: 16px; }
.persona-card .icon-lg { width: 40px; height: 40px; display: grid; place-content: center; border-radius: 9px; background: var(--ks-soft); color: var(--ks-accent); font-family: var(--ks-mono); font-weight: 700; }
.persona-card b { display: block; font-size: 15px; }
.persona-card small { color: var(--ks-muted); }
.persona-card em { margin-left: auto; font-style: normal; color: var(--ks-accent); font-size: 13px; white-space: nowrap; }
.persona-card.accent { background: var(--ks-ink); color: #fff; border-color: var(--ks-ink); }
.persona-card.accent small { color: rgba(255,255,255,.65); }

.offers, .best, .new-arrivals, .sam, .model-picker, .support-center, .delivery, .reviews, .journal, .trust, .newsletter { padding: 64px 0; }
.offer-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.offer-item { display: flex; gap: 14px; border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; padding: 16px; align-items: center; }
.offer-item .img { width: 90px; height: 90px; display: grid; place-content: center; background: var(--ks-bg); border-radius: 8px; }
.offer-item img { width: 76px; height: 76px; object-fit: contain; }
.offer-item .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); letter-spacing: .08em; }
.offer-item h3 { margin: 6px 0 4px; font-size: 16px; }
.offer-item p { margin: 0 0 8px; color: var(--ks-muted); font-size: 13px; }
.offer-item b { color: var(--ks-accent); }

.rail-products { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; overflow-x: auto; }
.rail-card { border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; padding: 14px; }
.rail-card .img { height: 150px; display: grid; place-content: center; background: var(--ks-bg); border-radius: 8px; position: relative; margin-bottom: 12px; }
.rail-card img { max-height: 140px; object-fit: contain; }
.rail-card .badge { position: absolute; top: 8px; left: 8px; font-family: var(--ks-mono); font-size: 9px; letter-spacing: .08em; background: var(--ks-accent); color: #fff; padding: 4px 7px; border-radius: 4px; }
.rail-card h3 { font-size: 15px; margin: 6px 0; }
.rail-card .rating { color: var(--ks-muted); font-size: 12px; }
.rail-card .price { color: var(--ks-accent); font-size: 18px; }
.rail-card .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }

.new-table { border-top: 1px solid var(--ks-line); }
.new-row { display: grid; grid-template-columns: 70px 1fr auto auto; align-items: center; gap: 16px; border-bottom: 1px solid var(--ks-line); padding: 14px 8px; }
.new-row span { font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); }
.new-row img { width: 56px; height: 56px; object-fit: contain; }
.new-row b { font-size: 15px; }
.new-row small { display: block; color: var(--ks-muted); font-size: 12px; }
.new-row i { font-style: normal; font-weight: 700; color: var(--ks-accent); }
.new-row em { font-style: normal; font-size: 12px; color: var(--ks-muted); }
.new-row:hover { background: var(--ks-soft); }

.logo-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
.logo-row img { height: 28px; width: auto; opacity: .75; }
.sam-in { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
.b2b-quick { background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 12px; padding: 22px; display: grid; gap: 10px; }
.b2b-quick h3 { margin: 0 0 4px; }
.b2b-quick input, .b2b-quick select { border: 1px solid var(--ks-line); border-radius: 8px; padding: 10px 12px; background: var(--ks-bg); }

.model-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.model-item { border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; padding: 20px; }
.model-item span { font-family: var(--ks-mono); color: var(--ks-accent); font-size: 12px; }
.model-item h3 { font-size: 17px; margin: 8px 0; }
.model-item p { color: var(--ks-muted); font-size: 14px; }
.model-item em { font-style: normal; color: var(--ks-accent); font-size: 13px; }
.support-in { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.topic-grid a { border: 1px solid var(--ks-line); border-radius: 8px; padding: 12px; text-align: center; color: var(--ks-muted); }
.topic-grid a:hover { border-color: var(--ks-accent); color: var(--ks-accent); }
.step-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.step-item { border: 1px solid var(--ks-line); border-radius: 10px; padding: 18px; background: var(--ks-card); }
.step-item span { font-family: var(--ks-mono); color: var(--ks-accent); }
.step-item b { display: block; margin: 6px 0 2px; }
.step-item small { color: var(--ks-muted); }
.review-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.review-card { border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; padding: 18px; }
.review-card p { color: var(--ks-muted); font-size: 14px; }
.review-card .who { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.stars { color: #f59e0b; }
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.blog-card { border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; overflow: hidden; }
.blog-card .img { height: 150px; overflow: hidden; background: var(--ks-bg); }
.blog-card .img img { width: 100%; height: 100%; object-fit: cover; }
.blog-card .tag { display: inline-block; font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); margin: 12px 0 0 12px; }
.blog-card h3 { font-size: 16px; margin: 8px 12px; }
.blog-card p { color: var(--ks-muted); font-size: 13px; margin: 0 12px 14px; }
.trust-in { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; }
.pay-badges { display: flex; gap: 8px; flex-wrap: wrap; }
.metrics { list-style: none; display: flex; gap: 22px; padding: 0; margin: 0; }
.metrics b { display: block; font-size: 18px; }
.metrics span { color: var(--ks-muted); font-size: 12px; }
.newsletter-in { display: flex; justify-content: space-between; align-items: center; gap: 20px; border: 1px solid var(--ks-line); border-radius: 12px; padding: 26px; background: var(--ks-card); }
.newsletter-in form { display: flex; gap: 8px; }
.newsletter-in input { border: 1px solid var(--ks-line); border-radius: 8px; padding: 10px 12px; width: 260px; background: var(--ks-bg); }

.filter-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 20px 0; }
.chip { border: 1px solid var(--ks-line); border-radius: 999px; padding: 7px 14px; font-size: 13px; color: var(--ks-muted); }
.chip.on { background: var(--ks-ink); color: #fff; border-color: var(--ks-ink); }
.filter-bar .count { margin-left: auto; color: var(--ks-muted); font-size: 13px; }
.filter-bar select { border: 1px solid var(--ks-line); border-radius: 8px; padding: 7px 10px; background: var(--ks-card); }
.prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.prod-card { border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; padding: 14px; }
.prod-card .img { height: 150px; display: grid; place-content: center; background: var(--ks-bg); border-radius: 8px; position: relative; }
.prod-card img { max-height: 140px; object-fit: contain; }
.prod-card .badge { position: absolute; top: 8px; left: 8px; font-family: var(--ks-mono); font-size: 9px; background: var(--ks-accent); color: #fff; padding: 4px 7px; border-radius: 4px; }
.prod-card h3 { font-size: 14px; margin: 10px 0 4px; }
.prod-card .rating { color: var(--ks-muted); font-size: 12px; }
.prod-card .prices b { color: var(--ks-accent); font-size: 17px; }
.prod-card .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }

.compare-table { overflow-x: auto; max-width: 100%; border: 1px solid var(--ks-line); border-radius: 12px; background: var(--ks-card); }
.compare-table table { width: 100%; border-collapse: collapse; min-width: 680px; }
.compare-table th, .compare-table td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--ks-line); font-size: 14px; }
.compare-table thead th { background: var(--ks-soft); font-size: 13px; }
.detail-table { width: 100%; border-collapse: collapse; }
.detail-table th, .detail-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--ks-line); font-size: 14px; }
.detail-table th { color: var(--ks-muted); width: 34%; }

.pdp { display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; padding: 24px 0 56px; }
.pdp-media { border: 1px solid var(--ks-line); border-radius: 14px; padding: 22px; background: var(--ks-card); display: grid; place-content: center; min-height: 420px; }
.pdp-media img { max-height: 360px; object-fit: contain; }
.thumb { margin-top: 14px; }
.thumb span { display: inline-block; border: 1px solid var(--ks-line); border-radius: 8px; padding: 6px; }
.thumb img { width: 70px; height: 70px; object-fit: contain; }
.pdp-price { display: flex; gap: 12px; align-items: baseline; margin: 12px 0; }
.pdp-price .now { font-size: 34px; font-weight: 750; letter-spacing: -.02em; }
.pdp-price .save { color: var(--ks-muted); font-size: 13px; }
.pdp-rating { color: var(--ks-muted); margin-bottom: 12px; font-size: 14px; }
.pdp-rating a { color: var(--ks-accent); margin-left: 8px; }
.pdp-msg { color: var(--ks-muted); }
.pdp-cta { display: flex; gap: 10px; margin: 18px 0; flex-wrap: wrap; }
.pdp-pay { display: flex; gap: 8px; align-items: center; margin: 12px 0; flex-wrap: wrap; color: var(--ks-muted); font-size: 13px; }
.pdp-trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.pdp-trust .item { display: flex; gap: 8px; align-items: flex-start; border: 1px solid var(--ks-line); border-radius: 8px; padding: 10px; font-size: 12px; }
.pdp-trust .item b { display: block; font-size: 12px; }
.pdp-trust .item div { color: var(--ks-muted); line-height: 1.35; }
.pdp-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--ks-line); margin: 26px 0 16px; flex-wrap: wrap; }
.pdp-tabs button { padding: 10px 12px; color: var(--ks-muted); font-size: 14px; border-bottom: 2px solid transparent; }
.pdp-tabs button.on { color: var(--ks-ink); border-bottom-color: var(--ks-accent); font-weight: 600; }
.pdp-panel { display: none; }
.pdp-panel.on { display: block; }
.faq details { border: 1px solid var(--ks-line); border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; background: var(--ks-card); }
.faq summary { font-weight: 600; cursor: pointer; }
.faq p { color: var(--ks-muted); margin: 8px 0 0; }
.b2b-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.b2b-step { border: 1px solid var(--ks-line); border-radius: 10px; padding: 16px; background: var(--ks-card); }
.b2b-step span { font-family: var(--ks-mono); color: var(--ks-accent); }
.review-summary { display: grid; grid-template-columns: 180px 1fr; gap: 20px; margin: 22px 0; }
.review-score { border: 1px solid var(--ks-line); border-radius: 12px; padding: 20px; text-align: center; }
.review-score .num { font-size: 40px; font-weight: 750; }

.b2b-hero { padding: 70px 0 60px; position: relative; }
.b2b-hero .bg { position: absolute; inset: 0; background: linear-gradient(120deg, var(--ks-soft), transparent 60%); }
.b2b-hero-in { position: relative; max-width: 900px; }
.checks { list-style: none; padding: 0; margin: 22px 0; display: grid; gap: 8px; }
.checks li { display: flex; align-items: center; gap: 10px; color: var(--ks-muted); }
.checks .icon { color: var(--ks-accent); }
.cta { display: flex; gap: 10px; flex-wrap: wrap; }
.industry-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.industry-card { border: 1px solid var(--ks-line); border-radius: 12px; overflow: hidden; background: var(--ks-card); }
.industry-card img { width: 100%; height: 130px; object-fit: cover; }
.industry-card b { display: block; padding: 12px 12px 2px; }
.industry-card small { display: block; padding: 0 12px 12px; color: var(--ks-muted); }
.why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.why-card { border: 1px solid var(--ks-line); border-radius: 10px; padding: 16px; background: var(--ks-card); }
.why-card .ic { width: 40px; height: 40px; display: grid; place-content: center; border-radius: 9px; background: var(--ks-soft); color: var(--ks-accent); }
.why-card h3 { margin: 10px 0 4px; }
.why-card p { color: var(--ks-muted); font-size: 13px; margin: 0; }
.cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.cat-card { border: 1px solid var(--ks-line); border-radius: 10px; padding: 16px; background: var(--ks-card); }
.cat-card h3 { margin: 0 0 4px; font-size: 15px; }
.cat-card small { color: var(--ks-muted); }
.case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.case-card { border: 1px solid var(--ks-line); border-radius: 10px; padding: 18px; background: var(--ks-card); }
.case-card .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.case-card h3 { margin: 8px 0; }
.case-card p { color: var(--ks-muted); font-size: 13px; }
.case-card .metric { font-family: var(--ks-mono); color: var(--ks-accent); font-size: 12px; margin-top: 10px; }
.b2b-split { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.b2b-form { border: 1px solid var(--ks-line); border-radius: 14px; background: var(--ks-card); padding: 22px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.field { display: grid; gap: 6px; }
.field label { font-size: 12px; color: var(--ks-muted); }
.field input, .field textarea { border: 1px solid var(--ks-line); border-radius: 8px; padding: 10px 12px; background: var(--ks-bg); }
.field.full { grid-column: 1 / -1; }
.promise { display: flex; align-items: center; gap: 8px; color: var(--ks-muted); font-size: 13px; margin-top: 14px; }

.support-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 40px; }
.support-card { border: 1px solid var(--ks-line); border-radius: 10px; padding: 18px; background: var(--ks-card); }
.support-card .ic { width: 38px; height: 38px; display: grid; place-content: center; border-radius: 8px; background: var(--ks-soft); color: var(--ks-accent); }
.support-card h3 { margin: 10px 0 4px; }
.support-card p { color: var(--ks-muted); font-size: 13px; }
.support-card a { color: var(--ks-accent); font-size: 13px; }
.help-topics { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 0; margin: 0 0 40px; }
.help-topics li { border: 1px solid var(--ks-line); border-radius: 8px; padding: 12px 14px; display: flex; justify-content: space-between; gap: 12px; font-size: 14px; }
.help-topics span { color: var(--ks-muted); font-size: 12px; white-space: nowrap; }

.about-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.about-lead { font-size: 18px; color: var(--ks-muted); max-width: 640px; }
.about-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 24px 0; }
.about-stats .about-section, .about-stats .about-cols { grid-column: 1 / -1; }
.about-badge { border: 1px solid var(--ks-line); border-radius: 10px; padding: 16px; background: var(--ks-card); }
.about-badge b { display: block; font-size: 20px; }
.about-badge span { color: var(--ks-muted); font-size: 13px; }
.about-badge-row { display: flex; gap: 12px; flex-wrap: wrap; }
.about-section { margin: 40px 0; }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.contact-card { border: 1px solid var(--ks-line); border-radius: 10px; padding: 18px; background: var(--ks-card); }
.contact-list { list-style: none; padding: 0; display: grid; gap: 8px; color: var(--ks-muted); }
.cart-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 30px; }
.cart-item { display: grid; grid-template-columns: 70px 1fr auto; gap: 14px; align-items: center; border: 1px solid var(--ks-line); border-radius: 10px; padding: 14px; background: var(--ks-card); margin-bottom: 10px; }
.cart-item img { width: 60px; height: 60px; object-fit: contain; }
.cart-summary { border: 1px solid var(--ks-line); border-radius: 12px; padding: 20px; background: var(--ks-card); height: fit-content; }
.cart-summary .total { font-size: 22px; font-weight: 750; }
.qty { border: 1px solid var(--ks-line); border-radius: 6px; padding: 4px 8px; }
.licensing-visuals { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.feature-list { list-style: none; padding: 0; display: grid; gap: 8px; }
.feature-list li { display: flex; gap: 8px; align-items: center; color: var(--ks-muted); }
.article { max-width: 760px; }
.article-extras { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
.toc { border: 1px solid var(--ks-line); border-radius: 10px; padding: 16px 18px; background: var(--ks-card); }
.toc a { display: block; padding: 4px 0; color: var(--ks-muted); }
.refs { font-size: 13px; color: var(--ks-muted); }
.meta { font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); }
.quote { border-left: 3px solid var(--ks-accent); padding: 10px 16px; color: var(--ks-muted); margin: 18px 0; }
.stat-card { border: 1px solid var(--ks-line); border-radius: 10px; padding: 16px; background: var(--ks-card); }
.row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.sub { color: var(--ks-muted); }
.secure { color: var(--ks-accent); }
.name { font-weight: 700; }
.note { font-size: 12px; color: var(--ks-muted); }
.item { display: inline-flex; align-items: center; gap: 8px; }
.alt { color: var(--ks-muted); }
.more { color: var(--ks-accent); }
.bg { position: absolute; inset: 0; }
.yes { color: #16a34a; }
.no { color: #dc2626; }
.on { display: block; }

@media (max-width: 960px) {
  .nav { display: none; }
  .burger { display: inline-flex; }
  .mobile-nav { display: none; position: fixed; inset: 0; background: var(--ks-card); padding: 90px 24px 24px; z-index: 60; overflow: auto; }
  .mobile-nav.open { display: flex; flex-direction: column; gap: 8px; font-size: 20px; }
  .mobile-nav .lang-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
  .mobile-nav .lang-row button { border: 1px solid var(--ks-line); border-radius: 8px; padding: 8px 10px; }
  .rail-products, .prod-grid { grid-template-columns: repeat(2, 1fr); }
  .offer-row, .model-row, .blog-grid, .review-list, .support-grid, .industry-grid, .cat-grid, .case-grid { grid-template-columns: repeat(2, 1fr); }
  .pdp, .sam-in, .support-in, .b2b-split, .about-cols, .contact-grid, .cart-layout, .trust-in { grid-template-columns: 1fr; }
  .ksp-hero-in, .kst-ecosystem .wrap { grid-template-columns: 1fr; }
  .b2b-steps { grid-template-columns: repeat(2, 1fr); }
  .strata-row { grid-template-columns: 64px 1fr auto; }
  .footer-in { grid-template-columns: 1fr 1fr; }
  .step-row { grid-template-columns: repeat(2, 1fr); }
  .newsletter-in { flex-direction: column; align-items: stretch; }
  .newsletter-in form { flex-direction: column; }
  .newsletter-in input { width: 100%; }
}

@media (max-width: 620px) {
  .wrap { padding: 0 16px; }
  .h1 { font-size: 40px; }
  .rail-products, .prod-grid, .offer-row, .model-row, .blog-grid, .review-list, .support-grid, .industry-grid, .cat-grid, .case-grid, .why-grid { grid-template-columns: 1fr; }
  .persona-strip { grid-template-columns: 1fr; }
  .pdp-trust { grid-template-columns: 1fr 1fr; }
  .footer-in { grid-template-columns: 1fr; }
  .filter-bar select { width: 100%; }
  .help-topics { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
  .row { grid-template-columns: 1fr; }
  .b2b-steps { grid-template-columns: 1fr; }
  .strata-row { grid-template-columns: 64px 1fr; }
  .strata-row em { display: none; }
  .about-stats { grid-template-columns: repeat(2, 1fr); }
  .section { padding: 42px 0; }
}
'''

PAPER_CSS = r'''
[data-theme="paper"] {
  --ks-bg: #f6f7f9;
  --ks-ink: #0f1115;
  --ks-muted: #5b6270;
  --ks-line: #e2e6eb;
  --ks-card: #ffffff;
  --ks-accent: #635bff;
  --ks-accent-ink: #ffffff;
  --ks-soft: #eef0f6;
  --ks-warn: #b45309;
  --ks-font: "Plus Jakarta Sans", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 8px;
  --ks-shadow: 0 1px 2px rgba(15,17,21,.05), 0 16px 40px -30px rgba(15,17,21,.3);
  --ks-header: rgba(255,255,255,.86);
}

@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

.ksp-hero { background: linear-gradient(180deg, #ffffff 0%, var(--ks-bg) 100%); padding: 84px 0 72px; }
.ksp-hero-in { display: grid; justify-items: center; text-align: center; gap: 22px; max-width: 960px; }
.ksp-hero-in .lead { margin: 0 auto; }
.ksp-cta { display: flex; gap: 10px; flex-wrap: wrap; }
.ksp-trust { display: flex; gap: 22px; margin-top: 26px; flex-wrap: wrap; }
.ksp-trust span { font-size: 13px; color: var(--ks-muted); }
.ksp-trust b { display: block; color: var(--ks-ink); font-size: 17px; }
.ksp-console {
  max-width: 820px;
  width: 100%;
  border: 1px solid var(--ks-line);
  border-radius: 16px;
  background: var(--ks-card);
  box-shadow: var(--ks-shadow);
  padding: 24px;
  position: relative;
}
.ksp-console-head { display: flex; justify-content: space-between; gap: 10px; font-family: var(--ks-mono); font-size: 10px; letter-spacing: .12em; color: var(--ks-muted); padding-bottom: 14px; border-bottom: 1px solid var(--ks-line); }
.ksp-console-head b { color: #16a34a; }
.ksp-console-key { font-family: var(--ks-mono); font-size: 15px; letter-spacing: .08em; background: var(--ks-soft); border-radius: 8px; padding: 14px; margin: 16px 0; }
.ksp-console-rows { display: grid; gap: 8px; margin: 0; }
.ksp-console-rows div { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px dashed var(--ks-line); padding: 8px 0; font-size: 13px; }
.ksp-console-rows dt { color: var(--ks-muted); }
.ksp-console-rows dd { margin: 0; font-weight: 600; }
.ksp-console-cta { display: flex; gap: 10px; margin-top: 18px; }
.ksp-craft { color: var(--ks-accent); opacity: .6; }
.ksp-hero-etch { margin-top: 34px; }
.ksp-hero-etch svg { width: 100%; height: 46px; }

.ksp-best { background: var(--ks-card); border-top: 1px solid var(--ks-line); border-bottom: 1px solid var(--ks-line); }
.mono-list { display: grid; }
.mono-row {
  display: grid;
  grid-template-columns: 120px 1fr 180px 160px auto;
  gap: 18px;
  align-items: center;
  border-bottom: 1px solid var(--ks-line);
  padding: 16px 8px;
}
.mono-row:first-child { border-top: 1px solid var(--ks-line); }
.mono-row:hover { background: var(--ks-soft); }
.mono-row .img { width: 110px; height: 110px; display: grid; place-content: center; background: var(--ks-bg); border-radius: 10px; }
.mono-row img { max-height: 100px; object-fit: contain; }
.mono-row .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.mono-row h3 { font-size: 17px; margin: 6px 0; }
.mono-row small { color: var(--ks-muted); }
.mono-row .rating { color: var(--ks-muted); font-size: 12px; }
.mono-row .price { font-size: 20px; font-weight: 750; color: var(--ks-ink); }
.mono-row .actions { display: flex; gap: 8px; }

.blue-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.blue-tile { border: 1px solid var(--ks-line); border-radius: 12px; overflow: hidden; background: var(--ks-card); transition: .18s; }
.blue-tile:hover { box-shadow: var(--ks-shadow); transform: translateY(-2px); }
.blue-tile .img { height: 150px; display: grid; place-content: center; background: var(--ks-bg); }
.blue-tile img { max-height: 140px; object-fit: contain; }
.blue-tile .body { padding: 14px; }
.blue-tile span { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.blue-tile h3 { font-size: 15px; margin: 8px 0 4px; }
.blue-tile small { color: var(--ks-muted); display: block; }
.blue-tile .price { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; }
.blue-tile .price b { font-size: 18px; }
.blue-tile .price a { font-size: 13px; color: var(--ks-accent); }

.ksp-ecosystem { background: var(--ks-card); border-top: 1px solid var(--ks-line); }
.ksp-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.ksp-elevation svg { width: 100%; height: 170px; color: var(--ks-accent); opacity: .75; }

.ksp-craft-flow svg { width: 100%; height: 120px; color: var(--ks-accent); opacity: .6; }
.ksp-model { background: var(--ks-card); border-top: 1px solid var(--ks-line); }
.ksp-support { background: var(--ks-soft); border-top: 1px solid var(--ks-line); }

#pdp-root[data-page-model="issue-slip"] .pdp-media { position: relative; }
#pdp-root[data-page-model="issue-slip"] .pdp-media::after {
  content: "ISSUE SLIP";
  position: absolute;
  top: 16px; right: 16px;
  font-family: var(--ks-mono);
  font-size: 10px;
  letter-spacing: .12em;
  color: var(--ks-accent);
  border: 1px solid var(--ks-line);
  border-radius: 999px;
  padding: 6px 10px;
  background: var(--ks-card);
}
.ksp-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); border-bottom: 1px solid var(--ks-line); padding-bottom: 12px; margin-bottom: 16px; }
.ksp-pdp-bar b { color: #16a34a; }
.ksp-pdp-bar i { font-style: normal; margin-left: auto; }
'''

TERMINAL_CSS = r'''
[data-theme="terminal"] {
  --ks-bg: #090b10;
  --ks-ink: #e6e9f0;
  --ks-muted: #8b93a7;
  --ks-line: #1c2230;
  --ks-card: #10141d;
  --ks-accent: #7c6cff;
  --ks-accent-ink: #ffffff;
  --ks-soft: #151b27;
  --ks-warn: #f59e0b;
  --ks-font: "Sora", sans-serif;
  --ks-mono: "JetBrains Mono", monospace;
  --ks-radius: 6px;
  --ks-shadow: 0 0 0 1px rgba(255,255,255,.03), 0 20px 50px -30px rgba(0,0,0,.9);
  --ks-header: rgba(9,11,16,.88);
}

@font-face { font-family: "Sora"; src: url("../fonts/sora-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Sora"; src: url("../fonts/sora-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Sora"; src: url("../fonts/sora-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "JetBrains Mono"; src: url("../fonts/jetbrains-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "JetBrains Mono"; src: url("../fonts/jetbrains-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

body { background: var(--ks-bg); color: var(--ks-ink); }
.announce { background: #0d1118; border-color: var(--ks-line); }
.header { background: var(--ks-header); }
.kst-hero { padding: 74px 0 70px; }
.kst-hero-in { max-width: 900px; margin: 0 auto; display: grid; justify-items: center; text-align: center; gap: 26px; }
.kst-hero-in .lead { margin: 0 auto; }
.kst-cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
.kst-trust { display: flex; gap: 22px; justify-content: center; margin-top: 8px; flex-wrap: wrap; }
.kst-trust span { font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); }
.kst-trust b { display: block; color: var(--ks-accent); font-size: 18px; }
.kst-terminal {
  width: min(720px, 100%);
  border: 1px solid var(--ks-line);
  border-radius: 10px;
  background: #0c1018;
  box-shadow: var(--ks-shadow);
  text-align: left;
  overflow: hidden;
}
.kst-terminal-head { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--ks-line); }
.kst-dot { width: 10px; height: 10px; border-radius: 50%; background: #2a3140; }
.kst-dot:nth-child(1) { background: #ff5f57; }
.kst-dot:nth-child(2) { background: #febc2e; }
.kst-dot:nth-child(3) { background: #28c840; }
.kst-terminal-head span { margin-left: auto; font-family: var(--ks-mono); font-size: 10px; color: var(--ks-muted); }
.kst-terminal-body { padding: 18px; font-family: var(--ks-mono); font-size: 13px; line-height: 1.8; }
.kst-line { display: flex; gap: 12px; }
.kst-line .prompt { color: var(--ks-accent); }
.kst-line .ok { color: #34d399; }
.kst-line .dim { color: var(--ks-muted); }
.kst-line .key { color: var(--ks-ink); }
.kst-craft { color: var(--ks-accent); opacity: .55; }
.kst-signal svg { width: 100%; height: 120px; }

.kst-best { background: #0b0e15; border-top: 1px solid var(--ks-line); }
.slab-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.slab-card { display: grid; grid-template-columns: 1fr auto; gap: 16px; border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 10px; padding: 18px; }
.slab-card .img { width: 130px; height: 130px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 8px; }
.slab-card img { max-height: 120px; object-fit: contain; }
.slab-card .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.slab-card h3 { font-size: 17px; margin: 8px 0 4px; }
.slab-card small { color: var(--ks-muted); display: block; }
.slab-card .rating { color: var(--ks-muted); font-size: 12px; margin: 6px 0; }
.slab-card .price { font-family: var(--ks-mono); font-size: 20px; color: var(--ks-accent); }
.slab-card .actions { display: flex; gap: 8px; margin-top: 12px; }

.strata-rail { display: grid; gap: 8px; }
.strata-row { display: grid; grid-template-columns: 84px 1fr 140px auto; gap: 16px; align-items: center; border: 1px solid var(--ks-line); background: var(--ks-card); border-radius: 8px; padding: 10px 14px; }
.strata-row img { width: 68px; height: 68px; object-fit: contain; }
.strata-row b { font-size: 15px; }
.strata-row small { display: block; color: var(--ks-muted); font-size: 12px; }
.strata-row i { font-style: normal; font-family: var(--ks-mono); color: var(--ks-accent); }
.strata-row em { font-style: normal; color: var(--ks-muted); font-size: 12px; }
.strata-row:hover { border-color: var(--ks-accent); }

.kst-ecosystem { border-top: 1px solid var(--ks-line); }
.kst-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.kst-strata svg { width: 100%; height: 180px; color: var(--ks-accent); opacity: .6; }
.kst-telemetry svg { width: 100%; height: 130px; color: var(--ks-accent); opacity: .55; }

.kst-status-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.kst-status { border: 1px solid var(--ks-line); border-radius: 8px; padding: 12px; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); background: var(--ks-card); }
.kst-status b { display: block; color: #34d399; font-size: 15px; margin-top: 4px; }

#pdp-root[data-page-model="terminal-order"] { max-width: 1080px; }
#pdp-root[data-page-model="terminal-order"] .pdp { grid-template-columns: 1fr 1fr; gap: 26px; }
#pdp-root[data-page-model="terminal-order"] .pdp-media { border-radius: 8px; border-color: var(--ks-line); background: var(--ks-card); min-height: 380px; }
#pdp-root[data-page-model="terminal-order"] .pdp-info { border: 1px solid var(--ks-line); border-radius: 8px; padding: 22px; background: var(--ks-card); }
.kst-pdp-strip { border: 1px solid var(--ks-line); border-radius: 8px; padding: 14px 16px; margin: 16px 0 22px; background: var(--ks-card); display: grid; gap: 10px; }
.kst-pdp-key { font-family: var(--ks-mono); font-size: 14px; letter-spacing: .08em; background: var(--ks-soft); border-radius: 6px; padding: 10px 12px; }
.kst-pdp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; padding: 10px 0 30px; }
.kst-order-console { border: 1px solid var(--ks-line); border-radius: 8px; padding: 20px; background: var(--ks-card); }
.kst-pdp-panels { border-top: 1px solid var(--ks-line); padding-top: 20px; margin-bottom: 40px; }
.kst-pdp-bar { display: flex; gap: 10px; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); border-bottom: 1px solid var(--ks-line); padding-bottom: 12px; margin-bottom: 16px; }
.kst-pdp-bar b { color: #34d399; }
.kst-pdp-bar i { font-style: normal; margin-left: auto; }

.prod-ledger { display: grid; gap: 8px; }
.ledger-row { display: grid; grid-template-columns: 80px 1fr 120px 170px auto; gap: 16px; align-items: center; border: 1px solid var(--ks-line); border-radius: 8px; padding: 10px 14px; background: var(--ks-card); }
.ledger-row img { width: 64px; height: 64px; object-fit: contain; }
.ledger-row h3 { font-size: 14px; margin: 0; }
.ledger-row small { color: var(--ks-muted); font-size: 12px; }
.ledger-row .rating { color: var(--ks-muted); font-size: 12px; }
.ledger-row .price { font-family: var(--ks-mono); color: var(--ks-accent); }
.ledger-row .actions { display: flex; gap: 8px; }

@media (max-width: 960px) {
  .slab-grid { grid-template-columns: 1fr; }
  .kst-ecosystem .wrap { grid-template-columns: 1fr; }
  .kst-status-strip { grid-template-columns: repeat(2, 1fr); }
  .ledger-row { grid-template-columns: 80px 1fr auto; }
  .ledger-row .rating, .ledger-row .actions { grid-column: 2 / -1; }
  .kst-pdp-grid { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .mono-row { grid-template-columns: 90px 1fr; }
  .mono-row .actions { grid-column: 1 / -1; }
  .blue-grid { grid-template-columns: 1fr; }
  .slab-card { grid-template-columns: 1fr; }
  .kst-status-strip { grid-template-columns: 1fr; }
  #pdp-root[data-page-model="terminal-order"] .pdp { grid-template-columns: 1fr; }
}
'''

MOBILE_FIX_CSS = r'''
@media (max-width: 960px) {
  .ksp-hero-in, .kst-ecosystem .wrap { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .ksp-hero-in, .kst-ecosystem .wrap { grid-template-columns: 1fr; }
  .strata-row { grid-template-columns: 64px 1fr; }
  .strata-row em { display: none; }
  .mono-row { grid-template-columns: 90px 1fr; }
  .mono-row .img { grid-row: 1 / span 3; }
  .mono-row .price { grid-column: 2; }
  .mono-row .actions { grid-column: 1 / -1; }
  .mono-row .rating { display: none; }
}
'''

MERCURY_CSS = r'''
[data-theme="mercury"] {
  --ks-bg: #f5f5f7;
  --ks-ink: #1d1d1f;
  --ks-muted: #6e6e73;
  --ks-line: #d8d8dc;
  --ks-card: #ffffff;
  --ks-accent: #0066cc;
  --ks-accent-ink: #ffffff;
  --ks-soft: #ececf0;
  --ks-warn: #0071e3;
  --ks-font: "Plus Jakarta Sans", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 18px;
  --ks-shadow: 0 2px 10px rgba(29,29,31,.05), 0 22px 60px -42px rgba(29,29,31,.35);
  --ks-header: rgba(245,245,247,.82);
}
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

.ksm-hero { background: linear-gradient(180deg, #ffffff 0%, var(--ks-bg) 100%); padding: 96px 0 80px; text-align: center; }
.ksm-hero-in { display: grid; justify-items: center; gap: 28px; max-width: 1080px; }
.ksm-hero-in .lead { margin: 0 auto; max-width: 640px; }
.ksm-cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
.ksm-trust { display: flex; gap: 26px; justify-content: center; margin-top: 4px; flex-wrap: wrap; }
.ksm-trust span { font-size: 13px; color: var(--ks-muted); }
.ksm-trust b { display: block; color: var(--ks-ink); font-size: 17px; }
.ksm-modules { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; width: 100%; max-width: 980px; margin-top: 12px; }
.ksm-module { background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 22px; padding: 18px; text-align: left; transition: .2s; }
.ksm-module:hover { transform: translateY(-3px); box-shadow: var(--ks-shadow); }
.ksm-module .img { height: 150px; display: grid; place-content: center; background: var(--ks-bg); border-radius: 16px; }
.ksm-module img { max-height: 140px; object-fit: contain; }
.ksm-module span { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksm-module h3 { font-size: 16px; margin: 10px 0 4px; }
.ksm-module small { color: var(--ks-muted); display: block; }
.ksm-module b { color: var(--ks-accent); display: block; margin-top: 10px; font-size: 18px; }
.ksm-craft { color: var(--ks-accent); opacity: .45; }
.ksm-craft svg { width: 100%; height: 110px; }

.ksm-best { background: var(--ks-card); border-top: 1px solid var(--ks-line); border-bottom: 1px solid var(--ks-line); }
.index-rows { display: grid; }
.index-row { display: grid; grid-template-columns: 90px 130px 1fr 180px 160px auto; gap: 18px; align-items: center; border-bottom: 1px solid var(--ks-line); padding: 16px 6px; }
.index-row:first-child { border-top: 1px solid var(--ks-line); }
.index-row:hover { background: var(--ks-bg); }
.index-row .num { font-family: var(--ks-mono); font-size: 13px; color: var(--ks-muted); }
.index-row .img { width: 120px; height: 120px; display: grid; place-content: center; background: var(--ks-bg); border-radius: 16px; }
.index-row img { max-height: 110px; object-fit: contain; }
.index-row .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.index-row h3 { font-size: 17px; margin: 6px 0; }
.index-row small { color: var(--ks-muted); }
.index-row .rating { color: var(--ks-muted); font-size: 12px; }
.index-row .price { font-size: 20px; font-weight: 750; }
.index-row .actions { display: flex; gap: 8px; }

.spec-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.spec-card { border: 1px solid var(--ks-line); border-radius: 20px; background: var(--ks-card); padding: 14px; }
.spec-card .img { height: 150px; display: grid; place-content: center; background: var(--ks-bg); border-radius: 14px; }
.spec-card img { max-height: 140px; object-fit: contain; }
.spec-card h3 { font-size: 15px; margin: 10px 0 4px; }
.spec-card small { color: var(--ks-muted); }
.spec-card .price { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
.spec-card .price b { font-size: 18px; color: var(--ks-accent); }
.spec-card .price a { font-size: 13px; color: var(--ks-accent); }

.ksm-ecosystem { background: var(--ks-card); border-top: 1px solid var(--ks-line); }
.ksm-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.ksm-manifest svg { width: 100%; height: 170px; color: var(--ks-accent); opacity: .4; }
.ksm-model { background: var(--ks-card); }

#pdp-root[data-page-model="hardware-sheet"] .pdp { grid-template-columns: 1fr 1fr; }
#pdp-root[data-page-model="hardware-sheet"] .pdp-media { border-radius: 24px; border-color: var(--ks-line); background: var(--ks-bg); min-height: 420px; }
#pdp-root[data-page-model="hardware-sheet"] .pdp-info { display: flex; flex-direction: column; }
.ksm-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); border-bottom: 1px solid var(--ks-line); padding-bottom: 12px; margin-bottom: 18px; }
.ksm-pdp-bar b { color: #16a34a; }
.ksm-pdp-bar i { font-style: normal; margin-left: auto; }

@media (max-width: 960px) {
  .ksm-modules { grid-template-columns: 1fr; }
  .ksm-ecosystem .wrap { grid-template-columns: 1fr; }
  .spec-grid { grid-template-columns: repeat(2, 1fr); }
  #pdp-root[data-page-model="hardware-sheet"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .spec-grid { grid-template-columns: 1fr; }
  .index-row { grid-template-columns: 84px 1fr; }
  .index-row .img { grid-row: 1 / span 3; width: 80px; height: 80px; }
  .index-row .price { grid-column: 2; }
  .index-row .actions { grid-column: 1 / -1; }
  .index-row .rating { display: none; }
}
'''

LEDGER_CSS = r'''
[data-theme="ledger"] {
  --ks-bg: #faf9f6;
  --ks-ink: #15120f;
  --ks-muted: #6f6a62;
  --ks-line: #e3dfd8;
  --ks-card: #ffffff;
  --ks-accent: #e8392d;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f1eee8;
  --ks-warn: #e8392d;
  --ks-font: "Archivo", sans-serif;
  --ks-mono: "Cutive Mono", monospace;
  --ks-radius: 2px;
  --ks-shadow: none;
  --ks-header: rgba(250,249,246,.92);
}
@font-face { font-family: "Archivo"; src: url("../fonts/archivo-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Archivo"; src: url("../fonts/archivo-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Archivo"; src: url("../fonts/archivo-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "Archivo"; src: url("../fonts/archivo-800.woff2") format("woff2"); font-weight: 800; font-display: swap; }
@font-face { font-family: "Cutive Mono"; src: url("../fonts/cutive-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }

.ksl-hero { position: relative; color: #fff; padding: 120px 0 96px; background: #171310; }
.ksl-hero .bg { position: absolute; inset: 0; opacity: .42; background-size: cover; background-position: center 30%; }
.ksl-hero .bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(23,19,16,.92), rgba(23,19,16,.55) 55%, rgba(23,19,16,.35)); }
.ksl-hero-in { position: relative; max-width: 980px; }
.ksl-hero-in .eyebrow { color: #ff6a5f; }
.ksl-hero-in .h1 { font-weight: 800; letter-spacing: -.045em; }
.ksl-hero-in .lead { color: rgba(255,255,255,.78); }
.ksl-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
.ksl-trust { display: flex; gap: 26px; margin-top: 26px; flex-wrap: wrap; font-family: var(--ks-mono); font-size: 11px; color: rgba(255,255,255,.7); }
.ksl-trust b { display: block; color: #fff; font-size: 18px; }
.ksl-craft { color: #ff6a5f; opacity: .8; }
.ksl-craft svg { width: 100%; height: 120px; }

.ksl-best { border-top: 3px solid var(--ks-ink); }
.ledger-rows { display: grid; }
.ledger-row { display: grid; grid-template-columns: 80px 1fr 180px 160px auto; gap: 18px; align-items: center; border-bottom: 1px solid var(--ks-line); padding: 14px 6px; }
.ledger-row:hover { background: var(--ks-soft); }
.ledger-row .num { font-family: var(--ks-mono); font-size: 14px; color: var(--ks-accent); }
.ledger-row .img { width: 90px; height: 90px; display: grid; place-content: center; background: var(--ks-bg); }
.ledger-row img { max-height: 84px; object-fit: contain; }
.ledger-row h3 { font-size: 16px; margin: 4px 0; text-transform: uppercase; letter-spacing: .01em; }
.ledger-row small { color: var(--ks-muted); font-family: var(--ks-mono); font-size: 11px; text-transform: uppercase; }
.ledger-row .rating { color: var(--ks-muted); font-size: 12px; }
.ledger-row .price { font-family: var(--ks-mono); font-size: 18px; }
.ledger-row .actions { display: flex; gap: 8px; }

.register-rows { display: grid; border-top: 1px solid var(--ks-ink); }
.register-row { display: grid; grid-template-columns: 70px 1fr 140px auto; gap: 16px; align-items: center; border-bottom: 1px solid var(--ks-line); padding: 10px 6px; }
.register-row img { width: 60px; height: 60px; object-fit: contain; }
.register-row b { font-size: 15px; text-transform: uppercase; }
.register-row small { display: block; color: var(--ks-muted); font-family: var(--ks-mono); font-size: 11px; }
.register-row i { font-style: normal; font-family: var(--ks-mono); color: var(--ks-accent); }
.register-row em { font-style: normal; color: var(--ks-muted); font-family: var(--ks-mono); font-size: 11px; }

.ksl-ecosystem { border-top: 3px solid var(--ks-ink); }
.ksl-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
.ksl-timeline { position: relative; padding-left: 22px; }
.ksl-timeline::before { content: ""; position: absolute; left: 4px; top: 0; bottom: 0; width: 2px; background: var(--ks-accent); }
.ksl-timeline-item { position: relative; padding: 8px 0; }
.ksl-timeline-item::before { content: ""; position: absolute; left: -21px; top: 16px; width: 9px; height: 9px; border-radius: 50%; background: var(--ks-accent); }
.ksl-timeline-item b { display: block; text-transform: uppercase; font-size: 14px; }
.ksl-timeline-item small { color: var(--ks-muted); }

#pdp-root[data-page-model="invoice-sheet"] .pdp { grid-template-columns: 1fr 1.05fr; gap: 28px; }
#pdp-root[data-page-model="invoice-sheet"] .pdp-media { border: 2px solid var(--ks-ink); border-radius: 2px; background: var(--ks-card); min-height: 420px; }
#pdp-root[data-page-model="invoice-sheet"] .pdp-info { border: 2px solid var(--ks-ink); border-radius: 2px; padding: 24px; background: var(--ks-card); }
.ksl-pdp-bar { display: flex; gap: 10px; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); border-bottom: 1px solid var(--ks-ink); padding-bottom: 12px; margin-bottom: 16px; }
.ksl-pdp-bar b { color: var(--ks-accent); }
.ksl-pdp-bar i { font-style: normal; margin-left: auto; }
.ksl-stamp { display: inline-block; border: 2px solid var(--ks-accent); color: var(--ks-accent); font-family: var(--ks-mono); font-size: 10px; letter-spacing: .12em; padding: 6px 10px; transform: rotate(-2deg); }

@media (max-width: 960px) {
  .ksl-ecosystem .wrap { grid-template-columns: 1fr; }
  #pdp-root[data-page-model="invoice-sheet"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .ledger-row { grid-template-columns: 70px 1fr; }
  .ledger-row .img { grid-row: 1 / span 3; width: 68px; height: 68px; }
  .ledger-row .price { grid-column: 2; }
  .ledger-row .actions { grid-column: 1 / -1; }
  .ledger-row .rating { display: none; }
  .register-row { grid-template-columns: 60px 1fr auto; }
  .register-row em { display: none; }
}
'''

ATLAS_CSS = r'''
[data-theme="atlas"] {
  --ks-bg: #ffffff;
  --ks-ink: #1d1d1f;
  --ks-muted: #6e6e73;
  --ks-line: #ececec;
  --ks-card: #ffffff;
  --ks-accent: #0066cc;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f5f5f7;
  --ks-warn: #0066cc;
  --ks-font: "Plus Jakarta Sans", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 18px;
  --ks-shadow: 0 30px 80px -48px rgba(29,29,31,.45);
  --ks-header: rgba(255,255,255,.78);
}
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

.ksa-hero { padding: 96px 0; }
.ksa-hero-in { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; max-width: 1180px; }
.ksa-hero-in .h1 { font-size: clamp(48px, 5.5vw, 84px); letter-spacing: -.055em; line-height: 1.02; }
.ksa-hero-in .lead { margin-top: 18px; font-size: 18px; }
.ksa-plate { min-width: 0; }
.ksa-craft { grid-column: 1 / -1; }
.ksa-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.ksa-trust { display: flex; gap: 30px; justify-content: center; flex-wrap: wrap; color: var(--ks-muted); font-size: 13px; }
.ksa-trust b { display: block; color: var(--ks-ink); font-size: 18px; }
.ksa-object { width: min(860px, 100%); background: var(--ks-soft); border-radius: 32px; padding: 46px 30px 30px; position: relative; }
.ksa-object img { width: min(620px, 100%); margin: 0 auto; filter: drop-shadow(0 24px 44px rgba(29,29,31,.22)); }
.ksa-object-caption { display: flex; justify-content: space-between; gap: 14px; align-items: flex-end; margin-top: 24px; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); }
.ksa-craft { color: var(--ks-accent); opacity: .4; }
.ksa-craft svg { width: 100%; height: 96px; }

.ksa-best { padding: 96px 0; }
.ksa-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.ksa-card { background: var(--ks-soft); border-radius: 24px; padding: 22px; transition: .22s; }
.ksa-card:hover { transform: translateY(-4px); background: #fbfbfd; box-shadow: var(--ks-shadow); }
.ksa-card .img { height: 180px; display: grid; place-content: center; }
.ksa-card img { max-height: 168px; object-fit: contain; }
.ksa-card .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksa-card h3 { font-size: 17px; margin: 10px 0 4px; }
.ksa-card small { color: var(--ks-muted); }
.ksa-card .rating { color: var(--ks-muted); font-size: 12px; margin-top: 6px; }
.ksa-card .price { font-size: 20px; font-weight: 750; margin-top: 10px; }
.ksa-card .actions { display: flex; gap: 8px; margin-top: 12px; }

.ksa-rows { display: grid; }
.ksa-row { display: grid; grid-template-columns: 90px 130px 1fr 180px 160px auto; gap: 18px; align-items: center; padding: 22px 6px; border-top: 1px solid var(--ks-line); }
.ksa-row:last-child { border-bottom: 1px solid var(--ks-line); }
.ksa-row:hover { background: #fafafa; }
.ksa-row .num { font-family: var(--ks-mono); font-size: 13px; color: var(--ks-muted); }
.ksa-row .img { width: 120px; height: 120px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 20px; }
.ksa-row img { max-height: 110px; object-fit: contain; }
.ksa-row h3 { font-size: 17px; margin: 6px 0; }
.ksa-row small { color: var(--ks-muted); }
.ksa-row .rating { color: var(--ks-muted); font-size: 12px; }
.ksa-row .price { font-size: 20px; font-weight: 750; }
.ksa-row .actions { display: flex; gap: 8px; }

.ksa-ecosystem { padding: 96px 0; background: var(--ks-soft); }
.ksa-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.ksa-manifest svg { width: 100%; height: 150px; color: var(--ks-accent); opacity: .35; }

#pdp-root[data-page-model="atlas-sheet"] .pdp { grid-template-columns: 1fr 1fr; gap: 40px; }
#pdp-root[data-page-model="atlas-sheet"] .pdp-media { border-radius: 28px; background: var(--ks-soft); border: 0; min-height: 440px; }
#pdp-root[data-page-model="atlas-sheet"] .pdp-info { padding: 12px 0; }
.ksa-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); margin-bottom: 20px; }
.ksa-pdp-bar b { color: #16a34a; }
.ksa-pdp-bar i { font-style: normal; margin-left: auto; }
.ksa-pdp-bar::after { content: ""; flex: 1; height: 1px; background: var(--ks-line); }

@media (max-width: 960px) {
  .ksa-grid { grid-template-columns: repeat(2, 1fr); }
  .ksa-hero-in { grid-template-columns: 1fr; }
  .ksa-ecosystem .wrap { grid-template-columns: 1fr; }
  #pdp-root[data-page-model="atlas-sheet"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .ksa-grid { grid-template-columns: 1fr; }
  .ksa-row { grid-template-columns: 84px 1fr; }
  .ksa-row .img { grid-row: 1 / span 3; width: 80px; height: 80px; }
  .ksa-row .price { grid-column: 2; }
  .ksa-row .actions { grid-column: 1 / -1; }
  .ksa-row .rating { display: none; }
  .ksa-object { padding: 30px 16px 20px; }
}
'''

MERCHANT_CSS = r'''
[data-theme="merchant"] {
  --ks-bg: #ffffff;
  --ks-ink: #111111;
  --ks-muted: #6b6b6b;
  --ks-line: #e8e8e8;
  --ks-card: #ffffff;
  --ks-accent: #008060;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f4f6f5;
  --ks-warn: #008060;
  --ks-font: "Manrope", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 12px;
  --ks-shadow: 0 1px 2px rgba(17,17,17,.04), 0 16px 40px -32px rgba(17,17,17,.25);
  --ks-header: rgba(255,255,255,.9);
}
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

.ksh-hero { padding: 84px 0 72px; background: linear-gradient(180deg, #fbfcfb 0%, #ffffff 100%); }
.ksh-hero-in { display: grid; grid-template-columns: 1.05fr .95fr; gap: 64px; align-items: center; }
.ksh-hero-in .h1 { font-size: clamp(44px, 5.5vw, 76px); letter-spacing: -.04em; line-height: 1.02; }
.ksh-hero-in .lead { margin-top: 18px; }
.ksh-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
.ksh-trust { display: flex; gap: 24px; margin-top: 28px; flex-wrap: wrap; }
.ksh-trust span { font-size: 13px; color: var(--ks-muted); }
.ksh-trust b { display: block; color: var(--ks-ink); font-size: 17px; }
.ksh-visual { position: relative; }
.ksh-visual .img { background: var(--ks-soft); border-radius: 24px; padding: 34px; display: grid; place-content: center; }
.ksh-visual img { width: min(480px, 100%); }
.ksh-float { position: absolute; right: -18px; bottom: 28px; background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 14px; box-shadow: var(--ks-shadow); padding: 14px 16px; font-family: var(--ks-mono); font-size: 11px; }
.ksh-float b { display: block; font-size: 18px; color: var(--ks-accent); }
.ksh-craft { color: var(--ks-accent); opacity: .35; }
.ksh-craft svg { width: 100%; height: 90px; }

.ksh-best { padding: 80px 0; }
.ksh-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.ksh-card { border: 1px solid var(--ks-line); border-radius: 14px; background: var(--ks-card); padding: 16px; transition: .18s; }
.ksh-card:hover { box-shadow: var(--ks-shadow); transform: translateY(-3px); }
.ksh-card .img { height: 170px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 10px; position: relative; }
.ksh-card img { max-height: 158px; object-fit: contain; }
.ksh-card .badge { position: absolute; top: 10px; left: 10px; background: var(--ks-accent); color: #fff; font-family: var(--ks-mono); font-size: 9px; padding: 4px 8px; border-radius: 6px; }
.ksh-card h3 { font-size: 15px; margin: 12px 0 4px; }
.ksh-card .rating { color: var(--ks-muted); font-size: 12px; }
.ksh-card .price { color: var(--ks-ink); font-size: 18px; font-weight: 750; margin-top: 8px; }
.ksh-card .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }

.ksh-rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(260px, 1fr); gap: 14px; overflow-x: auto; padding-bottom: 8px; }
.ksh-rail-card { border: 1px solid var(--ks-line); border-radius: 14px; padding: 14px; background: var(--ks-card); }
.ksh-rail-card .img { height: 150px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 10px; }
.ksh-rail-card img { max-height: 140px; object-fit: contain; }
.ksh-rail-card span { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksh-rail-card h3 { font-size: 15px; margin: 10px 0 4px; }
.ksh-rail-card small { color: var(--ks-muted); }
.ksh-rail-card .price { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
.ksh-rail-card .price b { font-size: 18px; }
.ksh-rail-card .price span { color: var(--ks-accent); }

.ksh-ecosystem { background: var(--ks-soft); padding: 80px 0; }
.ksh-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.ksh-ship svg { width: 100%; height: 150px; color: var(--ks-accent); opacity: .35; }

#pdp-root[data-page-model="merchant-sheet"] .pdp { grid-template-columns: 1fr 1fr; gap: 36px; }
#pdp-root[data-page-model="merchant-sheet"] .pdp-media { border: 1px solid var(--ks-line); border-radius: 16px; background: var(--ks-soft); min-height: 420px; }
#pdp-root[data-page-model="merchant-sheet"] .pdp-info { padding: 10px 0; }
.ksh-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); margin-bottom: 18px; }
.ksh-pdp-bar b { color: var(--ks-accent); }
.ksh-pdp-bar i { font-style: normal; margin-left: auto; }

@media (max-width: 960px) {
  .ksh-hero-in { grid-template-columns: 1fr; }
  .ksh-ecosystem .wrap { grid-template-columns: 1fr; }
  .ksh-grid { grid-template-columns: repeat(2, 1fr); }
  #pdp-root[data-page-model="merchant-sheet"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .ksh-grid { grid-template-columns: 1fr; }
  .ksh-float { position: static; margin-top: 12px; }
}
'''

MERIDIAN_CSS = r'''
[data-theme="meridian"] {
  --ks-bg: #ffffff;
  --ks-ink: #111111;
  --ks-muted: #6b6b6b;
  --ks-line: #e7e7e7;
  --ks-card: #ffffff;
  --ks-accent: #008060;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f4f6f5;
  --ks-warn: #008060;
  --ks-font: "Manrope", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 14px;
  --ks-shadow: 0 2px 6px rgba(17,17,17,.04), 0 24px 60px -42px rgba(17,17,17,.35);
  --ks-header: rgba(255,255,255,.86);
}
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

.header.scrolled { box-shadow: 0 10px 34px -22px rgba(17,17,17,.28); }
.ksd-hero { padding: 84px 0 64px; background: linear-gradient(180deg, #fbfcfb 0%, #ffffff 100%); }
.ksd-hero-in { display: grid; grid-template-columns: 1.08fr .92fr; gap: 56px; align-items: center; }
.ksd-hero-in .h1 { font-size: clamp(46px, 5.8vw, 80px); letter-spacing: -.045em; line-height: 1.02; }
.ksd-hero-in .lead { margin-top: 18px; }
.ksd-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
.ksd-trust { display: flex; gap: 26px; margin-top: 28px; flex-wrap: wrap; }
.ksd-trust span { font-size: 13px; color: var(--ks-muted); }
.ksd-trust b { display: block; color: var(--ks-ink); font-size: 17px; }
.ksd-visual { position: relative; }
.ksd-visual .img { background: var(--ks-soft); border-radius: 28px; padding: 40px; display: grid; place-content: center; position: relative; overflow: hidden; }
.ksd-visual .img::after { content: ""; position: absolute; inset: 0; background: radial-gradient(120% 80% at 80% 0%, rgba(0,128,96,.14), transparent 55%); }
.ksd-visual img { width: min(460px, 100%); position: relative; filter: drop-shadow(0 26px 44px rgba(17,17,17,.18)); transition: transform .6s ease; }
.ksd-visual:hover img { transform: translateY(-8px) rotate(-1deg); }
.ksd-float { position: absolute; left: -16px; bottom: 26px; background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 16px; box-shadow: var(--ks-shadow); padding: 14px 16px; font-family: var(--ks-mono); font-size: 11px; }
.ksd-float b { display: block; font-size: 18px; color: var(--ks-accent); }
.ksd-craft { color: var(--ks-accent); opacity: .35; }
.ksd-craft svg { width: 100%; height: 80px; }
.ksd-marquee { overflow: hidden; border-top: 1px solid var(--ks-line); border-bottom: 1px solid var(--ks-line); padding: 14px 0; background: var(--ks-card); }
.ksd-marquee-track { display: flex; gap: 48px; width: max-content; animation: ksd-scroll 28s linear infinite; }
.ksd-marquee-track span { font-family: var(--ks-mono); font-size: 12px; letter-spacing: .08em; color: var(--ks-muted); white-space: nowrap; }
.ksd-marquee-track b { color: var(--ks-accent); }
@keyframes ksd-scroll { to { transform: translateX(-50%); } }

.ksd-best { padding: 84px 0; }
.portrait-wall { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.ksd-card { position: relative; border-radius: 18px; overflow: hidden; background: var(--ks-soft); }
.ksd-card .img { height: 260px; display: grid; place-content: center; position: relative; overflow: hidden; }
.ksd-card img { max-height: 230px; object-fit: contain; transition: transform .5s ease; }
.ksd-card:hover img { transform: scale(1.07); }
.ksd-card .badge { position: absolute; top: 12px; left: 12px; background: var(--ks-accent); color: #fff; font-family: var(--ks-mono); font-size: 9px; letter-spacing: .08em; padding: 5px 9px; border-radius: 6px; z-index: 2; }
.ksd-card .body { background: var(--ks-card); padding: 14px 16px; }
.ksd-card h3 { font-size: 15px; margin: 0 0 4px; }
.ksd-card small { color: var(--ks-muted); }
.ksd-card .rating { color: var(--ks-muted); font-size: 12px; margin-top: 4px; }
.ksd-card .price { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
.ksd-card .price b { font-size: 18px; }
.ksd-quick { opacity: 0; transform: translateY(8px); transition: .25s ease; display: flex; gap: 6px; }
.ksd-card:hover .ksd-quick { opacity: 1; transform: none; }
.ksd-quick .btn { flex: 1; }

.bottle-rack { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 1fr); gap: 14px; overflow-x: auto; padding-bottom: 10px; }
.ksd-rack-card { border: 1px solid var(--ks-line); border-radius: 16px; background: var(--ks-card); padding: 14px; transition: .2s; }
.ksd-rack-card:hover { box-shadow: var(--ks-shadow); }
.ksd-rack-card .img { height: 150px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 12px; }
.ksd-rack-card img { max-height: 140px; object-fit: contain; }
.ksd-rack-card span { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksd-rack-card h3 { font-size: 15px; margin: 10px 0 4px; }
.ksd-rack-card small { color: var(--ks-muted); }
.ksd-rack-card .price { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
.ksd-rack-card .price b { font-size: 18px; }

.ksd-ecosystem { background: var(--ks-soft); padding: 84px 0; }
.ksd-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.ksd-timeline { position: relative; padding-left: 22px; }
.ksd-timeline::before { content: ""; position: absolute; left: 4px; top: 0; bottom: 0; width: 2px; background: var(--ks-accent); }
.ksd-timeline-item { position: relative; padding: 10px 0; }
.ksd-timeline-item::before { content: ""; position: absolute; left: -21px; top: 18px; width: 9px; height: 9px; border-radius: 50%; background: var(--ks-accent); }
.ksd-timeline-item b { display: block; }
.ksd-timeline-item small { color: var(--ks-muted); }

#pdp-root[data-page-model="meridian-sheet"] .pdp { grid-template-columns: 1fr 1fr; gap: 36px; }
#pdp-root[data-page-model="meridian-sheet"] .pdp-media { border: 1px solid var(--ks-line); border-radius: 20px; background: var(--ks-soft); min-height: 420px; }
#pdp-root[data-page-model="meridian-sheet"] .pdp-info { padding: 10px 0; }
.ksd-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); margin-bottom: 18px; }
.ksd-pdp-bar b { color: var(--ks-accent); }
.ksd-pdp-bar i { font-style: normal; margin-left: auto; }

[data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
[data-reveal].in-view { opacity: 1; transform: none; }

@media (max-width: 960px) {
  .ksd-hero-in { grid-template-columns: 1fr; }
  .ksd-ecosystem .wrap { grid-template-columns: 1fr; }
  .portrait-wall { grid-template-columns: repeat(2, 1fr); }
  #pdp-root[data-page-model="meridian-sheet"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .portrait-wall { grid-template-columns: 1fr; }
  .ksd-float { position: static; margin-top: 12px; }
  .ksd-card .img { height: 210px; }
}
'''

AURORA_CSS = r'''
[data-theme="aurora"] {
  --ks-bg: #ffffff;
  --ks-ink: #1d1d1f;
  --ks-muted: #6e6e73;
  --ks-line: #ececec;
  --ks-card: #ffffff;
  --ks-accent: #0066cc;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f5f5f7;
  --ks-warn: #0066cc;
  --ks-font: "Plus Jakarta Sans", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 22px;
  --ks-shadow: 0 40px 90px -60px rgba(29,29,31,.5);
  --ks-header: rgba(255,255,255,.74);
}
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

.header.scrolled { box-shadow: 0 10px 34px -22px rgba(29,29,31,.28); }
.ksu-hero { padding: 120px 0 40px; background: linear-gradient(180deg, #fbfbfd 0%, #ffffff 100%); overflow: hidden; }
.ksu-hero-in { max-width: 1100px; margin: 0 auto; text-align: center; position: relative; }
.ksu-hero-in .h1 { font-size: clamp(54px, 7vw, 104px); letter-spacing: -.06em; line-height: .98; }
.ksu-hero-in .lead { margin: 20px auto 0; max-width: 620px; }
.ksu-cta { display: flex; gap: 12px; justify-content: center; margin-top: 24px; flex-wrap: wrap; }
.ksu-trust { display: flex; gap: 30px; justify-content: center; margin-top: 26px; flex-wrap: wrap; color: var(--ks-muted); font-size: 13px; }
.ksu-trust b { display: block; color: var(--ks-ink); font-size: 18px; }
.ksu-scene { width: min(980px, 100%); margin: 46px auto 0; background: var(--ks-soft); border-radius: 44px; padding: 54px 30px 34px; position: relative; overflow: hidden; }
.ksu-scene::before { content: ""; position: absolute; inset: 0; background: radial-gradient(100% 80% at 50% 0%, rgba(0,102,204,.18), transparent 60%); }
.ksu-scene img { width: min(680px, 100%); margin: 0 auto; position: relative; filter: drop-shadow(0 36px 60px rgba(29,29,31,.28)); animation: ksu-float 6s ease-in-out infinite; }
@keyframes ksu-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
.ksu-chips { position: absolute; left: 18px; right: 18px; bottom: 22px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
.ksu-chip { background: rgba(255,255,255,.82); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid var(--ks-line); border-radius: 999px; padding: 8px 14px; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); }
.ksu-chip b { color: var(--ks-ink); }
.ksu-scroll { margin: 34px auto 0; width: 24px; height: 40px; border: 2px solid var(--ks-line); border-radius: 999px; position: relative; }
.ksu-scroll::after { content: ""; position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; border-radius: 4px; background: var(--ks-accent); animation: ksu-wheel 1.6s ease-in-out infinite; }
@keyframes ksu-wheel { 0%,100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(8px); opacity: .3; } }
.ksu-craft { color: var(--ks-accent); opacity: .4; }
.ksu-craft svg { width: 100%; height: 84px; }

.ksu-best { padding: 96px 0; }
.film-strip { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 1fr); gap: 18px; overflow-x: auto; padding: 8px 4px 18px; }
.ksu-frame { position: relative; border-radius: 26px; overflow: hidden; background: var(--ks-soft); min-height: 360px; }
.ksu-frame .img { height: 250px; display: grid; place-content: center; }
.ksu-frame img { max-height: 230px; object-fit: contain; transition: transform .5s ease; }
.ksu-frame:hover img { transform: scale(1.06); }
.ksu-frame .body { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,.9); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-top: 1px solid var(--ks-line); padding: 16px 18px; }
.ksu-frame .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksu-frame h3 { font-size: 16px; margin: 6px 0 2px; }
.ksu-frame small { color: var(--ks-muted); }
.ksu-frame .price { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
.ksu-frame .price b { font-size: 18px; }
.ksu-frame .actions { display: flex; gap: 8px; margin-top: 10px; }

.prescription-slips { display: grid; gap: 10px; }
.ksu-slip { display: grid; grid-template-columns: 80px 1fr 150px auto; gap: 16px; align-items: center; border: 1px solid var(--ks-line); border-radius: 18px; background: var(--ks-card); padding: 12px 16px; transition: .2s; }
.ksu-slip:hover { box-shadow: var(--ks-shadow); }
.ksu-slip img { width: 70px; height: 70px; object-fit: contain; }
.ksu-slip b { font-size: 15px; }
.ksu-slip small { display: block; color: var(--ks-muted); }
.ksu-slip i { font-style: normal; font-family: var(--ks-mono); color: var(--ks-accent); }
.ksu-slip em { font-style: normal; color: var(--ks-muted); font-size: 12px; }

.ksu-ecosystem { padding: 96px 0; background: var(--ks-soft); }
.ksu-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.ksu-story svg { width: 100%; height: 150px; color: var(--ks-accent); opacity: .35; }

#pdp-root[data-page-model="aurora-sheet"] .pdp { grid-template-columns: 1fr 1fr; gap: 44px; }
#pdp-root[data-page-model="aurora-sheet"] .pdp-media { border-radius: 30px; background: var(--ks-soft); border: 0; min-height: 440px; }
#pdp-root[data-page-model="aurora-sheet"] .pdp-info { padding: 12px 0; }
.ksu-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); margin-bottom: 20px; }
.ksu-pdp-bar::after { content: ""; flex: 1; height: 1px; background: var(--ks-line); }
.ksu-pdp-bar b { color: var(--ks-accent); }
.ksu-pdp-bar i { font-style: normal; margin-left: auto; }

[data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
[data-reveal].in-view { opacity: 1; transform: none; }

@media (max-width: 960px) {
  .ksu-ecosystem .wrap { grid-template-columns: 1fr; }
  #pdp-root[data-page-model="aurora-sheet"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .ksu-scene { border-radius: 28px; padding: 34px 14px 24px; }
  .ksu-chips { position: static; margin-top: 18px; }
  .ksu-slip { grid-template-columns: 64px 1fr auto; }
  .ksu-slip em { display: none; }
}
'''

NOVA_CSS = r'''
[data-theme="nova"] {
  --ks-bg: #ffffff;
  --ks-ink: #111111;
  --ks-muted: #6b6b6b;
  --ks-line: #e7e7e7;
  --ks-card: #ffffff;
  --ks-accent: #008060;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f4f7f5;
  --ks-warn: #008060;
  --ks-font: "Manrope", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 14px;
  --ks-shadow: 0 1px 2px rgba(17,17,17,.04), 0 18px 44px -34px rgba(17,17,17,.28);
  --ks-header: rgba(255,255,255,.92);
}
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "Manrope"; src: url("../fonts/manrope-800.woff2") format("woff2"); font-weight: 800; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }

.ksn-announce { border-bottom: 1px solid rgba(0,128,96,.18); background: #f0f7f3; }
.ksn-announce .promo-msg { color: var(--ks-accent); }
.ksn-ver { font-family: var(--ks-mono); font-size: 10px; letter-spacing: .06em; color: var(--ks-accent); border: 1px solid rgba(0,128,96,.25); border-radius: 999px; padding: 3px 8px; }
.ksn-delivery { display: inline-flex; align-items: center; gap: 6px; font-family: var(--ks-mono); font-size: 10px; letter-spacing: .08em; color: var(--ks-accent); border: 1px solid rgba(0,128,96,.25); border-radius: 999px; padding: 5px 10px; }
.ksn-drawer { border-left: 4px solid var(--ks-accent); }
.ksn-drawer h3 { color: var(--ks-accent); }

.ksn-hero { padding: 92px 0 78px; background: radial-gradient(120% 90% at 82% 0%, rgba(0,128,96,.1), transparent 55%), linear-gradient(180deg, #fbfdfc 0%, #ffffff 100%); }
.ksn-hero-in { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: center; }
.ksn-hero-in .h1 { font-size: clamp(44px, 5.4vw, 76px); letter-spacing: -.045em; line-height: 1.02; }
.ksn-hero-in .lead { margin-top: 18px; }
.ksn-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
.ksn-trust { display: flex; gap: 28px; margin-top: 30px; flex-wrap: wrap; }
.ksn-trust span { font-size: 13px; color: var(--ks-muted); }
.ksn-trust b { display: block; color: var(--ks-ink); font-size: 17px; }
.ksn-visual { position: relative; }
.ksn-panel { position: relative; background: var(--ks-soft); border: 1px solid var(--ks-line); border-radius: 26px; padding: 40px 32px 34px; overflow: hidden; }
.ksn-panel::before { content: ""; position: absolute; inset: 0; background: radial-gradient(90% 70% at 50% 0%, rgba(0,128,96,.12), transparent 62%); }
.ksn-panel::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(0,128,96,.05) 0 1px, transparent 1px 14px); }
.ksn-panel-tag { position: relative; font-family: var(--ks-mono); font-size: 10px; letter-spacing: .12em; color: var(--ks-accent); }
.ksn-license-head { position: relative; display: flex; justify-content: space-between; gap: 12px; align-items: center; font-family: var(--ks-mono); font-size: 11px; letter-spacing: .1em; color: var(--ks-ink); }
.ksn-license-head b { color: var(--ks-accent); font-weight: 600; }
.ksn-license-key { position: relative; margin-top: 18px; font-family: var(--ks-mono); font-size: 13px; letter-spacing: .08em; background: rgba(255,255,255,.82); border: 1px solid var(--ks-line); border-radius: 10px; padding: 12px 14px; text-align: center; color: var(--ks-ink); }
.ksn-license-meta { position: relative; display: flex; justify-content: space-between; gap: 10px; margin-top: 14px; font-family: var(--ks-mono); font-size: 10px; color: var(--ks-muted); }
.ksn-license-meta span:first-child { color: var(--ks-accent); font-weight: 700; }
.ksn-panel img { position: relative; width: min(430px, 100%); margin: 22px auto 0; filter: drop-shadow(0 30px 40px rgba(17,17,17,.18)); }
.ksn-float { position: absolute; right: 18px; bottom: 18px; background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 14px; box-shadow: var(--ks-shadow); padding: 12px 16px; }
.ksn-float b { display: block; font-size: 20px; color: var(--ks-accent); }
.ksn-float small { color: var(--ks-muted); font-size: 12px; }
.ksn-craft { color: var(--ks-accent); opacity: .38; }
.ksn-craft svg { width: 100%; height: 76px; }
.ksn-marquee { overflow: hidden; margin-top: 46px; border-top: 1px solid var(--ks-line); border-bottom: 1px solid var(--ks-line); background: var(--ks-card); padding: 14px 0; }
.ksn-marquee-track { display: flex; gap: 34px; width: max-content; white-space: nowrap; animation: ksn-scroll 26s linear infinite; }
.ksn-marquee-track span { font-family: var(--ks-mono); font-size: 12px; letter-spacing: .1em; color: var(--ks-muted); }
.ksn-marquee-track i { font-style: normal; color: var(--ks-accent); }
@keyframes ksn-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.ksn-hero-in .h1 { font-size: clamp(46px, 5.6vw, 80px); letter-spacing: -.055em; line-height: .98; font-weight: 800; }
.ksn-panel { border-color: rgba(0,128,96,.18); box-shadow: 0 30px 70px -52px rgba(0,128,96,.4); }
.ksn-float { padding-left: 32px; }
.ksn-float::before { content: ""; position: absolute; left: 14px; top: 50%; width: 7px; height: 7px; border-radius: 50%; background: var(--ks-accent); transform: translateY(-50%); }
.persona-strip { gap: 16px; }
.persona-card { border: 1px solid var(--ks-line); border-radius: 18px; background: var(--ks-card); box-shadow: var(--ks-shadow); padding: 22px 24px; }
.ksn-best { padding: 96px 0; }
.ksn-row:first-child { border-top-left-radius: 16px; border-top-right-radius: 16px; }
.ksn-row:last-child { border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; }
.ksn-ecosystem { background: linear-gradient(180deg, var(--ks-soft) 0%, #ffffff 100%); }
.offer-item { border: 1px solid var(--ks-line); border-radius: 16px; background: var(--ks-card); box-shadow: var(--ks-shadow); padding: 14px; }
.model-item { border: 1px solid var(--ks-line); border-radius: 18px; background: var(--ks-card); padding: 22px; }
.topic-grid a { border: 1px solid var(--ks-line); border-radius: 12px; background: var(--ks-card); }
.review-card { border: 1px solid var(--ks-line); border-radius: 18px; background: var(--ks-card); box-shadow: var(--ks-shadow); }
.blog-card { border: 1px solid var(--ks-line); border-radius: 18px; background: var(--ks-card); box-shadow: var(--ks-shadow); overflow: hidden; }
.trust-in { background: linear-gradient(120deg, #f0f7f3, #ffffff); border: 1px solid rgba(0,128,96,.14); border-radius: 24px; padding: 40px 44px; }
.newsletter-in { border: 1px solid var(--ks-line); border-radius: 20px; background: var(--ks-card); box-shadow: var(--ks-shadow); }
.offers { background: linear-gradient(180deg, #ffffff 0%, var(--ks-soft) 100%); }
.reviews { background: var(--ks-soft); padding: 84px 0; }
.journal { background: #ffffff; padding: 84px 0; }
.newsletter { background: linear-gradient(120deg, #f0f7f3 0%, #ffffff 100%); padding: 70px 0; }

.ksn-best { padding: 96px 0; }
.table-ledger { display: grid; }
.ksn-row { display: grid; grid-template-columns: 88px 1.15fr 1fr 140px 160px auto; gap: 18px; align-items: center; border: 1px solid var(--ks-line); border-bottom: 0; padding: 14px 18px; background: var(--ks-card); }
.ksn-row:first-child { border-radius: 14px 14px 0 0; }
.ksn-row:last-child { border-bottom: 1px solid var(--ks-line); border-radius: 0 0 14px 14px; }
.ksn-row:hover { background: var(--ks-soft); }
.ksn-row .img { width: 82px; height: 82px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 12px; position: relative; }
.ksn-row img { max-height: 74px; object-fit: contain; }
.ksn-row .badge { position: absolute; top: 6px; left: 6px; background: var(--ks-accent); color: #fff; font-family: var(--ks-mono); font-size: 8px; padding: 3px 6px; border-radius: 5px; }
.ksn-row h3 { font-size: 16px; margin: 0 0 4px; }
.ksn-row small { color: var(--ks-muted); }
.ksn-row .rating { color: var(--ks-muted); font-size: 12px; }
.ksn-row .price { font-size: 19px; font-weight: 800; }
.ksn-row .stock { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksn-row .actions { display: flex; gap: 8px; }

.horizontal-rail { display: flex; gap: 16px; overflow-x: auto; padding: 4px 4px 14px; }
.ksn-rail-card { flex: 0 0 280px; border: 1px solid var(--ks-line); border-radius: 16px; background: var(--ks-card); padding: 14px; transition: .18s; }
.ksn-rail-card:hover { box-shadow: var(--ks-shadow); transform: translateY(-3px); }
.ksn-rail-card .img { height: 150px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 12px; }
.ksn-rail-card img { max-height: 138px; object-fit: contain; }
.ksn-rail-card > span { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksn-rail-card h3 { font-size: 15px; margin: 10px 0 4px; }
.ksn-rail-card small { color: var(--ks-muted); }
.ksn-rail-card .price { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
.ksn-rail-card .price b { font-size: 18px; }
.ksn-rail-card .price em { font-style: normal; color: var(--ks-accent); font-size: 12px; }

.ksn-ecosystem { background: var(--ks-soft); padding: 84px 0; }
.ksn-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; }
.ksn-plates { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.ksn-plate { border: 1px solid var(--ks-line); border-radius: 14px; background: var(--ks-card); padding: 18px; }
.ksn-plate b { display: block; font-family: var(--ks-mono); color: var(--ks-accent); font-size: 11px; margin-bottom: 8px; }
.ksn-plate span { font-weight: 700; font-size: 14px; }
.ksn-plate small { display: block; color: var(--ks-muted); margin-top: 4px; font-size: 12px; }

#pdp-root[data-page-model="nova-checkout"] .pdp { grid-template-columns: 1fr 1fr; gap: 38px; }
#pdp-root[data-page-model="nova-checkout"] .pdp-media { border: 1px solid var(--ks-line); border-radius: 20px; background: var(--ks-soft); min-height: 430px; }
#pdp-root[data-page-model="nova-checkout"] .pdp-info { padding: 10px 0; }
.ksn-buy { background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 20px; padding: 26px; box-shadow: var(--ks-shadow); }
.ksn-qty { display: flex; align-items: center; gap: 10px; margin: 16px 0; }
.ksn-qty label { font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); text-transform: uppercase; letter-spacing: .08em; }
.ksn-qty select { border: 1px solid var(--ks-line); border-radius: 8px; padding: 8px 10px; background: var(--ks-soft); }
.ksn-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); margin-bottom: 18px; }
.ksn-pdp-bar b { color: var(--ks-accent); }
.ksn-pdp-bar i { font-style: normal; margin-left: auto; }

@media (max-width: 960px) {
  .ksn-hero-in { grid-template-columns: 1fr; }
  .ksn-ecosystem .wrap { grid-template-columns: 1fr; }
  .ksn-row { grid-template-columns: 74px 1fr; }
  .ksn-row .img { grid-row: 1 / span 4; }
  .ksn-row .price { grid-column: 2; }
  .ksn-row .actions { grid-column: 1 / -1; }
  #pdp-root[data-page-model="nova-checkout"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .ksn-float { position: static; margin-top: 12px; }
  .ksn-plates { grid-template-columns: 1fr; }
  .ksn-delivery { display: none; }
  .ksn-row .rating, .ksn-row .stock { display: none; }
}
'''

QUARTZ_CSS = r'''
[data-theme="quartz"] {
  --ks-bg: #ffffff;
  --ks-ink: #1d1d1f;
  --ks-muted: #6e6e73;
  --ks-line: #ececec;
  --ks-card: #ffffff;
  --ks-accent: #0066cc;
  --ks-accent-ink: #ffffff;
  --ks-soft: #f5f5f7;
  --ks-warn: #0066cc;
  --ks-font: "Plus Jakarta Sans", sans-serif;
  --ks-mono: "IBM Plex Mono", monospace;
  --ks-radius: 24px;
  --ks-shadow: 0 40px 90px -60px rgba(29,29,31,.42);
  --ks-header: rgba(255,255,255,.82);
}
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-500.woff2") format("woff2"); font-weight: 500; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Plus Jakarta Sans"; src: url("../fonts/plus-jakarta-sans-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "IBM Plex Mono"; src: url("../fonts/ibm-plex-mono-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Bodoni Moda"; src: url("../fonts/bodoni-moda-600.woff2") format("woff2"); font-weight: 600; font-display: swap; }
@font-face { font-family: "Bodoni Moda"; src: url("../fonts/bodoni-moda-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }

.ksq-announce { border-bottom: 1px solid rgba(0,102,204,.16); background: #f5f9fd; }
.ksq-announce .promo-msg { color: var(--ks-accent); }
.ksq-ver { font-family: var(--ks-mono); font-size: 10px; letter-spacing: .06em; color: var(--ks-accent); border: 1px solid rgba(0,102,204,.25); border-radius: 999px; padding: 3px 8px; }
.ksq-header-in { display: grid !important; grid-template-columns: 1fr auto 1fr; gap: 20px; align-items: center; }
.ksq-header-in .ksq-nav { justify-content: center; font-size: 13px; }
.ksq-header-in .ksq-nav a { color: var(--ks-muted); }
.ksq-drawer { border-left: 4px solid var(--ks-accent); border-radius: 20px 0 0 20px; }
.ksq-drawer h3 { color: var(--ks-accent); }

.ksq-hero { padding: 118px 0 56px; background: radial-gradient(120% 90% at 50% 0%, rgba(0,102,204,.14), transparent 60%), linear-gradient(180deg, #fbfbfd 0%, #ffffff 100%); overflow: hidden; }
.ksq-hero-in { max-width: 1080px; margin: 0 auto; text-align: center; position: relative; }
.ksq-hero-in .h1 { font-size: clamp(52px, 7vw, 96px); letter-spacing: -.06em; line-height: 1; }
.ksq-hero-in .lead { margin: 20px auto 0; max-width: 620px; }
.ksq-cta { display: flex; gap: 12px; justify-content: center; margin-top: 24px; flex-wrap: wrap; }
.ksq-trust { display: flex; gap: 30px; justify-content: center; margin-top: 26px; flex-wrap: wrap; color: var(--ks-muted); font-size: 13px; }
.ksq-trust b { display: block; color: var(--ks-ink); font-size: 18px; }
.ksq-arch { width: min(820px, 100%); margin: 46px auto 0; background: radial-gradient(110% 90% at 50% 0%, rgba(0,102,204,.16), transparent 62%), var(--ks-soft); border-radius: 320px 320px 30px 30px; padding: 44px 34px 30px; position: relative; overflow: hidden; }
.ksq-arch::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 30%, rgba(255,255,255,.75) 100%); }
.ksq-arch::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(0,102,204,.04) 0 1px, transparent 1px 18px); }
.ksq-arch img { position: relative; width: min(520px, 100%); margin: 0 auto; filter: drop-shadow(0 42px 64px rgba(29,29,31,.26)); animation: ksq-float 6s ease-in-out infinite; }
@keyframes ksq-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
.ksq-chips { position: absolute; left: 18px; right: 18px; bottom: 20px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
.ksq-chips span { background: rgba(255,255,255,.86); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid var(--ks-line); border-radius: 999px; padding: 8px 14px; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); }
.ksq-craft { color: var(--ks-accent); opacity: .42; }
.ksq-craft svg { width: 100%; height: 76px; }
.ksq-marquee { overflow: hidden; margin-top: 50px; border-top: 1px solid var(--ks-line); border-bottom: 1px solid var(--ks-line); background: #fbfbfd; padding: 16px 0; }
.ksq-marquee-track { display: flex; gap: 38px; width: max-content; white-space: nowrap; animation: ksq-scroll 30s linear infinite; }
.ksq-marquee-track span { font-family: var(--ks-mono); font-size: 12px; letter-spacing: .12em; color: var(--ks-muted); }
.ksq-marquee-track i { font-style: normal; color: var(--ks-accent); }
@keyframes ksq-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.ksq-hero-in .h1 { font-family: "Bodoni Moda", serif; font-size: clamp(52px, 7vw, 98px); letter-spacing: -.025em; line-height: .96; font-weight: 600; }
.ksq-arch { border: 1px solid rgba(0,102,204,.14); box-shadow: 0 60px 120px -70px rgba(0,102,204,.42); }
.ksq-arch img { width: min(560px, 100%); }
.persona-strip { gap: 16px; }
.persona-card { border: 1px solid var(--ks-line); border-radius: 22px; background: var(--ks-card); box-shadow: var(--ks-shadow); padding: 24px 26px; }
.ksq-best { padding: 110px 0; }
.ksq-card { box-shadow: var(--ks-shadow); }
.ksq-ecosystem { background: linear-gradient(180deg, #fbfbfd 0%, #ffffff 100%); }
.offer-item { border-radius: 22px; border: 1px solid var(--ks-line); box-shadow: var(--ks-shadow); }
.model-item { border-radius: 22px; border: 1px solid var(--ks-line); background: var(--ks-card); }
.topic-grid a { border: 1px solid var(--ks-line); border-radius: 999px; background: var(--ks-card); }
.review-card { border-radius: 22px; border: 1px solid var(--ks-line); background: var(--ks-card); box-shadow: var(--ks-shadow); }
.blog-card { border-radius: 22px; border: 1px solid var(--ks-line); background: var(--ks-card); box-shadow: var(--ks-shadow); overflow: hidden; }
.trust-in { background: linear-gradient(120deg, #f2f7fc, #ffffff); border: 1px solid rgba(0,102,204,.14); border-radius: 28px; padding: 44px 48px; }
.newsletter-in { border-radius: 24px; border: 1px solid var(--ks-line); box-shadow: var(--ks-shadow); }
.offers { background: #fbfbfd; }
.reviews { background: var(--ks-soft); padding: 96px 0; }
.journal { background: #ffffff; padding: 96px 0; }
.newsletter { background: linear-gradient(120deg, #f2f7fc 0%, #ffffff 100%); padding: 80px 0; }

.ksq-best { padding: 96px 0; }
.ksq-masonry { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 240px; gap: 18px; }
.ksq-card { border-radius: 28px; background: var(--ks-soft); overflow: hidden; position: relative; display: flex; flex-direction: column; padding: 18px; border: 1px solid var(--ks-line); }
.ksq-card:nth-child(1) { grid-row: span 2; }
.ksq-card .img { flex: 1; display: grid; place-content: center; min-height: 0; }
.ksq-card img { max-height: 100%; max-width: 100%; object-fit: contain; transition: transform .5s ease; }
.ksq-card:hover img { transform: scale(1.05); }
.ksq-card .tag { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksq-card h3 { font-size: 16px; margin: 8px 0 3px; }
.ksq-card small { color: var(--ks-muted); }
.ksq-card .price { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
.ksq-card .price b { font-size: 18px; }
.ksq-card .actions { display: flex; gap: 8px; margin-top: 10px; }

.ksq-look { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.ksq-look-card { border-radius: 26px; border: 1px solid var(--ks-line); background: var(--ks-card); padding: 14px; transition: .2s; }
.ksq-look-card:hover { box-shadow: var(--ks-shadow); transform: translateY(-4px); }
.ksq-look-card .img { height: 190px; display: grid; place-content: center; background: var(--ks-soft); border-radius: 18px; }
.ksq-look-card img { max-height: 176px; object-fit: contain; }
.ksq-look-card .meta span { font-family: var(--ks-mono); font-size: 10px; color: var(--ks-accent); }
.ksq-look-card h3 { font-size: 15px; margin: 8px 0 3px; }
.ksq-look-card small { color: var(--ks-muted); }
.ksq-look-card .price { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
.ksq-look-card .price b { font-size: 18px; }
.ksq-look-card .price em { font-style: normal; color: var(--ks-accent); font-size: 12px; }

.ksq-ecosystem { background: #fbfbfd; padding: 96px 0; }
.ksq-ecosystem .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.ksq-script { display: grid; gap: 10px; }
.ksq-timeline-item { border-left: 2px solid var(--ks-accent); padding: 4px 0 4px 18px; }
.ksq-timeline-item b { display: block; font-size: 14px; }
.ksq-timeline-item small { color: var(--ks-muted); }
.ksq-script svg { width: 100%; height: 180px; color: var(--ks-accent); opacity: .38; }

#pdp-root[data-page-model="quartz-stage"] .pdp { grid-template-columns: 1fr 1fr; gap: 46px; }
#pdp-root[data-page-model="quartz-stage"] .pdp-media { border-radius: 32px; background: var(--ks-soft); border: 0; min-height: 440px; }
#pdp-root[data-page-model="quartz-stage"] .pdp-info { padding: 12px 0; }
.ksq-stage { display: block; }
.ksq-media { position: relative; background: radial-gradient(110% 90% at 50% 0%, rgba(0,102,204,.14), transparent 62%), var(--ks-soft); border-radius: 40px; min-height: 560px; display: grid; place-content: center; overflow: hidden; padding: 36px; }
.ksq-media img { width: min(520px, 100%); margin: 0 auto; filter: drop-shadow(0 42px 64px rgba(29,29,31,.24)); }
.ksq-media .thumb { position: absolute; left: 24px; bottom: 22px; }
.ksq-media-chip { position: absolute; top: 22px; left: 24px; background: rgba(255,255,255,.88); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid var(--ks-line); border-radius: 999px; padding: 8px 14px; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-accent); }
.ksq-buy { max-width: 660px; margin: -86px auto 0; position: relative; background: var(--ks-card); border: 1px solid var(--ks-line); border-radius: 30px; box-shadow: var(--ks-shadow); padding: 34px 40px 30px; text-align: center; }
.ksq-buy .pdp-cta { justify-content: center; }
.ksq-buy .pdp-pay { justify-content: center; }
.ksq-panels { max-width: 980px; margin: 60px auto 0; }
.ksq-pdp-bar { display: flex; gap: 10px; align-items: center; font-family: var(--ks-mono); font-size: 11px; color: var(--ks-muted); margin-bottom: 20px; }
.ksq-pdp-bar::after { content: ""; flex: 1; height: 1px; background: var(--ks-line); }
.ksq-pdp-bar b { color: var(--ks-accent); }
.ksq-pdp-bar i { font-style: normal; margin-left: auto; }

@media (max-width: 960px) {
  .ksq-header-in { grid-template-columns: 1fr auto; }
  .ksq-header-in .ksq-nav { display: none; }
  .ksq-ecosystem .wrap { grid-template-columns: 1fr; }
  .ksq-masonry { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 230px; }
  .ksq-look { grid-template-columns: repeat(2, 1fr); }
  #pdp-root[data-page-model="quartz-stage"] .pdp { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .ksq-buy { margin: -40px 12px 0; padding: 26px 18px; border-radius: 24px; }
  .ksq-media { min-height: 380px; border-radius: 28px; padding: 24px 14px; }
  .ksq-arch { border-radius: 220px 220px 24px 24px; padding: 30px 16px 24px; }
  .ksq-chips { position: static; margin-top: 18px; }
  .ksq-masonry { grid-template-columns: 1fr; grid-auto-rows: auto; }
  .ksq-look { grid-template-columns: 1fr; }
}
'''


