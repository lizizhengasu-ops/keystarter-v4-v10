            "product.html": product_page_v2,
            "products.html": products_page,
            "b2b.html": b2b_page,
            "support.html": support_page,
        },
    }
    build_only = {s.strip() for s in os.environ.get("BUILD_ONLY", "").split(",") if s.strip()}
    for style, root in OUT.items():
        if build_only and style not in build_only:
            continue
        aliases = set()
        os.makedirs(os.path.join(root, "_analysis", "reports"), exist_ok=True)
        for fname in os.listdir(STERLING):
            if not fname.endswith(".html"):
                continue
            src = os.path.join(STERLING, fname)
            dst = os.path.join(root, fname)
            with open(src, "r", encoding="utf-8", errors="replace") as f:
                html = f.read()
            rebuilt = pages_to_rebuild[style].get(fname)
            if rebuilt:
                out = rebuilt(style)
            else:
                out = transform_generic(style, html, aliases)
            if out is None:
                continue
            with open(dst, "w", encoding="utf-8") as f:
                f.write(out)
        # Collect classes from home/product/products/b2b/support too.
        for fname in pages_to_rebuild[style]:
            with open(os.path.join(root, fname), "r", encoding="utf-8") as f:
                html = f.read()
            for m in re.finditer(r'class="([^"]+)"', html):
                for c in m.group(1).split():
                    slug = re.sub(r"[^a-z0-9-]+", "-", c).strip("-")
                    aliases.add(slug)
        write_css(style, aliases)
        write_evidence(style)
        print("built", root, "aliases", len(aliases))


if __name__ == "__main__":
    main()
