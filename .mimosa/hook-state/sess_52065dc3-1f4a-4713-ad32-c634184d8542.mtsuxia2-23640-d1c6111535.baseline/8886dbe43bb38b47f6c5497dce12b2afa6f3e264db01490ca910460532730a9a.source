def products_page(style):
    p = STYLES[style]["prefix"]
    cards = []
    for cat, name, img, price, rating, href, tag in PRODUCT_ROWS:
        img_src = "assets/img/" + img
        cards.append(
            f'<article class="prod-card" data-cat="{cat}"><div class="img"><span class="badge">{tag}</span><img src="{img_src}" alt="{name}"></div><h3><a href="{href}">{name}</a></h3><div class="rating"><span class="stars">★★★★★</span> {rating}</div><div class="prices"><b>{price}</b></div><div class="actions"><button class="btn btn-primary" data-add>Add to Cart</button><a class="btn btn-amber" href="cart.html">Buy Now</a></div></article>'
        )
    grid_html = "\n".join(cards)
    body = f'''<div class="wrap">
      <div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>Products</span></div>
      <div class="section-head" style="margin-top:14px">
        <div>
          <span class="eyebrow">Genuine licenses</span>
          <h1 class="h2" style="margin-top:10px">All Products</h1>
          <p style="margin-top:8px">Every key verified before sale, delivered to your inbox in minutes, backed by a 14-day refund.</p>
        </div>
      </div>

      <div class="filter-bar">
        <button class="chip on" data-filter="all" type="button">All</button>
        <button class="chip" data-filter="windows" type="button">Windows</button>
        <button class="chip" data-filter="office" type="button">Office</button>
        <button class="chip" data-filter="server" type="button">Server / SQL</button>
        <button class="chip" data-filter="iot" type="button">IoT</button>
        <span class="count">28 products</span>
        <select aria-label="Sort">
          <option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Rating</option>
        </select>
      </div>

      <div class="prod-grid" id="product-grid">
        {grid_html}
      </div>

      <section class="section" id="compare">
        <div class="section-head">
          <div>
            <span class="eyebrow">Compare editions</span>
            <h2 class="h2" style="margin-top:10px">Windows 11 Pro vs Home vs IoT</h2>
            <p style="margin-top:8px">Pick the right edition for your device or deployment.</p>
          </div>
        </div>
        <div class="compare-table">
          <table>
            <thead><tr><th>Capability</th><th>Windows 11 Pro</th><th>Windows 11 Home</th><th>Windows 11 IoT Enterprise</th></tr></thead>
            <tbody>
              <tr><td>BitLocker device encryption</td><td>Yes</td><td>No</td><td>Yes</td></tr>
              <tr><td>Remote Desktop host</td><td>Yes</td><td>No</td><td>Yes</td></tr>
              <tr><td>Hyper-V / WSL2</td><td>Yes</td><td>No</td><td>Yes</td></tr>
              <tr><td>LTSC 10-year lifecycle</td><td>No</td><td>No</td><td>Yes</td></tr>
              <tr><td>Kiosk / signage mode</td><td>Limited</td><td>No</td><td>Yes</td></tr>
              <tr><td>Best for</td><td>Business laptops</td><td>Personal use</td><td>Embedded / industrial</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section tight" style="border-top:1px solid var(--ks-line)">
        <div class="section-head"><div><span class="eyebrow">Why KeyStarter</span><h2 class="h2">Trusted by buyers worldwide</h2></div></div>
        <div class="row">
          <div class="stat-card"><b class="h3">10 min</b><span class="sub">Average email delivery</span></div>
          <div class="stat-card"><b class="h3">100%</b><span class="sub">Keys verified before sale</span></div>
          <div class="stat-card"><b class="h3">14 day</b><span class="sub">Refund guarantee</span></div>
        </div>
      </section>
    </div>'''
    return page(
        style,
        "All Products - Genuine Windows, Office, Server & SQL Keys | KeyStarter",
        "Browse 28 genuine Microsoft license keys: Windows 11/10 Pro, Office 2021/2019, Windows Server IoT and SQL Server runtime. Instant delivery and 14-day refund.",
        body,
        canonical="https://keys-starter.com/products",
    )


