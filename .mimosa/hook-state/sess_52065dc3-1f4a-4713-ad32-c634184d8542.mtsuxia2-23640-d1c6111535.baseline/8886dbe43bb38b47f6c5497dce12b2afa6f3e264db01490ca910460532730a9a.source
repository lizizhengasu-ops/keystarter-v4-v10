              <div class="field"><label for="b2b-contact">Contact</label><input id="b2b-contact" name="contact" placeholder="Contact name"></div>
              <div class="field full"><label for="b2b-email">Email</label><input id="b2b-email" type="email" name="email" placeholder="you@company.com"></div>
              <div class="field full"><label for="b2b-note">Notes</label><textarea id="b2b-note" name="note" rows="4" placeholder="Delivery region, deadlines, existing estate..."></textarea></div>
