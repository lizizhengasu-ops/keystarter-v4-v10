      <div><h4>Shop</h4><a href="products.html">All products</a><a href="products.html">Windows</a><a href="products.html">Office</a><a href="products.html">Server / SQL</a><a href="b2b.html">Enterprise / B2B</a></div>
      <div><h4>Support</h4><a href="support.html">Help center</a><a href="contact.html">Contact us</a><a href="faq.html">FAQ</a><a href="downloads.html">Downloads</a><a href="account.html">Account</a></div>
      <div><h4>Company</h4><a href="about.html">About</a><a href="licensing.html">Licensing</a><a href="blog.html">Blog</a><a href="legal.html#privacy">Privacy</a><a href="legal.html#terms">Terms</a><a href="legal.html#refund">Refund</a></div>
