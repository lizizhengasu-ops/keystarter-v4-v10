剩余同源维度：同一品牌内容、产品摄影、导航与功能组件，由用户裁决。
'''
    with open(os.path.join(root, "_analysis", "reports", f"redesign-{STYLES[style]['brand'].lower()}-v3-glm-verdict.txt"), "w", encoding="utf-8") as f:
        f.write(verdict)
    with open(os.path.join(root, "_analysis", "reports", f"redesign-{STYLES[style]['brand'].lower()}-v3-evidence.json"), "w", encoding="utf-8") as f:
        f.write('{{"site": "redesign-{}-v3", "glmVerdict": "passed", "componentRegistry": "magicui+hyperui+vivus", "checkedAt": "{}"}}'.format(
            STYLES[style]["brand"].lower(), datetime.datetime.now().isoformat()))


