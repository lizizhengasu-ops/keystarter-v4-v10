        "Genuine Microsoft Key - Instant Delivery | KeyStarter",
        "Genuine Microsoft license key with instant email delivery, 14-day refund guarantee and verified activation.",
        body,
        '<script src="assets/preview-data.js"></script>\n  <script>\n    (function () {\n      var slug = new URLSearchParams(location.search).get("slug") || "windows-11-pro";\n      var p = window.PREVIEW_PRODUCTS.find(function (x) { return x.slug === slug; });\n      if (!p) { location.replace("products.html"); return; }\n      document.title = "Buy " + p.name + " - Instant Email Delivery | KeyStarter";\n      document.getElementById("bc-name").textContent = p.name;\n      document.getElementById("p-name").textContent = p.name;\n      document.getElementById("p-price").textContent = "$" + p.price.toFixed(2);\n      var addBtn = document.querySelector("#pdp-root .pdp-cta button[data-add]");\n      if (addBtn) addBtn.textContent = "Add to Cart - $" + p.price.toFixed(2);\n      document.getElementById("p-desc").innerHTML = "<b>Instant delivery</b> - " + p.desc + ". Key emailed within 10 minutes of payment.";\n      document.getElementById("p-img").src = "assets/img/" + p.image;\n      document.getElementById("p-thumb").src = "assets/img/" + p.image;\n      var specs = document.getElementById("p-specs");\n      var html = "";\n      Object.keys(p.specs).forEach(function (k) {\n        html += "<tr><th>" + k.charAt(0).toUpperCase() + k.slice(1) + "</th><td>" + p.specs[k] + "</td></tr>";\n      });\n      specs.innerHTML = html;\n      var ld = { "@context": "https://schema.org", "@type": "Product", name: p.name, sku: p.slug, image: ["https://keys-starter.com/assets/images/" + p.image], description: p.desc, offers: { "@type": "Offer", price: p.price.toFixed(2), priceCurrency: "USD", availability: "https://schema.org/InStock", url: "https://keys-starter.com/product/" + p.slug } };\n      var s = document.createElement("script");\n      s.type = "application/ld+json";\n      s.textContent = JSON.stringify(ld);\n      document.head.appendChild(s);\n    })();\n  </script>',
        canonical="https://keys-starter.com/product/",
    )


