        }[style]
        stamp = '<span class="ksl-stamp">VERIFIED ISSUE</span>' if style == "ledger" else ""
        body = f'''<div class="wrap" id="pdp-root" data-page-model="{pdp_model}">
      <div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <a href="products.html">Products</a> <span>/</span> <span id="bc-name">Product</span></div>
