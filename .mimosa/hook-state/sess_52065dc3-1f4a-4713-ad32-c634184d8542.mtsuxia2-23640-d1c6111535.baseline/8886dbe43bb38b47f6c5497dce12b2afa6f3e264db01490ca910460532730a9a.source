def support_page(style):
    p = STYLES[style]["prefix"]
    body = f'''<div class="wrap">
      <div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>Help Center</span></div>
      <div class="section-head" style="margin-top:14px">
        <div>
          <span class="eyebrow">Help Center</span>
          <h1 class="h2" style="margin-top:10px">How can we help?</h1>
          <p style="margin-top:8px">Orders, activation, refunds and account help. Average first response under 30 minutes.</p>
        </div>
      </div>

