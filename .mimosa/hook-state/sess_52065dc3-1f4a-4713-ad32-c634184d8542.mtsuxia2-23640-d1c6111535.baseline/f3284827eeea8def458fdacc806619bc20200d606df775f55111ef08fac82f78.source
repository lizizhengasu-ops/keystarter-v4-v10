    if style == "console":
        body = f'''<div class="wrap" id="pdp-root" data-page-model="{model}"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <a href="products.html">Products</a> <span>/</span> <span id="bc-name">Product</span></div><div class="pdp {p}-pdp">{media}<div class="pdp-info {p}-buy"><div class="{p}-pdp-bar"><span>LICENSE CONSOLE</span><b>STATUS: VERIFIED</b><i>DELIVERY: 10 MIN</i></div><h1 id="p-name" class="h2">Product</h1><div class="pdp-price"><span class="now" id="p-price">$0.00</span><span class="save">Genuine license</span></div><div class="pdp-rating"><span class="stars">★★★★★</span> 4.9 <a href="#reviews">View All Reviews</a></div><p class="pdp-msg" id="p-desc"><b>Instant delivery</b> - key emailed within 10 minutes of payment.</p><div class="{p}-qty"><label for="{p}-qty">License seats</label><select id="{p}-qty"><option>1 seat</option><option>5 seats</option><option>10 seats</option><option>Volume quote</option></select></div><div class="pdp-cta"><button class="btn btn-primary btn-lg" data-add>Add to Cart</button><a class="btn btn-amber btn-lg pdp-buy" href="cart.html">Buy Now - Get Key in 10 Min</a></div><div class="pdp-pay"><span>Secure payment:</span><span class="pay-badge">VISA</span><span class="pay-badge">MASTERCARD</span><span class="pay-badge">PAYPAL</span><span class="pay-badge">AMEX</span></div>{trust}{tabs}{panels}</div></div></div>'''
    else:
        body = f'''<div class="wrap" id="pdp-root" data-page-model="{model}"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <a href="products.html">Products</a> <span>/</span> <span id="bc-name">Product</span></div><div class="{p}-spread"><div class="{p}-media"><span class="{p}-media-chip">ISSUE NO. 2026-08-29</span><img id="p-img" src="assets/img/box-win11-pro.webp" alt="Product"><div class="thumb"><span class="on"><img id="p-thumb" src="assets/img/box-win11-pro.webp" alt="Product"></span></div></div><div class="{p}-buy"><div class="{p}-pdp-bar"><span>EDITORIAL ISSUE</span><b>STATUS: VERIFIED</b><i>DELIVERY: 10 MIN</i></div><span class="eyebrow">Genuine Microsoft license</span><h1 id="p-name" class="h2">Product</h1><div class="pdp-price"><span class="now" id="p-price">$0.00</span><span class="save">Genuine license</span></div><div class="pdp-rating"><span class="stars">★★★★★</span> 4.9 <a href="#reviews">View All Reviews</a></div><p class="pdp-msg" id="p-desc"><b>Instant delivery</b> - key emailed within 10 minutes of payment.</p><div class="pdp-cta"><button class="btn btn-primary btn-lg" data-add>Add to Cart</button><a class="btn btn-amber btn-lg pdp-buy" href="cart.html">Buy Now - Get Key in 10 Min</a></div><div class="pdp-pay"><span>Secure payment:</span><span class="pay-badge">VISA</span><span class="pay-badge">MASTERCARD</span><span class="pay-badge">PAYPAL</span><span class="pay-badge">AMEX</span></div>{trust}</div></div><div class="{p}-panels">{tabs}{panels}</div></div>'''
    script = '''<script src="assets/preview-data.js"></script><script>(function(){var slug=new URLSearchParams(location.search).get("slug")||"windows-11-pro";var p=window.PREVIEW_PRODUCTS.find(function(x){return x.slug===slug;});if(!p){location.replace("products.html");return;}document.title="Buy "+p.name+" - Instant Email Delivery | KeyStarter";document.getElementById("bc-name").textContent=p.name;document.getElementById("p-name").textContent=p.name;document.getElementById("p-price").textContent="$"+p.price.toFixed(2);var a=document.querySelector("#pdp-root .pdp-cta button[data-add]");if(a)a.textContent="Add to Cart - $"+p.price.toFixed(2);document.getElementById("p-desc").innerHTML="<b>Instant delivery</b> - "+p.desc+". Key emailed within 10 minutes of payment.";document.getElementById("p-img").src="assets/img/"+p.image;document.getElementById("p-thumb").src="assets/img/"+p.image;var s=document.getElementById("p-specs"),h="";Object.keys(p.specs).forEach(function(k){h+="<tr><th>"+k.charAt(0).toUpperCase()+k.slice(1)+"</th><td>"+p.specs[k]+"</td></tr>";});s.innerHTML=h;})();</script>'''
    return page(style, "Genuine Microsoft Key - Instant Delivery | KeyStarter", "Genuine Microsoft license key with instant email delivery, 14-day refund guarantee and verified activation.", body, script, canonical="https://keys-starter.com/product/")


