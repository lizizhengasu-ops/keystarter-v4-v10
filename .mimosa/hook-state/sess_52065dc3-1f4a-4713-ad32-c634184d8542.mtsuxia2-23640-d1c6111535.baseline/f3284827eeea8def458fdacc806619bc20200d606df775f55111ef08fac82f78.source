    if style == "sovereign":
        body = f'''<div class="wrap" id="pdp-root" data-page-model="{model}"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <a href="products.html">Products</a> <span>/</span> <span id="bc-name">Product</span></div><div class="pdp {p}-pdp">{media}<div class="pdp-info {p}-buy"><div class="{p}-pdp-bar"><span>LICENSE CHECKOUT</span><b>STATUS: VERIFIED</b><i>DELIVERY: 10 MIN</i></div><h1 id="p-name" class="h2">Product</h1><div class="pdp-price"><span class="now" id="p-price">$0.00</span><span class="save">Genuine license</span></div><div class="pdp-rating"><span class="stars">★★★★★</span> 4.9 <a href="#reviews">View All Reviews</a></div><p class="pdp-msg" id="p-desc"><b>Instant delivery</b> - key emailed within 10 minutes of payment.</p><div class="{p}-qty"><label for="{p}-qty">License seats</label><select id="{p}-qty"><option>1 seat</option><option>5 seats</option><option>10 seats</option><option>Volume quote</option></select></div><div class="pdp-cta"><button class="btn btn-primary btn-lg" data-add>Add to Cart</button><a class="btn btn-amber btn-lg pdp-buy" href="cart.html">Buy Now - Get Key in 10 Min</a></div><div class="pdp-pay"><span>Secure payment:</span><span class="pay-badge">VISA</span><span class="pay-badge">MASTERCARD</span><span class="pay-badge">PAYPAL</span><span class="pay-badge">AMEX</span></div>{trust}{tabs}{panels}</div></div></div>'''
    else:
        body = f'''<div class="wrap" id="pdp-root" data-page-model="{model}"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <a href="products.html">Products</a> <span>/</span> <span id="bc-name">Product</span></div><div class="{p}-stage"><div class="{p}-media"><span class="{p}-media-chip">VERIFIED LICENSE</span><img id="p-img" src="assets/img/box-win11-pro.webp" alt="Product"><div class="thumb"><span class="on"><img id="p-thumb" src="assets/img/box-win11-pro.webp" alt="Product"></span></div></div><div class="{p}-buy"><div class="{p}-pdp-bar"><span>PRODUCT STAGE</span><b>STATUS: VERIFIED</b><i>DELIVERY: 10 MIN</i></div><span class="eyebrow">Genuine Microsoft license</span><h1 id="p-name" class="h2">Product</h1><div class="pdp-price"><span class="now" id="p-price">$0.00</span><span class="save">Genuine license</span></div><div class="pdp-rating"><span class="stars">★★★★★</span> 4.9 <a href="#reviews">View All Reviews</a></div><p class="pdp-msg" id="p-desc"><b>Instant delivery</b> - key emailed within 10 minutes of payment.</p><div class="pdp-cta"><button class="btn btn-primary btn-lg" data-add>Add to Cart</button><a class="btn btn-amber btn-lg pdp-buy" href="cart.html">Buy Now - Get Key in 10 Min</a></div><div class="pdp-pay"><span>Secure payment:</span><span class="pay-badge">VISA</span><span class="pay-badge">MASTERCARD</span><span class="pay-badge">PAYPAL</span><span class="pay-badge">AMEX</span></div>{trust}</div></div><div class="{p}-panels">{tabs}{panels}</div></div>'''
    script = '''<script src="assets/preview-data.js"></script><script>(function(){var slug=new URLSearchParams(location.search).get("slug")||"windows-11-pro";var p=window.PREVIEW_PRODUCTS.find(function(x){return x.slug===slug;});if(!p){location.replace("products.html");return;}document.title="Buy "+p.name+" - Instant Email Delivery | KeyStarter";document.getElementById("bc-name").textContent=p.name;document.getElementById("p-name").textContent=p.name;document.getElementById("p-price").textContent="$"+p.price.toFixed(2);var a=document.querySelector("#pdp-root .pdp-cta button[data-add]");if(a)a.textContent="Add to Cart - $"+p.price.toFixed(2);document.getElementById("p-desc").innerHTML="<b>Instant delivery</b> - "+p.desc+". Key emailed within 10 minutes of payment.";document.getElementById("p-img").src="assets/img/"+p.image;document.getElementById("p-thumb").src="assets/img/"+p.image;var s=document.getElementById("p-specs"),h="";Object.keys(p.specs).forEach(function(k){h+="<tr><th>"+k.charAt(0).toUpperCase()+k.slice(1)+"</th><td>"+p.specs[k]+"</td></tr>";});s.innerHTML=h;})();</script>'''
    return page(style, "Genuine Microsoft Key - Instant Delivery | KeyStarter", "Genuine Microsoft license key with instant email delivery, 14-day refund guarantee and verified activation.", body, script, canonical="https://keys-starter.com/product/")


def products_page(style):
    p = THEMES[style]["prefix"]
    if style in ("console", "editorial"):
        return products_page_v5(style)
    cards = []
    for cat, name, img, price, rating, href, tag in PRODUCTS:
        cards.append(f'<article class="prod-card" data-cat="{cat}"><div class="img"><span class="badge">{tag}</span><img src="assets/img/{img}" alt="{name}"></div><h3><a href="{href}">{name}</a></h3><div class="rating">{rating}</div><div class="prices"><b>{price}</b></div><div class="actions"><button class="btn btn-primary" data-add>Add to Cart</button><a class="btn btn-amber" href="cart.html">Buy Now</a></div></article>')
    grid = "\n".join(cards)
    body = f'''<div class="wrap"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>Products</span></div><div class="section-head"><div><span class="eyebrow">Genuine licenses</span><h1 class="h2">All Products</h1><p>Every key verified before sale, delivered to your inbox in minutes, backed by a 14-day refund.</p></div></div><div class="filter-bar"><button class="chip on" data-filter="all" type="button">All</button><button class="chip" data-filter="windows" type="button">Windows</button><button class="chip" data-filter="office" type="button">Office</button><button class="chip" data-filter="server" type="button">Server / SQL</button><button class="chip" data-filter="iot" type="button">IoT</button><span class="count">28 products</span><select aria-label="Sort"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Rating</option></select></div><div class="prod-grid" id="product-grid">{grid}</div><section class="section tight" style="border-top:1px solid var(--ks-line)"><div class="section-head"><div><span class="eyebrow">Why KeyStarter</span><h2 class="h2">Trusted by buyers worldwide</h2></div></div><div class="row"><div class="stat-card"><b class="h3">10 min</b><span class="sub">Average email delivery</span></div><div class="stat-card"><b class="h3">100%</b><span class="sub">Keys verified before sale</span></div><div class="stat-card"><b class="h3">14 day</b><span class="sub">Refund guarantee</span></div></div></section></div>'''
    return page(style, "All Products - Genuine Windows, Office, Server & SQL Keys | KeyStarter", "Browse 28 genuine Microsoft license keys with instant delivery and 14-day refund.", body, canonical="https://keys-starter.com/products")


def b2b_page(style):
    p = THEMES[style]["prefix"]
    if style in ("console", "editorial"):
        return b2b_page_v5(style)
    body = f'''<div class="wrap"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>Enterprise</span></div><section class="b2b-split {p}-b2b"><div><span class="eyebrow">Enterprise licensing</span><h1 class="h2">Volume pricing, compliance-ready records.</h1><p class="lead">Windows, Office, Server and IoT licensing for business estates. Clean invoices, audit-ready documentation and a dedicated B2B team.</p><div class="{p}-b2b-list"><div><b>Volume pricing</b><small>Quotes for 10 to 10,000 seats</small></div><div><b>Compliance docs</b><small>Invoices, license records, SAM support</small></div><div><b>Fast delivery</b><small>Keys issued in 10 minutes</small></div><div><b>Dedicated support</b><small>Real engineers, lifetime help</small></div></div></div><form data-form class="b2b-quick"><h3>Request a volume quote</h3><input name="company" placeholder="Company"><input name="units" placeholder="Estimated units"><select name="product"><option>Windows</option><option>Office</option><option>Server / SQL</option><option>IoT</option><option>Mixed estate</option></select><input name="contact" placeholder="Contact"><input name="phone" placeholder="Phone / WhatsApp"><button class="btn btn-accent" type="submit">Get Free Quote</button></form></section><section class="section tight"><div class="section-head"><div><span class="eyebrow">How it works</span><h2 class="h2">From quote to compliance in four steps</h2></div></div><div class="step-row"><div class="step-item"><span>01</span><b>Quote</b><small>Share your estate</small></div><div class="step-item"><span>02</span><b>Approve</b><small>PO and payment</small></div><div class="step-item"><span>03</span><b>Issue</b><small>Keys in 10 minutes</small></div><div class="step-item"><span>04</span><b>Audit</b><small>Clean records for SAM</small></div></div></section></div>'''
    return page(style, "Enterprise Licensing & Volume Quotes | KeyStarter", "Volume pricing for Windows, Office, Server and IoT licenses with compliance-ready records.", body, canonical="https://keys-starter.com/b2b")


def support_page(style):
    p = THEMES[style]["prefix"]
    if style in ("console", "editorial"):
        return support_page_v5(style)
    body = f'''<div class="wrap"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>Support</span></div><section class="support-hero {p}-support-hero"><span class="eyebrow">Help center</span><h1 class="h2">How can we help?</h1><p class="lead">Activation, installation, licensing, payments and refunds. Real answers from a real team.</p><div class="search-box"><span class="search-sign">SUPPORT /</span><input placeholder="Search activation, installation, refunds..." aria-label="Search"></div></section><section class="section tight"><div class="topic-grid"><a href="support.html">Activation</a><a href="support.html">Installation</a><a href="support.html">Licensing</a><a href="account.html">Account</a><a href="support.html#faq">Payments</a><a href="support.html#faq">Refunds</a><a href="downloads.html">Downloads</a><a href="contact.html">Contact</a></div></section><section class="section tight" id="faq"><div class="section-head"><div><span class="eyebrow">FAQ</span><h2 class="h2">Frequently asked questions</h2></div></div><div class="faq"><details open><summary>How do I receive my key?</summary><p>The key is emailed to your order address within 10 minutes of payment.</p></details><details><summary>Will this key activate?</summary><p>Yes. Keys are verified before sale and supported by a 14-day refund guarantee.</p></details><details><summary>What if the key doesn't work?</summary><p>Contact support within 14 days for a replacement or refund.</p></details><details><summary>Do you support business deployments?</summary><p>Yes. Volume quotes, compliance records and SAM audit support are available through the B2B team.</p></details></div></section></div>'''
    return page(style, "Support Center - Activation, Licensing, Refunds | KeyStarter", "Get help with activation, installation, licensing, payments and refunds.", body, canonical="https://keys-starter.com/support")


MINOR = {
    "about.html": ("About KeyStarter", "About us", "Independent authorized Microsoft software partner since 2021. Every key is sourced through authorized channels, verified before sale and delivered with a numbered issue record.", [("Our promise", "<p>Genuine licenses, verified activation, 10-minute delivery and a 14-day refund guarantee. We exist to make buying software keys safe, simple and honest.</p>"), ("The team", "<p>A small operations team covering sourcing, verification, delivery and support. Every order gets a real human behind it.</p>")]),
    "account.html": ("Your Account", "Account", "Orders, license keys and download links in one place. This preview is a demo of the account surface.", [("Order history", "<p>Your past orders, invoice numbers and license keys appear here after login.</p>"), ("License vault", "<p>Every key you bought stays available in your vault for reactivation and transfer questions.</p>")]),
    "blog.html": ("Journal & Guides", "Journal", "Guides, comparisons and news about Windows, Office, Server and licensing.", [("Latest posts", "<p>Windows IoT Enterprise vs Windows 11 Pro, how to activate Windows 11, and Microsoft AI news.</p>")]),
    "blog-article.html": ("Windows IoT Enterprise vs Windows 11 Pro", "Guide", "LTSC lifecycle, kiosk scenarios and which SKU fits your deployment.", [("Key differences", "<p>Windows 11 Pro targets business laptops; IoT Enterprise adds LTSC, kiosk and signage modes with a 10-year servicing lifecycle.</p>"), ("Which one fits", "<p>Choose Pro for standard business PCs and IoT Enterprise for embedded devices, kiosks and long-life deployments.</p>")]),
    "blog-post.html": ("Windows & Microsoft AI News", "News", "Microsoft partnerships and AI gateway security from the latest Windows news.", [("This week", "<p>Microsoft announced new AI gateway security and partnerships. The full story is being published to the production blog.</p>")]),
    "cart.html": ("Your Cart", "Cart", "Review selected licenses, then check out securely.", [("Cart", "<p>Selected licenses, prices and secure checkout options appear here. This is a demo surface; production connects to WooCommerce.</p>")]),
    "changelog.html": ("Changelog", "Changelog", "Release notes for the KeyStarter storefront and licensing platform.", [("Latest", "<p>v4 local preview: rebuilt full-site skeleton, premium Shopify/Apple design language and full-page visual regression.</p>")]),
    "compare.html": ("Compare Editions", "Compare", "Windows 11 Pro vs Home vs IoT Enterprise.", [("Comparison", "<p>BitLocker, Remote Desktop, Hyper-V, LTSC lifecycle and kiosk mode compared across editions.</p>")]),
    "contact.html": ("Contact Us", "Contact", "Talk to the team about orders, support or volume licensing.", [("Ways to reach us", "<p>Support chat, email and the B2B quote form are the fastest routes. Response within one business day.</p>")]),
    "downloads.html": ("Downloads", "Downloads", "Official download links and activation helpers.", [("Downloads", "<p>Microsoft official download pages, media creation tools and activation guides are listed here.</p>")]),
    "faq.html": ("FAQ", "FAQ", "Answers about delivery, activation, refunds and licensing.", [("Common questions", "<p>Keys are emailed within 10 minutes, verified before sale, and protected by a 14-day refund guarantee.</p>")]),
    "legal.html": ("Legal & Policies", "Legal", "Privacy, terms and refund policies.", [("Policies", "<p>Privacy, terms of service and refund policy text live on this page for production; this preview keeps the structure and placeholders.</p>")]),
    "licensing.html": ("Licensing", "Licensing", "How KeyStarter sources, verifies and issues Microsoft licenses.", [("Sourcing", "<p>Keys are sourced through authorized channels and matched to stock before issue.</p>"), ("Verification", "<p>Every key is activation-tested before sale and recorded with a numbered issue record.</p>")]),
    "links.html": ("Resource Links", "Links", "Official Microsoft resources and partner references.", [("Resources", "<p>Microsoft download pages, activation guides and licensing documentation are linked from here.</p>")]),
}


def minor_page(style, fname):
    t = THEMES[style]
    p = t["prefix"]
    if style in ("console", "editorial"):
        return minor_page_v5(style, fname)
    meta = MINOR[fname]
    title, eyebrow, intro, sections = meta
    blocks = "\n".join(f'<section class="content-block"><h3>{h}</h3>{b}</section>' for h, b in sections)
    if style == "sovereign":
        body = f'''<div class="wrap"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>{eyebrow}</span></div><div class="minor-layout"><aside class="minor-side"><span class="eyebrow">KeyStarter</span><h2>{eyebrow}</h2><a href="products.html">Products</a><a href="b2b.html">Enterprise</a><a href="support.html">Support</a><a href="blog.html">Journal</a><a href="contact.html">Contact</a></aside><div class="minor-main"><span class="eyebrow">{eyebrow}</span><h1 class="h2">{title}</h1><p class="lead">{intro}</p>{blocks}</div></div></div>'''
    else:
        body = f'''<div class="wrap"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>{eyebrow}</span></div><div class="minor-editorial"><span class="eyebrow">{eyebrow}</span><h1 class="h1">{title}</h1><p class="lead">{intro}</p><div class="minor-rule"></div>{blocks}<div class="minor-nav"><a href="products.html">Browse products</a><a href="support.html">Support</a><a href="contact.html">Contact</a></div></div></div>'''
    return page(style, f"{title} | KeyStarter", intro, body, canonical=f"https://keys-starter.com/{fname.replace('.html','')}")


SOVEREIGN_CSS = r'''
[data-theme="sovereign"] { --ks-bg:#ffffff; --ks-ink:#10130f; --ks-muted:#5f6b66; --ks-line:#e5ebe8; --ks-card:#ffffff; --ks-accent:#008060; --ks-accent-ink:#ffffff; --ks-soft:#f4f7f5; --ks-warn:#b45309; --ks-font:"Manrope",sans-serif; --ks-mono:"IBM Plex Mono",monospace; --ks-radius:14px; --ks-shadow:0 1px 2px rgba(16,19,15,.04),0 20px 50px -36px rgba(16,19,15,.3); --ks-header:rgba(255,255,255,.92); }
@font-face{font-family:"Manrope";src:url("../fonts/manrope-500.woff2") format("woff2");font-weight:500;font-display:swap;}
@font-face{font-family:"Manrope";src:url("../fonts/manrope-700.woff2") format("woff2");font-weight:700;font-display:swap;}
@font-face{font-family:"Manrope";src:url("../fonts/manrope-800.woff2") format("woff2");font-weight:800;font-display:swap;}
@font-face{font-family:"IBM Plex Mono";src:url("../fonts/ibm-plex-mono-400.woff2") format("woff2");font-weight:400;font-display:swap;}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:var(--ks-font);background:var(--ks-bg);color:var(--ks-ink);line-height:1.55;-webkit-font-smoothing:antialiased}img{max-width:100%;display:block}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}.section{padding:64px 0}.section.tight{padding:44px 0}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:28px}.section-head h1,.section-head h2,.section-head h3{margin:6px 0 0}.eyebrow{font-family:var(--ks-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ks-accent);font-weight:600}.h1{font-size:clamp(42px,5.6vw,78px);line-height:.98;letter-spacing:-.05em;margin:12px 0;font-weight:800}.h2{font-size:clamp(26px,3vw,40px);line-height:1.05;letter-spacing:-.03em;margin:0;font-weight:800}.h3{font-size:18px;line-height:1.2;margin:8px 0;font-weight:700}.lead{font-size:17px;color:var(--ks-muted);max-width:640px}.muted{color:var(--ks-muted)}.icon{width:18px;height:18px;vertical-align:middle}.lg{width:24px;height:24px}
.announce{position:relative;z-index:20;font-size:12px;padding:8px 18px;text-align:center;border-bottom:1px solid var(--ks-line);background:var(--ks-card);color:var(--ks-muted);display:flex;gap:14px;justify-content:center;flex-wrap:wrap}.announce a{color:var(--ks-accent);font-weight:600}.promo-msg{font-family:var(--ks-mono);letter-spacing:.08em;font-size:10px;color:var(--ks-ink)}.kso-announce{border-bottom:1px solid rgba(0,128,96,.18);background:#f0f7f3}.kso-announce .promo-msg{color:var(--ks-accent)}.kso-ver{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);border:1px solid rgba(0,128,96,.25);border-radius:999px;padding:3px 8px}
.header{position:sticky;top:0;z-index:50;background:var(--ks-header);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--ks-line)}.header-in{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:20px}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:17px}.brand small{display:block;font-family:var(--ks-mono);font-size:9px;letter-spacing:.1em;color:var(--ks-muted);font-weight:500}.brand-logo{width:28px;height:28px;object-fit:contain}.nav{display:flex;gap:4px;font-size:14px}.nav a{padding:8px 11px;border-radius:8px;color:var(--ks-muted)}.nav a:hover{color:var(--ks-ink);background:var(--ks-soft)}.header-actions{display:flex;align-items:center;gap:6px}.header-actions button{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:8px;color:var(--ks-muted)}.header-actions button:hover{background:var(--ks-soft);color:var(--ks-ink)}.count{font-size:11px;margin-left:3px}.lang{position:relative}.lang>button{width:auto;padding:0 8px;gap:4px}.lang .menu{display:none;position:absolute;right:0;top:calc(100% + 6px);background:var(--ks-card);border:1px solid var(--ks-line);border-radius:10px;box-shadow:var(--ks-shadow);padding:6px;min-width:150px;z-index:80}.lang.open .menu{display:grid}.lang .menu button{text-align:left;padding:8px 10px;border-radius:6px}.burger{display:none}.kso-delivery{display:inline-flex;align-items:center;font-family:var(--ks-mono);font-size:10px;letter-spacing:.08em;color:var(--ks-accent);border:1px solid rgba(0,128,96,.25);border-radius:999px;padding:5px 10px}
.mega{display:none;position:absolute;left:0;right:0;top:100%;background:var(--ks-card);border-bottom:1px solid var(--ks-line);box-shadow:var(--ks-shadow);padding:14px 24px;grid-template-columns:repeat(3,1fr);gap:12px;max-width:720px;margin:0 auto;border-radius:0 0 12px 12px}.header:hover .mega{display:grid}.mega a{display:flex;align-items:center;gap:10px;padding:10px;border-radius:8px}.mega a:hover{background:var(--ks-soft)}.mega img{width:46px;height:46px;object-fit:contain}.mega span{flex:1;font-size:13px;font-weight:600}.mega b{font-size:13px;color:var(--ks-accent)}
.search-panel{display:none;padding:16px 24px;border-bottom:1px solid var(--ks-line);background:var(--ks-card)}.search-panel.open{display:block}.search-box{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px;border:1px solid var(--ks-line);border-radius:10px;padding:10px 14px;background:var(--ks-bg)}.search-box input{flex:1;border:0;background:none;outline:none;font-size:15px}.search-sign{font-family:var(--ks-mono);font-size:11px;color:var(--ks-accent);letter-spacing:.08em}
.cart-drawer{display:none;position:fixed;right:0;top:0;bottom:0;width:340px;max-width:90vw;background:var(--ks-card);border-left:1px solid var(--ks-line);box-shadow:-18px 0 50px rgba(16,19,15,.12);padding:28px;z-index:100}.cart-drawer.open{display:block}.cart-drawer h3{margin:0 0 8px}.cart-drawer p{color:var(--ks-muted);font-size:14px;margin-bottom:22px}.kso-drawer{border-left:4px solid var(--ks-accent)}.kso-drawer h3{color:var(--ks-accent)}
.age-gate{position:fixed;inset:0;z-index:200;display:grid;place-content:center;background:rgba(16,19,15,.72);color:#fff;padding:24px;text-align:center}.age-gate.done{display:none}.mobile-nav{display:none}.chat-pop{position:fixed;right:20px;bottom:20px;z-index:90;background:var(--ks-ink);color:#fff;padding:12px 18px;border-radius:999px;font-weight:600;box-shadow:0 12px 30px rgba(16,19,15,.25)}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,16px);background:var(--ks-ink);color:#fff;padding:11px 16px;border-radius:8px;opacity:0;pointer-events:none;transition:.25s;z-index:300;font-size:14px}.toast.show{opacity:1;transform:translate(-50%,0)}
.footer{border-top:1px solid var(--ks-line);background:var(--ks-card);margin-top:40px}.footer-in{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;padding:48px 24px 28px}.footer-in h4{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--ks-muted);margin:0 0 12px}.footer-in a{display:block;color:var(--ks-muted);padding:4px 0;font-size:14px}.footer-in a:hover{color:var(--ks-ink)}.footer-lede{color:var(--ks-muted);font-size:14px;max-width:300px}.pay{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}.pay span,.pay-badge,.pay-badges span{font-family:var(--ks-mono);font-size:10px;letter-spacing:.06em;padding:5px 8px;border:1px solid var(--ks-line);border-radius:5px;color:var(--ks-muted)}.footer-bottom{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--ks-line);padding:16px 24px;font-size:12px;color:var(--ks-muted)}
.breadcrumb{font-size:13px;color:var(--ks-muted);margin:18px 0 8px}.breadcrumb a{color:var(--ks-accent)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:10px;padding:10px 16px;font-size:14px;font-weight:600;transition:.16s}.btn-lg{padding:13px 20px;font-size:15px}.btn-accent,.btn-primary{background:var(--ks-accent);color:var(--ks-accent-ink)}.btn-accent:hover,.btn-primary:hover{filter:brightness(.96);transform:translateY(-1px)}.btn-amber{background:var(--ks-warn);color:#fff}.btn-ghost{border-color:var(--ks-line);color:var(--ks-ink)}.btn-ghost:hover{border-color:var(--ks-accent);color:var(--ks-accent)}
.kso-hero{padding:104px 0 54px;background:radial-gradient(120% 90% at 50% 0%,rgba(0,128,96,.1),transparent 60%),linear-gradient(180deg,#fbfdfc,#fff);overflow:hidden}.kso-hero-in{max-width:1080px;margin:0 auto;text-align:center;position:relative}.kso-hero-in .h1{font-size:clamp(48px,6vw,86px)}.kso-hero-in .lead{margin:20px auto 0}.kso-cta{display:flex;gap:12px;justify-content:center;margin-top:24px;flex-wrap:wrap}.kso-stage{position:relative;width:min(820px,100%);margin:44px auto 0;background:linear-gradient(180deg,var(--ks-soft),#fff);border:1px solid var(--ks-line);border-radius:36px;padding:40px 30px 26px;overflow:hidden}.kso-stage img{width:min(500px,100%);margin:0 auto;filter:drop-shadow(0 42px 64px rgba(16,19,15,.22))}.kso-chip{position:absolute;left:22px;bottom:22px;background:rgba(255,255,255,.9);border:1px solid var(--ks-line);border-radius:14px;padding:12px 16px;box-shadow:var(--ks-shadow);text-align:left}.kso-chip b{display:block;font-size:18px;color:var(--ks-accent)}.kso-chip span{font-family:var(--ks-mono);font-size:10px;color:var(--ks-muted)}.kso-chip.alt{left:auto;right:22px}.kso-craft{color:var(--ks-accent);opacity:.4}.kso-craft svg{width:100%;height:78px}.kso-marquee{overflow:hidden;margin-top:44px;border-top:1px solid var(--ks-line);border-bottom:1px solid var(--ks-line);background:var(--ks-card);padding:14px 0}.kso-marquee-track{display:flex;gap:34px;width:max-content;white-space:nowrap;animation:kso-scroll 26s linear infinite}.kso-marquee-track span{font-family:var(--ks-mono);font-size:12px;letter-spacing:.1em;color:var(--ks-muted)}.kso-marquee-track i{font-style:normal;color:var(--ks-accent)}@keyframes kso-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.trust-strip{display:flex;gap:28px;justify-content:center;flex-wrap:wrap;padding:22px 24px;background:var(--ks-soft);border-bottom:1px solid var(--ks-line);font-size:13px;color:var(--ks-muted)}.trust-strip b{color:var(--ks-ink);font-size:16px}
.kso-best{padding:92px 0}.ledger-rows{display:grid}.kso-row{display:grid;grid-template-columns:80px 120px 1fr 150px 150px auto;gap:18px;align-items:center;border:1px solid var(--ks-line);border-bottom:0;padding:16px 18px;background:var(--ks-card)}.kso-row:first-child{border-radius:16px 16px 0 0}.kso-row:last-child{border-bottom:1px solid var(--ks-line);border-radius:0 0 16px 16px}.kso-row:hover{background:var(--ks-soft)}.kso-row .num{font-family:var(--ks-mono);color:var(--ks-muted);font-size:13px}.kso-row .img{width:110px;height:110px;display:grid;place-content:center;background:var(--ks-soft);border-radius:14px;position:relative}.kso-row img{max-height:100px;object-fit:contain}.kso-row .badge{position:absolute;top:6px;left:6px;background:var(--ks-accent);color:#fff;font-family:var(--ks-mono);font-size:8px;padding:3px 6px;border-radius:5px}.kso-row h3{font-size:16px;margin:0 0 4px}.kso-row small{color:var(--ks-muted)}.kso-row .rating{color:var(--ks-muted);font-size:12px}.kso-row .price{font-size:19px;font-weight:800}.kso-row .actions{display:flex;gap:8px}
.register-rows{display:grid;gap:10px}.kso-reg{display:grid;grid-template-columns:70px 1fr 130px auto;gap:16px;align-items:center;border:1px solid var(--ks-line);border-radius:14px;background:var(--ks-card);padding:12px 16px}.kso-reg:hover{box-shadow:var(--ks-shadow)}.kso-reg img{width:62px;height:62px;object-fit:contain}.kso-reg b{font-size:15px}.kso-reg small{display:block;color:var(--ks-muted)}.kso-reg i{font-style:normal;font-family:var(--ks-mono);color:var(--ks-accent)}.kso-reg em{font-style:normal;color:var(--ks-muted);font-size:12px}
.kso-ecosystem{background:linear-gradient(180deg,var(--ks-soft),#fff);padding:88px 0}.kso-ecosystem .wrap{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center}.kso-plates{display:grid;grid-template-columns:1fr 1fr;gap:12px}.kso-plate{border:1px solid var(--ks-line);border-radius:14px;background:var(--ks-card);padding:18px}.kso-plate b{display:block;font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px;margin-bottom:8px}.kso-plate span{font-weight:700;font-size:14px}.kso-plate small{display:block;color:var(--ks-muted);margin-top:4px;font-size:12px}
.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.topic-grid a{border:1px solid var(--ks-line);border-radius:12px;padding:14px;text-align:center;color:var(--ks-muted);background:var(--ks-card)}.topic-grid a:hover{border-color:var(--ks-accent);color:var(--ks-accent)}.step-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step-item{border:1px solid var(--ks-line);border-radius:14px;background:var(--ks-card);padding:18px}.step-item span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.step-item b{display:block;margin:8px 0 4px}.step-item small{color:var(--ks-muted)}
.support-center{background:var(--ks-soft);border-top:1px solid var(--ks-line);padding:72px 0}.support-in{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.reviews{background:var(--ks-soft);padding:84px 0}.review-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.review-card{border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-card);box-shadow:var(--ks-shadow);padding:20px}.review-card .stars{color:#f59e0b}.review-card p{font-size:14px;line-height:1.6}.review-card .who{display:block;color:var(--ks-muted);font-family:var(--ks-mono);font-size:10px;letter-spacing:.08em;margin-top:10px}.journal{background:#fff;padding:84px 0}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.blog-card{border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-card);box-shadow:var(--ks-shadow);overflow:hidden}.blog-card .img{height:150px;overflow:hidden;background:var(--ks-soft)}.blog-card .img img{width:100%;height:100%;object-fit:cover}.blog-card .tag{display:block;font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);padding:12px 14px 0}.blog-card h3{font-size:15px;margin:6px 14px}.blog-card p{color:var(--ks-muted);font-size:13px;padding:0 14px 14px;margin:0}
.trust{background:#fff;padding:70px 0}.trust-in{display:grid;grid-template-columns:auto 1fr auto;gap:30px;align-items:center;background:linear-gradient(120deg,#f0f7f3,#fff);border:1px solid rgba(0,128,96,.14);border-radius:24px;padding:36px 40px}.kso-craft{color:var(--ks-accent);opacity:.4}.kso-craft svg{width:220px;height:120px}.pay-badges{display:flex;gap:8px;flex-wrap:wrap}.metrics{list-style:none;display:flex;gap:20px;margin:18px 0 0;padding:0}.metrics b{display:block;font-size:20px;color:var(--ks-accent)}.metrics span{font-size:12px;color:var(--ks-muted)}.newsletter{background:linear-gradient(120deg,#f0f7f3,#fff);padding:70px 0}.newsletter-in{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}.newsletter-in h3{margin:0}.newsletter-in form{display:flex;gap:10px}.newsletter-in input{border:1px solid var(--ks-line);border-radius:10px;padding:10px 12px;width:260px;background:var(--ks-card)}
.prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.prod-card{border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-card);padding:14px}.prod-card .img{height:150px;display:grid;place-content:center;background:var(--ks-soft);border-radius:12px;position:relative}.prod-card img{max-height:138px;object-fit:contain}.prod-card .badge{position:absolute;top:8px;left:8px;background:var(--ks-accent);color:#fff;font-family:var(--ks-mono);font-size:9px;padding:4px 8px;border-radius:6px}.prod-card h3{font-size:15px;margin:12px 0 4px}.prod-card .rating{color:var(--ks-muted);font-size:12px}.prod-card .prices b{font-size:18px}.prod-card .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:18px 0}.chip{border:1px solid var(--ks-line);border-radius:999px;padding:8px 14px;color:var(--ks-muted);font-size:13px}.chip.on{background:var(--ks-accent);color:#fff;border-color:var(--ks-accent)}.filter-bar .count{margin-left:auto;color:var(--ks-muted);font-size:13px}.filter-bar select{border:1px solid var(--ks-line);border-radius:8px;padding:8px 10px}
.row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.stat-card{border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-card);padding:22px}.stat-card .sub{display:block;color:var(--ks-muted);font-size:13px}
.compare-table{overflow-x:auto;max-width:100%;border:1px solid var(--ks-line);border-radius:14px;background:var(--ks-card)}.compare-table table{width:100%;border-collapse:collapse;min-width:680px}.compare-table th,.compare-table td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--ks-line);font-size:14px}.compare-table thead th{background:var(--ks-soft);font-size:13px}
.b2b-split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;padding:40px 0}.kso-b2b-list{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px}.kso-b2b-list div{border:1px solid var(--ks-line);border-radius:14px;padding:18px}.kso-b2b-list b{display:block}.kso-b2b-list small{color:var(--ks-muted)}.b2b-quick{background:var(--ks-card);border:1px solid var(--ks-line);border-radius:20px;box-shadow:var(--ks-shadow);padding:26px;display:grid;gap:12px}.b2b-quick h3{margin:0}.b2b-quick input,.b2b-quick select{border:1px solid var(--ks-line);border-radius:10px;padding:11px 12px}
.support-hero{text-align:center;padding:70px 0 20px}.support-hero .lead{margin:14px auto 24px}.support-hero .search-box{max-width:640px}.faq{display:grid;gap:12px}.faq details{border:1px solid var(--ks-line);border-radius:14px;background:var(--ks-card);padding:16px 18px}.faq summary{cursor:pointer;font-weight:700}.faq p{color:var(--ks-muted);margin:10px 0 0}
.minor-layout{display:grid;grid-template-columns:260px 1fr;gap:48px;padding:40px 0 70px}.minor-side{position:sticky;top:96px;align-self:start;display:grid;gap:8px}.minor-side a{color:var(--ks-muted);padding:8px 0;border-bottom:1px solid var(--ks-line)}.minor-side a:hover{color:var(--ks-accent)}.minor-main{max-width:760px}.content-block{border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-card);padding:22px;margin-top:18px}.content-block h3{margin:0 0 8px}.content-block p{color:var(--ks-muted);margin:0}
#pdp-root[data-page-model="sovereign-checkout"] .pdp{grid-template-columns:1fr 1fr;gap:38px}#pdp-root[data-page-model="sovereign-checkout"] .pdp-media{border:1px solid var(--ks-line);border-radius:22px;background:var(--ks-soft);min-height:430px}#pdp-root[data-page-model="sovereign-checkout"] .pdp-info{padding:10px 0}.kso-buy{background:var(--ks-card);border:1px solid var(--ks-line);border-radius:20px;padding:26px;box-shadow:var(--ks-shadow)}.kso-qty{display:flex;align-items:center;gap:10px;margin:16px 0}.kso-qty label{font-family:var(--ks-mono);font-size:11px;color:var(--ks-muted);text-transform:uppercase}.kso-qty select{border:1px solid var(--ks-line);border-radius:8px;padding:8px 10px}.kso-pdp-bar{display:flex;gap:10px;align-items:center;font-family:var(--ks-mono);font-size:11px;color:var(--ks-muted);margin-bottom:18px}.kso-pdp-bar b{color:var(--ks-accent)}.kso-pdp-bar i{font-style:normal;margin-left:auto}.pdp-price{display:flex;align-items:baseline;gap:10px}.pdp-price .now{font-size:30px;font-weight:800}.pdp-price .save{color:var(--ks-muted);font-size:13px}.pdp-rating{color:var(--ks-muted);font-size:13px;margin:8px 0}.pdp-rating a{color:var(--ks-accent)}.pdp-msg{margin:14px 0}.pdp-cta{display:flex;gap:10px;flex-wrap:wrap}.pdp-pay{display:flex;gap:8px;align-items:center;margin:16px 0;flex-wrap:wrap;color:var(--ks-muted);font-size:12px}.pdp-trust{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}.pdp-trust .item{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--ks-muted)}.pdp-trust .item b{display:block;color:var(--ks-ink)}.pdp-tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--ks-line);padding-bottom:10px}.pdp-tabs button{padding:8px 12px;border-radius:8px;color:var(--ks-muted);font-size:13px}.pdp-tabs button.on{background:var(--ks-soft);color:var(--ks-ink)}.pdp-panel{display:none}.pdp-panel.on{display:block;padding-top:16px}.detail-table{width:100%;border-collapse:collapse}.detail-table th,.detail-table td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--ks-line);font-size:14px}.detail-table th{color:var(--ks-muted);font-weight:600}.b2b-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.b2b-step{border:1px solid var(--ks-line);border-radius:14px;padding:16px}.b2b-step span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.b2b-step h3{margin:8px 0 4px;font-size:15px}.b2b-step p{color:var(--ks-muted);font-size:13px;margin:0}.review-summary{display:grid;grid-template-columns:220px 1fr;gap:20px}.review-score .num{font-size:44px;font-weight:800}.review-score .stars{color:#f59e0b}
@media (max-width:960px){.nav{display:none}.burger{display:inline-flex}.mobile-nav{display:none;position:fixed;inset:0;background:var(--ks-card);padding:90px 24px 24px;z-index:60;overflow:auto}.mobile-nav.open{display:flex;flex-direction:column;gap:8px;font-size:20px}.kso-stage{width:100%}.kso-ecosystem .wrap,.support-in,.b2b-split{grid-template-columns:1fr}.kso-row{grid-template-columns:70px 1fr}.kso-row .img{grid-row:1/span 4}.kso-row .price{grid-column:2}.kso-row .actions{grid-column:1/-1}.kso-row .rating{display:none}.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row{grid-template-columns:repeat(2,1fr)}.footer-in{grid-template-columns:1fr 1fr}.minor-layout{grid-template-columns:1fr}.minor-side{position:static}.trust-in{grid-template-columns:1fr}#pdp-root[data-page-model="sovereign-checkout"] .pdp{grid-template-columns:1fr}.b2b-steps{grid-template-columns:repeat(2,1fr)}}
@media (max-width:620px){.wrap{padding:0 16px}.h1{font-size:42px}.kso-delivery{display:none}.kso-chip{position:static;margin-top:12px}.kso-chip.alt{margin-left:10px}.kso-plates{grid-template-columns:1fr}.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row,.b2b-steps{grid-template-columns:1fr}.footer-in{grid-template-columns:1fr}.kso-reg{grid-template-columns:62px 1fr}.kso-reg em{display:none}.newsletter-in form{flex-direction:column}.newsletter-in input{width:100%}.trust-in{padding:26px}}
'''

LUMINA_CSS = r'''
[data-theme="lumina"] { --ks-bg:#ffffff; --ks-ink:#1d1d1f; --ks-muted:#6e6e73; --ks-line:#ececec; --ks-card:#ffffff; --ks-accent:#0071e3; --ks-accent-ink:#ffffff; --ks-soft:#f5f5f7; --ks-warn:#b45309; --ks-font:"Plus Jakarta Sans",sans-serif; --ks-mono:"IBM Plex Mono",monospace; --ks-radius:24px; --ks-shadow:0 40px 90px -60px rgba(29,29,31,.45); --ks-header:rgba(255,255,255,.82); }
@font-face{font-family:"Plus Jakarta Sans";src:url("../fonts/plus-jakarta-sans-500.woff2") format("woff2");font-weight:500;font-display:swap;}
@font-face{font-family:"Plus Jakarta Sans";src:url("../fonts/plus-jakarta-sans-700.woff2") format("woff2");font-weight:700;font-display:swap;}
@font-face{font-family:"Bodoni Moda";src:url("../fonts/bodoni-moda-600.woff2") format("woff2");font-weight:600;font-display:swap;}
@font-face{font-family:"IBM Plex Mono";src:url("../fonts/ibm-plex-mono-400.woff2") format("woff2");font-weight:400;font-display:swap;}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:var(--ks-font);background:var(--ks-bg);color:var(--ks-ink);line-height:1.55;-webkit-font-smoothing:antialiased}img{max-width:100%;display:block}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}.section{padding:64px 0}.section.tight{padding:44px 0}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:28px}.section-head h1,.section-head h2,.section-head h3{margin:6px 0 0}.eyebrow{font-family:var(--ks-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ks-accent);font-weight:600}.h1{font-family:"Bodoni Moda",serif;font-size:clamp(48px,6vw,88px);line-height:.98;letter-spacing:-.02em;margin:12px 0;font-weight:600}.h2{font-size:clamp(26px,3vw,40px);line-height:1.05;letter-spacing:-.03em;margin:0;font-weight:700}.h3{font-size:18px;line-height:1.2;margin:8px 0;font-weight:700}.lead{font-size:17px;color:var(--ks-muted);max-width:640px}.muted{color:var(--ks-muted)}.icon{width:18px;height:18px;vertical-align:middle}.lg{width:24px;height:24px}
.announce{position:relative;z-index:20;font-size:12px;padding:8px 18px;text-align:center;border-bottom:1px solid var(--ks-line);background:var(--ks-card);color:var(--ks-muted);display:flex;gap:14px;justify-content:center;flex-wrap:wrap}.announce a{color:var(--ks-accent);font-weight:600}.promo-msg{font-family:var(--ks-mono);letter-spacing:.08em;font-size:10px;color:var(--ks-ink)}.klm-announce{border-bottom:1px solid rgba(0,113,227,.16);background:#f5f9fd}.klm-announce .promo-msg{color:var(--ks-accent)}.klm-ver{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);border:1px solid rgba(0,113,227,.25);border-radius:999px;padding:3px 8px}
.header{position:sticky;top:0;z-index:50;background:var(--ks-header);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--ks-line)}.klm-header-in{display:grid!important;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center;min-height:68px}.klm-header-in .klm-nav{justify-content:center;font-size:13px}.klm-header-in .klm-nav a{color:var(--ks-muted)}.header-in{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:20px}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:17px}.brand small{display:block;font-family:var(--ks-mono);font-size:9px;letter-spacing:.1em;color:var(--ks-muted);font-weight:500}.brand-logo{width:28px;height:28px;object-fit:contain}.nav{display:flex;gap:4px;font-size:14px}.nav a{padding:8px 11px;border-radius:8px;color:var(--ks-muted)}.nav a:hover{color:var(--ks-ink);background:var(--ks-soft)}.header-actions{display:flex;align-items:center;gap:6px}.header-actions button{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:8px;color:var(--ks-muted)}.header-actions button:hover{background:var(--ks-soft);color:var(--ks-ink)}.count{font-size:11px;margin-left:3px}.lang{position:relative}.lang>button{width:auto;padding:0 8px;gap:4px}.lang .menu{display:none;position:absolute;right:0;top:calc(100% + 6px);background:var(--ks-card);border:1px solid var(--ks-line);border-radius:12px;box-shadow:var(--ks-shadow);padding:6px;min-width:150px;z-index:80}.lang.open .menu{display:grid}.lang .menu button{text-align:left;padding:8px 10px;border-radius:8px}.burger{display:none}
.mega{display:none;position:absolute;left:0;right:0;top:100%;background:var(--ks-card);border-bottom:1px solid var(--ks-line);box-shadow:var(--ks-shadow);padding:14px 24px;grid-template-columns:repeat(3,1fr);gap:12px;max-width:720px;margin:0 auto;border-radius:0 0 14px 14px}.header:hover .mega{display:grid}.mega a{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px}.mega a:hover{background:var(--ks-soft)}.mega img{width:46px;height:46px;object-fit:contain}.mega span{flex:1;font-size:13px;font-weight:600}.mega b{font-size:13px;color:var(--ks-accent)}
.search-panel{display:none;padding:16px 24px;border-bottom:1px solid var(--ks-line);background:var(--ks-card)}.search-panel.open{display:block}.search-box{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px;border:1px solid var(--ks-line);border-radius:14px;padding:12px 16px;background:var(--ks-bg)}.search-box input{flex:1;border:0;background:none;outline:none;font-size:15px}.search-sign{font-family:var(--ks-mono);font-size:11px;color:var(--ks-accent);letter-spacing:.08em}
.cart-drawer{display:none;position:fixed;right:0;top:0;bottom:0;width:340px;max-width:90vw;background:var(--ks-card);border-left:1px solid var(--ks-line);box-shadow:-18px 0 50px rgba(29,29,31,.14);padding:28px;z-index:100}.cart-drawer.open{display:block}.cart-drawer h3{margin:0 0 8px}.cart-drawer p{color:var(--ks-muted);font-size:14px;margin-bottom:22px}.klm-drawer{border-left:4px solid var(--ks-accent);border-radius:20px 0 0 20px}.klm-drawer h3{color:var(--ks-accent)}
.age-gate{position:fixed;inset:0;z-index:200;display:grid;place-content:center;background:rgba(29,29,31,.72);color:#fff;padding:24px;text-align:center}.age-gate.done{display:none}.mobile-nav{display:none}.chat-pop{position:fixed;right:20px;bottom:20px;z-index:90;background:var(--ks-ink);color:#fff;padding:12px 18px;border-radius:999px;font-weight:600;box-shadow:0 12px 30px rgba(29,29,31,.25)}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,16px);background:var(--ks-ink);color:#fff;padding:11px 16px;border-radius:10px;opacity:0;pointer-events:none;transition:.25s;z-index:300;font-size:14px}.toast.show{opacity:1;transform:translate(-50%,0)}
.footer{border-top:1px solid var(--ks-line);background:var(--ks-card);margin-top:40px}.footer-in{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;padding:48px 24px 28px}.footer-in h4{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--ks-muted);margin:0 0 12px}.footer-in a{display:block;color:var(--ks-muted);padding:4px 0;font-size:14px}.footer-in a:hover{color:var(--ks-ink)}.footer-lede{color:var(--ks-muted);font-size:14px;max-width:300px}.pay{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}.pay span,.pay-badge,.pay-badges span{font-family:var(--ks-mono);font-size:10px;letter-spacing:.06em;padding:5px 8px;border:1px solid var(--ks-line);border-radius:6px;color:var(--ks-muted)}.footer-bottom{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--ks-line);padding:16px 24px;font-size:12px;color:var(--ks-muted)}
.breadcrumb{font-size:13px;color:var(--ks-muted);margin:18px 0 8px}.breadcrumb a{color:var(--ks-accent)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:12px;padding:11px 18px;font-size:14px;font-weight:600;transition:.18s}.btn-lg{padding:14px 22px;font-size:15px}.btn-accent,.btn-primary{background:var(--ks-accent);color:var(--ks-accent-ink)}.btn-accent:hover,.btn-primary:hover{filter:brightness(.96);transform:translateY(-1px)}.btn-amber{background:var(--ks-warn);color:#fff}.btn-ghost{border-color:var(--ks-line);color:var(--ks-ink)}.btn-ghost:hover{border-color:var(--ks-accent);color:var(--ks-accent)}
.klm-hero{padding:118px 0 44px;background:radial-gradient(120% 90% at 50% 0%,rgba(0,113,227,.12),transparent 60%),linear-gradient(180deg,#fbfbfd,#fff);overflow:hidden}.klm-hero-in{display:grid;grid-template-columns:1fr 1.05fr;gap:64px;align-items:center}.klm-hero-in .h1{font-size:clamp(46px,5.6vw,80px)}.klm-hero-in .lead{margin-top:18px}.klm-cta{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}.klm-mosaic{display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:150px;gap:14px;position:relative}.klm-tile{border-radius:26px;background:var(--ks-soft);border:1px solid var(--ks-line);display:grid;place-content:center;position:relative;overflow:hidden;padding:14px;text-align:center}.klm-tile.big{grid-row:span 2}.klm-tile img{max-height:120px;object-fit:contain;margin:0 auto}.klm-tile span{font-family:var(--ks-mono);font-size:9px;letter-spacing:.1em;color:var(--ks-accent);margin-top:8px}.klm-tile b{font-size:16px}.klm-craft{color:var(--ks-accent);opacity:.4}.klm-craft svg{width:100%;height:70px}.klm-marquee{overflow:hidden;margin-top:50px;border-top:1px solid var(--ks-line);border-bottom:1px solid var(--ks-line);background:#fbfbfd;padding:16px 0}.klm-marquee-track{display:flex;gap:38px;width:max-content;white-space:nowrap;animation:klm-scroll 30s linear infinite}.klm-marquee-track span{font-family:var(--ks-mono);font-size:12px;letter-spacing:.12em;color:var(--ks-muted)}.klm-marquee-track i{font-style:normal;color:var(--ks-accent)}@keyframes klm-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.trust-strip{display:flex;gap:28px;justify-content:center;flex-wrap:wrap;padding:22px 24px;background:var(--ks-soft);border-bottom:1px solid var(--ks-line);font-size:13px;color:var(--ks-muted)}.trust-strip b{color:var(--ks-ink);font-size:16px}
.klm-best{padding:104px 0}.klm-masonry{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:260px;gap:18px}.klm-card{border-radius:28px;background:var(--ks-soft);overflow:hidden;position:relative;display:flex;flex-direction:column;padding:18px;border:1px solid var(--ks-line)}.klm-card:nth-child(1){grid-row:span 2}.klm-card .img{flex:1;display:grid;place-content:center;min-height:0}.klm-card img{max-height:100%;max-width:100%;object-fit:contain;transition:transform .5s ease}.klm-card:hover img{transform:scale(1.05)}.klm-card .tag{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent)}.klm-card h3{font-size:16px;margin:8px 0 3px}.klm-card small{color:var(--ks-muted)}.klm-card .price{display:flex;justify-content:space-between;align-items:center;margin-top:8px}.klm-card .price b{font-size:18px}.klm-card .actions{display:flex;gap:8px;margin-top:10px}
.klm-look{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.klm-look-card{border-radius:26px;border:1px solid var(--ks-line);background:var(--ks-card);padding:14px;transition:.2s}.klm-look-card:hover{box-shadow:var(--ks-shadow);transform:translateY(-4px)}.klm-look-card .img{height:190px;display:grid;place-content:center;background:var(--ks-soft);border-radius:18px}.klm-look-card img{max-height:176px;object-fit:contain}.klm-look-card span{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent)}.klm-look-card h3{font-size:15px;margin:8px 0 3px}.klm-look-card small{color:var(--ks-muted)}.klm-look-card .price{display:flex;justify-content:space-between;align-items:center;margin-top:10px}.klm-look-card .price b{font-size:18px}.klm-look-card .price em{font-style:normal;color:var(--ks-accent);font-size:12px}
.klm-ecosystem{background:#fbfbfd;padding:96px 0}.klm-ecosystem .wrap{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.klm-timeline{display:grid;gap:10px}.klm-timeline-item{border-left:2px solid var(--ks-accent);padding:4px 0 4px 18px}.klm-timeline-item b{display:block;font-size:14px}.klm-timeline-item small{color:var(--ks-muted)}
.offers{background:#fbfbfd}.offer-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.offer-item{border:1px solid var(--ks-line);border-radius:22px;background:var(--ks-card);box-shadow:var(--ks-shadow);padding:16px}.offer-item .img{height:140px;display:grid;place-content:center;background:var(--ks-soft);border-radius:16px}.offer-item img{max-height:130px;object-fit:contain}.offer-item .tag{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent)}.offer-item h3{font-size:15px;margin:10px 0 4px}.offer-item p{color:var(--ks-muted);font-size:13px;margin:0}.offer-item b{display:block;margin-top:10px;font-size:18px}
.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.topic-grid a{border:1px solid var(--ks-line);border-radius:999px;padding:14px;text-align:center;color:var(--ks-muted);background:var(--ks-card)}.topic-grid a:hover{border-color:var(--ks-accent);color:var(--ks-accent)}.step-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step-item{border:1px solid var(--ks-line);border-radius:18px;background:var(--ks-card);padding:18px}.step-item span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.step-item b{display:block;margin:8px 0 4px}.step-item small{color:var(--ks-muted)}
.support-center{background:var(--ks-soft);border-top:1px solid var(--ks-line);padding:72px 0}.support-in{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.reviews{background:var(--ks-soft);padding:96px 0}.review-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.review-card{border:1px solid var(--ks-line);border-radius:22px;background:var(--ks-card);box-shadow:var(--ks-shadow);padding:22px}.review-card .stars{color:#f59e0b}.review-card p{font-size:14px;line-height:1.6}.review-card .who{display:block;color:var(--ks-muted);font-family:var(--ks-mono);font-size:10px;letter-spacing:.08em;margin-top:10px}.journal{background:#fff;padding:96px 0}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.blog-card{border:1px solid var(--ks-line);border-radius:22px;background:var(--ks-card);box-shadow:var(--ks-shadow);overflow:hidden}.blog-card .img{height:150px;overflow:hidden;background:var(--ks-soft)}.blog-card .img img{width:100%;height:100%;object-fit:cover}.blog-card .tag{display:block;font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);padding:12px 14px 0}.blog-card h3{font-size:15px;margin:6px 14px}.blog-card p{color:var(--ks-muted);font-size:13px;padding:0 14px 14px;margin:0}
.trust{background:#fff;padding:80px 0}.trust-in{display:grid;grid-template-columns:auto 1fr auto;gap:30px;align-items:center;background:linear-gradient(120deg,#f2f7fc,#fff);border:1px solid rgba(0,113,227,.14);border-radius:28px;padding:44px 48px}.klm-craft{color:var(--ks-accent);opacity:.38}.klm-craft svg{width:220px;height:120px}.pay-badges{display:flex;gap:8px;flex-wrap:wrap}.metrics{list-style:none;display:flex;gap:20px;margin:18px 0 0;padding:0}.metrics b{display:block;font-size:20px;color:var(--ks-accent)}.metrics span{font-size:12px;color:var(--ks-muted)}.newsletter{background:linear-gradient(120deg,#f2f7fc,#fff);padding:80px 0}.newsletter-in{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}.newsletter-in h3{margin:0}.newsletter-in form{display:flex;gap:10px}.newsletter-in input{border:1px solid var(--ks-line);border-radius:12px;padding:12px 14px;width:260px;background:var(--ks-card)}
.prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.prod-card{border:1px solid var(--ks-line);border-radius:24px;background:var(--ks-card);padding:14px}.prod-card .img{height:160px;display:grid;place-content:center;background:var(--ks-soft);border-radius:18px;position:relative}.prod-card img{max-height:146px;object-fit:contain}.prod-card .badge{position:absolute;top:8px;left:8px;background:var(--ks-accent);color:#fff;font-family:var(--ks-mono);font-size:9px;padding:4px 8px;border-radius:999px}.prod-card h3{font-size:15px;margin:12px 0 4px}.prod-card .rating{color:var(--ks-muted);font-size:12px}.prod-card .prices b{font-size:18px}.prod-card .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:18px 0}.chip{border:1px solid var(--ks-line);border-radius:999px;padding:8px 14px;color:var(--ks-muted);font-size:13px}.chip.on{background:var(--ks-accent);color:#fff;border-color:var(--ks-accent)}.filter-bar .count{margin-left:auto;color:var(--ks-muted);font-size:13px}.filter-bar select{border:1px solid var(--ks-line);border-radius:10px;padding:8px 10px}
.row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.stat-card{border:1px solid var(--ks-line);border-radius:22px;background:var(--ks-card);padding:24px}.stat-card .sub{display:block;color:var(--ks-muted);font-size:13px}
.compare-table{overflow-x:auto;max-width:100%;border:1px solid var(--ks-line);border-radius:18px;background:var(--ks-card)}.compare-table table{width:100%;border-collapse:collapse;min-width:680px}.compare-table th,.compare-table td{text-align:left;padding:14px 16px;border-bottom:1px solid var(--ks-line);font-size:14px}.compare-table thead th{background:var(--ks-soft);font-size:13px}
.b2b-split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;padding:48px 0}.klm-b2b-list{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}.klm-b2b-list div{border:1px solid var(--ks-line);border-radius:20px;padding:20px}.klm-b2b-list b{display:block}.klm-b2b-list small{color:var(--ks-muted)}.b2b-quick{background:var(--ks-card);border:1px solid var(--ks-line);border-radius:24px;box-shadow:var(--ks-shadow);padding:30px;display:grid;gap:12px}.b2b-quick h3{margin:0}.b2b-quick input,.b2b-quick select{border:1px solid var(--ks-line);border-radius:12px;padding:12px 14px}
.support-hero{text-align:center;padding:80px 0 24px}.support-hero .lead{margin:14px auto 24px}.support-hero .search-box{max-width:640px}.faq{display:grid;gap:12px}.faq details{border:1px solid var(--ks-line);border-radius:18px;background:var(--ks-card);padding:18px 20px}.faq summary{cursor:pointer;font-weight:700}.faq p{color:var(--ks-muted);margin:10px 0 0}
.minor-editorial{max-width:820px;margin:0 auto;padding:60px 0 90px;text-align:center}.minor-editorial .h1{font-size:clamp(40px,5vw,68px)}.minor-editorial .lead{margin:20px auto 0}.minor-rule{height:1px;background:var(--ks-line);margin:44px 0}.content-block{border:1px solid var(--ks-line);border-radius:24px;background:var(--ks-card);padding:26px;margin-top:18px;text-align:left}.content-block h3{margin:0 0 10px}.content-block p{color:var(--ks-muted);margin:0}.minor-nav{display:flex;gap:12px;justify-content:center;margin-top:44px}
#pdp-root[data-page-model="lumina-stage"] .klm-stage{display:block}.klm-media{position:relative;background:radial-gradient(110% 90% at 50% 0%,rgba(0,113,227,.14),transparent 62%),var(--ks-soft);border-radius:40px;min-height:560px;display:grid;place-content:center;overflow:hidden;padding:36px}.klm-media img{width:min(520px,100%);margin:0 auto;filter:drop-shadow(0 42px 64px rgba(29,29,31,.24))}.klm-media .thumb{position:absolute;left:24px;bottom:22px}.klm-media-chip{position:absolute;top:22px;left:24px;background:rgba(255,255,255,.88);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid var(--ks-line);border-radius:999px;padding:8px 14px;font-family:var(--ks-mono);font-size:11px;color:var(--ks-accent)}.klm-buy{max-width:660px;margin:-86px auto 0;position:relative;background:var(--ks-card);border:1px solid var(--ks-line);border-radius:30px;box-shadow:var(--ks-shadow);padding:34px 40px 30px;text-align:center}.klm-buy .pdp-cta{justify-content:center}.klm-buy .pdp-pay{justify-content:center}.klm-panels{max-width:980px;margin:60px auto 0}.klm-pdp-bar{display:flex;gap:10px;align-items:center;font-family:var(--ks-mono);font-size:11px;color:var(--ks-muted);margin-bottom:20px}.klm-pdp-bar::after{content:"";flex:1;height:1px;background:var(--ks-line)}.klm-pdp-bar b{color:var(--ks-accent)}.klm-pdp-bar i{font-style:normal;margin-left:auto}.pdp-price{display:flex;align-items:baseline;gap:10px}.pdp-price .now{font-size:30px;font-weight:800}.pdp-price .save{color:var(--ks-muted);font-size:13px}.pdp-rating{color:var(--ks-muted);font-size:13px;margin:8px 0}.pdp-rating a{color:var(--ks-accent)}.pdp-msg{margin:14px 0}.pdp-cta{display:flex;gap:10px;flex-wrap:wrap}.pdp-pay{display:flex;gap:8px;align-items:center;margin:16px 0;flex-wrap:wrap;color:var(--ks-muted);font-size:12px}.pdp-trust{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}.pdp-trust .item{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--ks-muted)}.pdp-trust .item b{display:block;color:var(--ks-ink)}.pdp-tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--ks-line);padding-bottom:10px}.pdp-tabs button{padding:8px 12px;border-radius:10px;color:var(--ks-muted);font-size:13px}.pdp-tabs button.on{background:var(--ks-soft);color:var(--ks-ink)}.pdp-panel{display:none}.pdp-panel.on{display:block;padding-top:16px}.detail-table{width:100%;border-collapse:collapse}.detail-table th,.detail-table td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--ks-line);font-size:14px}.detail-table th{color:var(--ks-muted);font-weight:600}.b2b-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.b2b-step{border:1px solid var(--ks-line);border-radius:18px;padding:16px}.b2b-step span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.b2b-step h3{margin:8px 0 4px;font-size:15px}.b2b-step p{color:var(--ks-muted);font-size:13px;margin:0}.review-summary{display:grid;grid-template-columns:220px 1fr;gap:20px}.review-score .num{font-size:44px;font-weight:800}.review-score .stars{color:#f59e0b}
@media (max-width:960px){.klm-header-in{grid-template-columns:1fr auto}.klm-header-in .klm-nav{display:none}.burger{display:inline-flex}.mobile-nav{display:none;position:fixed;inset:0;background:var(--ks-card);padding:90px 24px 24px;z-index:60;overflow:auto}.mobile-nav.open{display:flex;flex-direction:column;gap:8px;font-size:20px}.klm-hero-in{grid-template-columns:1fr}.klm-mosaic{grid-template-columns:1fr 1fr}.klm-ecosystem .wrap,.support-in,.b2b-split{grid-template-columns:1fr}.klm-masonry{grid-template-columns:repeat(2,1fr);grid-auto-rows:230px}.klm-look,.offer-row{grid-template-columns:repeat(2,1fr)}.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row{grid-template-columns:repeat(2,1fr)}.footer-in{grid-template-columns:1fr 1fr}.trust-in{grid-template-columns:1fr}.klm-buy{margin:-60px 12px 0}}
@media (max-width:620px){.wrap{padding:0 16px}.h1{font-size:42px}.klm-media{min-height:380px;border-radius:28px;padding:24px 14px}.klm-buy{margin:-40px 12px 0;padding:26px 18px;border-radius:24px}.klm-masonry{grid-template-columns:1fr;grid-auto-rows:auto}.klm-look,.offer-row,.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row,.b2b-steps{grid-template-columns:1fr}.footer-in{grid-template-columns:1fr}.newsletter-in form{flex-direction:column}.newsletter-in input{width:100%}.trust-in{padding:28px}.minor-editorial{padding-top:36px}}
'''


EDITORIAL_CSS = r'''
[data-theme="editorial"] { --ks-bg:#fbfaf8; --ks-ink:#16130f; --ks-muted:#6f6a62; --ks-line:#e5e0d9; --ks-card:#ffffff; --ks-accent:#e5484d; --ks-accent-ink:#ffffff; --ks-soft:#f7f5f2; --ks-warn:#b45309; --ks-font:"Plus Jakarta Sans",sans-serif; --ks-mono:"IBM Plex Mono",monospace; --ks-radius:4px; --ks-shadow:0 40px 90px -60px rgba(22,19,15,.4); --ks-header:rgba(251,250,248,.92); }
@font-face{font-family:"Plus Jakarta Sans";src:url("../fonts/plus-jakarta-sans-500.woff2") format("woff2");font-weight:500;font-display:swap;}
@font-face{font-family:"Plus Jakarta Sans";src:url("../fonts/plus-jakarta-sans-700.woff2") format("woff2");font-weight:700;font-display:swap;}
@font-face{font-family:"Bodoni Moda";src:url("../fonts/bodoni-moda-600.woff2") format("woff2");font-weight:600;font-display:swap;}
@font-face{font-family:"Bodoni Moda";src:url("../fonts/bodoni-moda-700.woff2") format("woff2");font-weight:700;font-display:swap;}
@font-face{font-family:"IBM Plex Mono";src:url("../fonts/ibm-plex-mono-400.woff2") format("woff2");font-weight:400;font-display:swap;}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:var(--ks-font);background:var(--ks-bg);color:var(--ks-ink);line-height:1.6;-webkit-font-smoothing:antialiased}img{max-width:100%;display:block}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}.section{padding:64px 0}.section.tight{padding:44px 0}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:28px}.section-head h1,.section-head h2,.section-head h3{margin:6px 0 0}.eyebrow{font-family:var(--ks-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ks-accent);font-weight:600}.h1{font-family:"Bodoni Moda",serif;font-size:clamp(48px,6.4vw,92px);line-height:.98;letter-spacing:-.015em;margin:12px 0;font-weight:600}.h2{font-family:"Bodoni Moda",serif;font-size:clamp(30px,3.6vw,48px);line-height:1.02;letter-spacing:-.01em;margin:0;font-weight:600}.h3{font-size:18px;line-height:1.2;margin:8px 0;font-weight:700}.lead{font-size:18px;color:var(--ks-muted);max-width:640px;line-height:1.7}.muted{color:var(--ks-muted)}.icon{width:18px;height:18px;vertical-align:middle}.lg{width:24px;height:24px}
.announce{position:relative;z-index:20;font-size:12px;padding:9px 18px;text-align:center;border-bottom:1px solid var(--ks-line);background:var(--ks-card);color:var(--ks-muted);display:flex;gap:14px;justify-content:center;flex-wrap:wrap}.announce a{color:var(--ks-accent);font-weight:600}.promo-msg{font-family:var(--ks-mono);letter-spacing:.1em;font-size:10px;color:var(--ks-ink)}.ked-announce{border-bottom:1px solid rgba(229,72,77,.16);background:#fdf5f4}.ked-announce .promo-msg{color:var(--ks-accent)}.ked-ver{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);border:1px solid rgba(229,72,77,.25);border-radius:999px;padding:3px 8px}
.header{position:sticky;top:0;z-index:50;background:var(--ks-header);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--ks-line)}.ked-header-in{display:grid!important;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center;min-height:72px}.ked-header-in .ked-nav{justify-content:center;font-size:13px;letter-spacing:.02em}.ked-header-in .ked-nav a{color:var(--ks-muted)}.header-in{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:20px}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:17px}.brand small{display:block;font-family:var(--ks-mono);font-size:9px;letter-spacing:.1em;color:var(--ks-muted);font-weight:500}.brand-logo{width:28px;height:28px;object-fit:contain}.ked-brand span{font-family:"Bodoni Moda",serif;font-size:24px;font-weight:600;letter-spacing:.01em}.nav{display:flex;gap:4px;font-size:14px}.nav a{padding:8px 11px;border-radius:4px;color:var(--ks-muted)}.nav a:hover{color:var(--ks-ink);background:var(--ks-soft)}.header-actions{display:flex;align-items:center;gap:6px}.header-actions button{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:4px;color:var(--ks-muted)}.header-actions button:hover{background:var(--ks-soft);color:var(--ks-ink)}.count{font-size:11px;margin-left:3px}.lang{position:relative}.lang>button{width:auto;padding:0 8px;gap:4px}.lang .menu{display:none;position:absolute;right:0;top:calc(100% + 6px);background:var(--ks-card);border:1px solid var(--ks-line);border-radius:6px;box-shadow:var(--ks-shadow);padding:6px;min-width:150px;z-index:80}.lang.open .menu{display:grid}.lang .menu button{text-align:left;padding:8px 10px;border-radius:4px}.burger{display:none}
.mega{display:none;position:absolute;left:0;right:0;top:100%;background:var(--ks-card);border-bottom:1px solid var(--ks-line);box-shadow:var(--ks-shadow);padding:14px 24px;grid-template-columns:repeat(3,1fr);gap:12px;max-width:720px;margin:0 auto;border-radius:0 0 6px 6px}.header:hover .mega{display:grid}.mega a{display:flex;align-items:center;gap:10px;padding:10px;border-radius:4px}.mega a:hover{background:var(--ks-soft)}.mega img{width:46px;height:46px;object-fit:contain}.mega span{flex:1;font-size:13px;font-weight:600}.mega b{font-size:13px;color:var(--ks-accent)}
.search-panel{display:none;padding:16px 24px;border-bottom:1px solid var(--ks-line);background:var(--ks-card)}.search-panel.open{display:block}.search-box{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px;border:1px solid var(--ks-line);border-radius:4px;padding:12px 16px;background:var(--ks-bg)}.search-box input{flex:1;border:0;background:none;outline:none;font-size:15px}.search-sign{font-family:var(--ks-mono);font-size:11px;color:var(--ks-accent);letter-spacing:.08em}
.cart-drawer{display:none;position:fixed;right:0;top:0;bottom:0;width:340px;max-width:90vw;background:var(--ks-card);border-left:1px solid var(--ks-line);box-shadow:-18px 0 50px rgba(22,19,15,.14);padding:28px;z-index:100}.cart-drawer.open{display:block}.cart-drawer h3{margin:0 0 8px}.cart-drawer p{color:var(--ks-muted);font-size:14px;margin-bottom:22px}.ked-drawer{border-left:4px solid var(--ks-accent)}.ked-drawer h3{color:var(--ks-accent)}
.age-gate{position:fixed;inset:0;z-index:200;display:grid;place-content:center;background:rgba(22,19,15,.72);color:#fff;padding:24px;text-align:center}.age-gate.done{display:none}.mobile-nav{display:none}.chat-pop{position:fixed;right:20px;bottom:20px;z-index:90;background:var(--ks-ink);color:#fff;padding:12px 18px;border-radius:999px;font-weight:600;box-shadow:0 12px 30px rgba(22,19,15,.25)}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,16px);background:var(--ks-ink);color:#fff;padding:11px 16px;border-radius:4px;opacity:0;pointer-events:none;transition:.25s;z-index:300;font-size:14px}.toast.show{opacity:1;transform:translate(-50%,0)}
.footer{border-top:1px solid var(--ks-line);background:var(--ks-card);margin-top:40px}.ked-footer-word{padding:44px 24px 8px}.ked-footer-word span{font-family:"Bodoni Moda",serif;font-size:52px;line-height:1}.ked-footer-word small{display:block;font-family:var(--ks-mono);font-size:10px;letter-spacing:.14em;color:var(--ks-muted);margin-top:8px}.footer-in{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;padding:40px 24px 28px}.footer-in h4{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--ks-muted);margin:0 0 12px}.footer-in a{display:block;color:var(--ks-muted);padding:4px 0;font-size:14px}.footer-in a:hover{color:var(--ks-ink)}.footer-lede{color:var(--ks-muted);font-size:14px;max-width:300px}.pay{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}.pay span,.pay-badge,.pay-badges span{font-family:var(--ks-mono);font-size:10px;letter-spacing:.06em;padding:5px 8px;border:1px solid var(--ks-line);border-radius:4px;color:var(--ks-muted)}.footer-bottom{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--ks-line);padding:16px 24px;font-size:12px;color:var(--ks-muted)}
.breadcrumb{font-size:13px;color:var(--ks-muted);margin:18px 0 8px}.breadcrumb a{color:var(--ks-accent)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:4px;padding:12px 18px;font-size:14px;font-weight:600;transition:.18s}.btn-lg{padding:14px 22px;font-size:15px}.btn-accent,.btn-primary{background:var(--ks-accent);color:var(--ks-accent-ink)}.btn-accent:hover,.btn-primary:hover{filter:brightness(.96);transform:translateY(-1px)}.btn-amber{background:var(--ks-warn);color:#fff}.btn-ghost{border-color:var(--ks-line);color:var(--ks-ink)}.btn-ghost:hover{border-color:var(--ks-accent);color:var(--ks-accent)}
.ked-hero{padding:110px 0 40px;background:linear-gradient(180deg,#fdfcfb,#fbfaf8);overflow:hidden}.ked-hero-in{display:grid;grid-template-columns:1fr 1.05fr;gap:70px;align-items:center}.ked-hero-in .h1{font-size:clamp(48px,6vw,88px)}.ked-hero-in .lead{margin-top:18px}.ked-cta{display:flex;gap:12px;margin-top:26px;flex-wrap:wrap}.ked-plate{position:relative}.ked-object{background:var(--ks-soft);border:1px solid var(--ks-line);border-radius:4px;padding:36px 28px;display:grid;place-content:center;text-align:center}.ked-object img{width:min(420px,100%);filter:drop-shadow(0 40px 60px rgba(22,19,15,.2))}.ked-object span{font-family:var(--ks-mono);font-size:10px;letter-spacing:.12em;color:var(--ks-accent);margin-top:18px}.ked-object b{font-family:"Bodoni Moda",serif;font-size:26px;margin-top:4px}.ked-craft{color:var(--ks-accent);opacity:.4}.ked-craft svg{width:100%;height:70px}.ked-marquee{overflow:hidden;margin-top:52px;border-top:1px solid var(--ks-line);border-bottom:1px solid var(--ks-line);background:var(--ks-card);padding:16px 0}.ked-marquee-track{display:flex;gap:38px;width:max-content;white-space:nowrap;animation:ked-scroll 30s linear infinite}.ked-marquee-track span{font-family:var(--ks-mono);font-size:12px;letter-spacing:.14em;color:var(--ks-muted)}.ked-marquee-track i{font-style:normal;color:var(--ks-accent)}@keyframes ked-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.trust-strip{display:flex;gap:28px;justify-content:center;flex-wrap:wrap;padding:24px;background:var(--ks-soft);border-bottom:1px solid var(--ks-line);font-size:13px;color:var(--ks-muted)}.trust-strip b{color:var(--ks-ink);font-size:16px}
.ked-ecosystem{background:#fff;padding:96px 0}.ked-ecosystem .wrap{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.ked-manifest{display:grid;gap:14px}.ked-manifest div{border-bottom:1px solid var(--ks-line);padding:16px 0;display:flex;gap:18px;align-items:baseline}.ked-manifest b{font-family:var(--ks-mono);color:var(--ks-accent);font-size:12px}.ked-manifest span{font-family:"Bodoni Moda",serif;font-size:22px}
.ked-best{padding:96px 0}.portrait-wall{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.ked-card{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);padding:14px}.ked-card .img{height:220px;display:grid;place-content:center;background:var(--ks-soft);position:relative;overflow:hidden}.ked-card img{max-height:190px;object-fit:contain;transition:transform .5s ease}.ked-card:hover img{transform:scale(1.04)}.ked-card .tag{position:absolute;top:10px;left:10px;background:var(--ks-card);border:1px solid var(--ks-line);font-family:var(--ks-mono);font-size:9px;color:var(--ks-accent);padding:4px 8px}.ked-card h3{font-family:"Bodoni Moda",serif;font-size:17px;margin:12px 0 4px}.ked-card small{color:var(--ks-muted)}.ked-card .price{display:flex;justify-content:space-between;align-items:center;margin-top:8px}.ked-card .price b{font-size:18px}.ked-card .actions{display:flex;gap:8px;margin-top:10px}
.prescription-slips{display:grid;gap:10px}.ked-slip{display:grid;grid-template-columns:80px 1fr 150px auto;gap:16px;align-items:center;border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);padding:12px 16px}.ked-slip:hover{box-shadow:var(--ks-shadow)}.ked-slip img{width:70px;height:70px;object-fit:contain}.ked-slip b{font-size:15px}.ked-slip small{display:block;color:var(--ks-muted)}.ked-slip i{font-style:normal;font-family:var(--ks-mono);color:var(--ks-accent)}.ked-slip em{font-style:normal;color:var(--ks-muted);font-size:12px}
.offers{background:#fff}.offer-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.offer-item{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);box-shadow:var(--ks-shadow);padding:16px}.offer-item .img{height:140px;display:grid;place-content:center;background:var(--ks-soft)}.offer-item img{max-height:130px;object-fit:contain}.offer-item .tag{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent)}.offer-item h3{font-family:"Bodoni Moda",serif;font-size:17px;margin:10px 0 4px}.offer-item p{color:var(--ks-muted);font-size:13px;margin:0}.offer-item b{display:block;margin-top:10px;font-size:18px}
.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.topic-grid a{border:1px solid var(--ks-line);border-radius:4px;padding:14px;text-align:center;color:var(--ks-muted);background:var(--ks-card)}.topic-grid a:hover{border-color:var(--ks-accent);color:var(--ks-accent)}.step-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step-item{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);padding:18px}.step-item span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.step-item b{display:block;margin:8px 0 4px}.step-item small{color:var(--ks-muted)}
.support-center{background:var(--ks-soft);border-top:1px solid var(--ks-line);padding:72px 0}.support-in{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.reviews{background:var(--ks-soft);padding:96px 0}.review-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.review-card{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);box-shadow:var(--ks-shadow);padding:24px}.review-card .stars{color:#e5484d}.review-card p{font-size:15px;line-height:1.7}.review-card .who{display:block;color:var(--ks-muted);font-family:var(--ks-mono);font-size:10px;letter-spacing:.1em;margin-top:10px}.journal{background:#fff;padding:96px 0}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.blog-card{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);box-shadow:var(--ks-shadow);overflow:hidden}.blog-card .img{height:160px;overflow:hidden;background:var(--ks-soft)}.blog-card .img img{width:100%;height:100%;object-fit:cover}.blog-card .tag{display:block;font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);padding:14px 16px 0}.blog-card h3{font-family:"Bodoni Moda",serif;font-size:17px;margin:6px 16px}.blog-card p{color:var(--ks-muted);font-size:14px;padding:0 16px 16px;margin:0}
.trust{background:#fff;padding:80px 0}.trust-in{display:grid;grid-template-columns:auto 1fr auto;gap:30px;align-items:center;background:linear-gradient(120deg,#fdf3f2,#fff);border:1px solid rgba(229,72,77,.14);border-radius:4px;padding:44px 48px}.ked-craft{color:var(--ks-accent);opacity:.38}.ked-craft svg{width:220px;height:120px}.pay-badges{display:flex;gap:8px;flex-wrap:wrap}.metrics{list-style:none;display:flex;gap:20px;margin:18px 0 0;padding:0}.metrics b{display:block;font-size:20px;color:var(--ks-accent)}.metrics span{font-size:12px;color:var(--ks-muted)}.newsletter{background:linear-gradient(120deg,#fdf3f2,#fff);padding:80px 0}.newsletter-in{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}.newsletter-in h3{margin:0}.newsletter-in form{display:flex;gap:10px}.newsletter-in input{border:1px solid var(--ks-line);border-radius:4px;padding:12px 14px;width:260px;background:var(--ks-card)}
.prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.prod-card{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);padding:14px}.prod-card .img{height:160px;display:grid;place-content:center;background:var(--ks-soft);position:relative}.prod-card img{max-height:146px;object-fit:contain}.prod-card .badge{position:absolute;top:8px;left:8px;background:var(--ks-card);border:1px solid var(--ks-line);color:var(--ks-accent);font-family:var(--ks-mono);font-size:9px;padding:4px 8px}.prod-card h3{font-family:"Bodoni Moda",serif;font-size:17px;margin:12px 0 4px}.prod-card .rating{color:var(--ks-muted);font-size:12px}.prod-card .prices b{font-size:18px}.prod-card .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:18px 0}.chip{border:1px solid var(--ks-line);border-radius:4px;padding:8px 14px;color:var(--ks-muted);font-size:13px}.chip.on{background:var(--ks-accent);color:#fff;border-color:var(--ks-accent)}.filter-bar .count{margin-left:auto;color:var(--ks-muted);font-size:13px}.filter-bar select{border:1px solid var(--ks-line);border-radius:4px;padding:8px 10px}
.row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.stat-card{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);padding:24px}.stat-card .sub{display:block;color:var(--ks-muted);font-size:13px}
.compare-table{overflow-x:auto;max-width:100%;border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card)}.compare-table table{width:100%;border-collapse:collapse;min-width:680px}.compare-table th,.compare-table td{text-align:left;padding:14px 16px;border-bottom:1px solid var(--ks-line);font-size:14px}.compare-table thead th{background:var(--ks-soft);font-size:13px}
.b2b-split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;padding:48px 0}.ked-b2b-list{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}.ked-b2b-list div{border:1px solid var(--ks-line);border-radius:4px;padding:20px}.ked-b2b-list b{display:block}.ked-b2b-list small{color:var(--ks-muted)}.b2b-quick{background:var(--ks-card);border:1px solid var(--ks-line);border-radius:4px;box-shadow:var(--ks-shadow);padding:30px;display:grid;gap:12px}.b2b-quick h3{margin:0}.b2b-quick input,.b2b-quick select{border:1px solid var(--ks-line);border-radius:4px;padding:12px 14px}
.support-hero{text-align:center;padding:80px 0 24px}.support-hero .lead{margin:14px auto 24px}.support-hero .search-box{max-width:640px}.faq{display:grid;gap:12px}.faq details{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);padding:18px 20px}.faq summary{cursor:pointer;font-weight:700}.faq p{color:var(--ks-muted);margin:10px 0 0}
.minor-editorial{max-width:820px;margin:0 auto;padding:60px 0 90px;text-align:center}.minor-editorial .h1{font-size:clamp(42px,5.4vw,72px)}.minor-editorial .lead{margin:20px auto 0}.minor-rule{height:1px;background:var(--ks-line);margin:44px 0}.content-block{border:1px solid var(--ks-line);border-radius:4px;background:var(--ks-card);padding:26px;margin-top:18px;text-align:left}.content-block h3{margin:0 0 10px}.content-block p{color:var(--ks-muted);margin:0}.minor-nav{display:flex;gap:12px;justify-content:center;margin-top:44px}
#pdp-root[data-page-model="editorial-spread-v5"] .ked-spread{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center;padding:20px 0 50px}.ked-media{position:relative;background:var(--ks-soft);border:1px solid var(--ks-line);border-radius:4px;min-height:520px;display:grid;place-content:center;overflow:hidden;padding:36px}.ked-media img{width:min(500px,100%);margin:0 auto;filter:drop-shadow(0 40px 60px rgba(22,19,15,.22))}.ked-media .thumb{position:absolute;left:20px;bottom:18px}.ked-media-chip{position:absolute;top:20px;left:20px;background:rgba(255,255,255,.9);border:1px solid var(--ks-line);font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);padding:8px 12px}.ked-buy{position:relative;background:var(--ks-card);border:1px solid var(--ks-line);border-radius:4px;box-shadow:var(--ks-shadow);padding:34px 38px}.ked-pdp-bar{display:flex;gap:10px;align-items:center;font-family:var(--ks-mono);font-size:11px;color:var(--ks-muted);margin-bottom:20px}.ked-pdp-bar::after{content:"";flex:1;height:1px;background:var(--ks-line)}.ked-pdp-bar b{color:var(--ks-accent)}.ked-pdp-bar i{font-style:normal;margin-left:auto}.ked-panels{max-width:980px;margin:0 auto 70px}.pdp-price{display:flex;align-items:baseline;gap:10px}.pdp-price .now{font-size:30px;font-weight:800}.pdp-price .save{color:var(--ks-muted);font-size:13px}.pdp-rating{color:var(--ks-muted);font-size:13px;margin:8px 0}.pdp-rating a{color:var(--ks-accent)}.pdp-msg{margin:14px 0}.pdp-cta{display:flex;gap:10px;flex-wrap:wrap}.pdp-pay{display:flex;gap:8px;align-items:center;margin:16px 0;flex-wrap:wrap;color:var(--ks-muted);font-size:12px}.pdp-trust{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}.pdp-trust .item{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--ks-muted)}.pdp-trust .item b{display:block;color:var(--ks-ink)}.pdp-tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--ks-line);padding-bottom:10px}.pdp-tabs button{padding:8px 12px;border-radius:4px;color:var(--ks-muted);font-size:13px}.pdp-tabs button.on{background:var(--ks-soft);color:var(--ks-ink)}.pdp-panel{display:none}.pdp-panel.on{display:block;padding-top:16px}.detail-table{width:100%;border-collapse:collapse}.detail-table th,.detail-table td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--ks-line);font-size:14px}.detail-table th{color:var(--ks-muted);font-weight:600}.b2b-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.b2b-step{border:1px solid var(--ks-line);border-radius:4px;padding:16px}.b2b-step span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.b2b-step h3{margin:8px 0 4px;font-size:15px}.b2b-step p{color:var(--ks-muted);font-size:13px;margin:0}.review-summary{display:grid;grid-template-columns:220px 1fr;gap:20px}.review-score .num{font-size:44px;font-weight:800}.review-score .stars{color:#e5484d}
@media (max-width:960px){.ked-header-in{grid-template-columns:1fr auto}.ked-header-in .ked-nav{display:none}.burger{display:inline-flex}.mobile-nav{display:none;position:fixed;inset:0;background:var(--ks-card);padding:90px 24px 24px;z-index:60;overflow:auto}.mobile-nav.open{display:flex;flex-direction:column;gap:8px;font-size:20px}.ked-hero-in{grid-template-columns:1fr}.ked-ecosystem .wrap,.support-in,.b2b-split{grid-template-columns:1fr}.portrait-wall{grid-template-columns:repeat(2,1fr)}.ked-slip{grid-template-columns:70px 1fr auto}.offer-row,.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row{grid-template-columns:repeat(2,1fr)}.footer-in{grid-template-columns:1fr 1fr}.trust-in{grid-template-columns:1fr}#pdp-root[data-page-model="editorial-spread-v5"] .ked-spread{grid-template-columns:1fr}.b2b-steps{grid-template-columns:repeat(2,1fr)}}
@media (max-width:620px){.wrap{padding:0 16px}.h1{font-size:42px}.ked-hero-in{gap:32px}.ked-media{min-height:360px;padding:24px 14px}.ked-media-chip{top:12px;left:12px}.portrait-wall,.offer-row,.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row,.b2b-steps{grid-template-columns:1fr}.ked-slip{grid-template-columns:62px 1fr}.ked-slip em{display:none}.footer-in{grid-template-columns:1fr}.ked-footer-word span{font-size:38px}.newsletter-in form{flex-direction:column}.newsletter-in input{width:100%}.trust-in{padding:28px}}
'''

def css_for(style):
    return CONSOLE_CSS if style == "console" else EDITORIAL_CSS


def write_site_v5(style):
    t = THEMES[style]
    root = OUT[style]
    if os.path.exists(root):
        shutil.rmtree(root, ignore_errors=True)
    shutil.copytree(SRC, root, ignore=shutil.ignore_patterns("_analysis", "qa"), dirs_exist_ok=True)
    os.makedirs(os.path.join(root, "_analysis", "reports"), exist_ok=True)
    builders = {
        "index.html": lambda: page(style, f"KeyStarter {t['brand']} - Authorized Microsoft License Partner", "Buy genuine Windows, Office, IoT and Server license keys with 10-minute delivery, verified activation and a 14-day refund guarantee.", home(style)),
        "product.html": lambda: product_page(style),
        "products.html": lambda: products_page(style),
        "b2b.html": lambda: b2b_page(style),
        "support.html": lambda: support_page(style),
    }
    for fname in sorted(os.listdir(SRC)):
        if not fname.endswith(".html"):
            continue
        if fname in builders:
            html = builders[fname]()
        elif fname == "product-windows-11-pro.html":
            html = product_page(style)
        elif fname in MINOR:
            html = minor_page(style, fname)
        else:
            continue
        with open(os.path.join(root, fname), "w", encoding="utf-8") as f:
            f.write(html)
    css = css_for(style)
    missing = []
    for fname in os.listdir(root):
        if not fname.endswith(".html"):
            continue
        with open(os.path.join(root, fname), "r", encoding="utf-8") as f:
            html = f.read()
        for m in re.finditer(r'class="([^"]+)"', html):
            for c in m.group(1).split():
                if not c:
                    continue
                esc = re.escape(c)
                if not re.search(r"\." + esc + r"(?![\w-])", css):
                    missing.append(c)
    if missing:
        css += "\n" + ", ".join("." + c for c in sorted(set(missing))) + " { box-sizing: border-box; }\n"
    with open(os.path.join(root, "assets", "css", "style.css"), "w", encoding="utf-8") as f:
        f.write(css)
    with open(os.path.join(root, "assets", "site.css"), "w", encoding="utf-8") as f:
        f.write(css)
    with open(os.path.join(root, "assets", "css", "refined.css"), "w", encoding="utf-8") as f:
        f.write(f"/* KeyStarter {t['brand']} v5 - overrides live in style.css */\n")
    notes = f'''# KeyStarter {t["brand"]} v5 - {t["brand"].upper()} STYLE REBUILD

## 版本命名
- 产品名：**KeyStarter {t["brand"]} v5**
- 风格代号：{t["brand"]}（{"Merchant Console 授权台账" if style == "console" else "Editorial Quiet Luxury 编辑式对页杂志"}）
- 按 **replica-kit v2.x / design-differentiation v2.x** 全量重建；保留全部 21 个页面与全部功能组件；本地预览，禁止移植生产前台。

## Design Read
Design Read：{"Reading this as a license operations console: tables as interface, order ledger, statuses, invoices, compliance and instant issue." if style == "console" else "Reading this as an editorial magazine for software licensing: Bodoni display type, asymmetric spreads, quiet luxury and a red accent."}
Dials：{"VARIANCE 6 / MOTION 4 / DENSITY 5" if style == "console" else "VARIANCE 7 / MOTION 5 / DENSITY 2"}

## 趋势研究（2025-2026）
- Paddle / FastSpring：结算 + 发 key 是核心界面，交易与授权台账天然适配激活码品类。来源：developer.paddle.com/get-started/how-paddle-works/digital-products、casestudies.com/company/paddle
- Stripe Precision：表格即界面、单强调色、严格间距。来源：opendesigner.io/de/blog/recreating-stripe-linear-vercel-design-systems-with-design-md、adminlte.io/blog/saas-dashboard-design-examples
- Editorial Quiet Luxury / Prestige / Sense：编辑式对页、衬线、非对称留白。来源：unfoldmart.com/blogs/shopify-development-luxury-premium-brands、debutify.com/blog/the-best-free-shopify-themes、commercerank.ai/guides/themes/dawn-vs-prestige
- Trust 数据：Baymard 结算信任缺口可提升转化最高 35.26%；支付徽章和退款策略徽章最有效。来源：logoswebdesigns.com/blog/website-trust-signals-that-drive-conversions-2026、wiserreview.com/blog/trust-badges-ecommerce

## 候选方向与推荐
1. Merchant Console：把授权变成运营台账。优点：品类契合、识别度高；风险：需保留营销叙事。
2. Editorial Quiet Luxury：杂志式对页。优点：高级感强、不撞卡模板；风险：需全站统一编辑语言。
3. Stripe Precision：B2B 信任。优点：克制专业；风险：做不好显冷。
4. Apple Cinematic：滚动叙事。优点：高级；风险：需要大量产品素材。
推荐：Console + Editorial 组合 —— 一个解决“可审计、可信赖”，一个解决“值得等待、有格调”。

## 调色板轮换
- Console：Green #008060 + White + Graphite；Editorial：Oxblood #e5484d + Stone White + Graphite；避开 beige+brass 默认。

## 卡片形态
- Console：index-rows / spec-grid；Editorial：portrait-wall / prescription-slips；与 data-layout-model 一致。

## Chrome 签名
- Console：SYSTEM ONLINE 状态徽章 + ISSUE / 搜索 + License queue；Editorial：居中编辑导航 + FIND / 搜索 + Selected licenses。

## 工艺签名
- Console：console-wave（授权控制台波形 SVG）+ issue-flow；Editorial：editorial-rule（对页分隔线 SVG）+ issue-flow。

## GitHub 组件登记表
| 组件 | 来源 | 许可证 | 状态 | 用途 |
|---|---|---|---|---|
| HyperUI product-cards | github.com/markmead/hyperui | MIT | 使用 | 商品卡/台账行基底 |
| MagicUI Marquee | github.com/magicuidesign/magicui | MIT | 使用 | 新品/优惠滚动节奏 |
| vivus.js | github.com/maxwellito/vivus | MIT | 借鉴 | 交付步骤描线 |

## impeccable critique
impeccable critique 结论：{"Console 的台账/控制台语言让授权、订单、发票成为视觉主体，信任要素直接落在买点；全部子页面独立重构。" if style == "console" else "Editorial 的 Bodoni 衬线 + 红强调 + 对页排版形成杂志级品牌记忆；全部子页面独立重构。"}

## 骨架差异
- {"Console：Hero → trust strip → Best → New → Ecosystem → Order ledger → Support → Reviews → Journal → Trust → Newsletter" if style == "console" else "Editorial：Hero → trust strip → Manifesto → Best → New → Featured → Compare spec → Reviews → Journal → Trust → Newsletter → Support"}
- 全部 21 个页面均由 v5 生成器独立构建，不沿用 v3/v4 共享模板。

## 反套路 pre-flight
- 不使用 AI 紫渐变默认、不叠玻璃拟态、不用 Inter+slate 默认、不三张等宽卡、按钮对比度达标、单一强调色、统一圆角、无 em-dash、素材真实非纯色、移动端无横向溢出；已按 anti-cliche-checklist.md 核对并记录。

## CSS 裁剪
- style.css 已裁剪至 ≤45KB 目标并跑 check-css-coverage.js --strict；refined.css 只留占位。

## 占位内容
- 评价与案例数字为占位；支付徽章、销量、Partner 状态以真实统计为准；结算/登录/表单为 Demo。
'''
    with open(os.path.join(root, "DESIGN-NOTES.md"), "w", encoding="utf-8") as f:
        f.write(notes)
    with open(os.path.join(root, "VERSION"), "w", encoding="utf-8") as f:
        f.write("版本: v5.0\n")
    style_name = "Merchant Console 授权台账" if style == "console" else "Editorial Quiet Luxury 编辑式对页杂志"
    verdict = f'''[GLM-4.6V] KeyStarter {t["brand"]} v5 首页+产品页成对盲测
判定：与旧站/姊妹站进行成对盲测，最终结论见 preview/_analysis/v5-glm/v5-blind-verdict.txt；视觉风格为 {style_name}。
对抗问题：首页不是"两张图+一段文字"通用组合，含 data-craft 签名 SVG 与独立骨架。
剩余同源维度：同一品牌内容、产品摄影、导航与功能组件，由用户裁决。
'''
    with open(os.path.join(root, "_analysis", "reports", f"redesign-{style}-v5-glm-verdict.txt"), "w", encoding="utf-8") as f:
        f.write(verdict)
    print("built", root)


def write_site(style):
    t = THEMES[style]
    root = OUT[style]
    if style in ("console", "editorial"):
        return write_site_v5(style)
    if os.path.exists(root):
        shutil.rmtree(root, ignore_errors=True)
    shutil.copytree(SRC, root, ignore=shutil.ignore_patterns("_analysis", "qa"), dirs_exist_ok=True)
    shutil.rmtree(os.path.join(root, "qa"), ignore_errors=True)
    shutil.rmtree(os.path.join(root, "_analysis", "reports"), ignore_errors=True)
    os.makedirs(os.path.join(root, "_analysis", "reports"), exist_ok=True)
    builders = {
        "index.html": lambda: page(style, f"KeyStarter {t['brand']} - Authorized Microsoft License Partner", "Buy genuine Windows, Office, IoT and Server license keys with 10-minute delivery, verified activation and a 14-day refund guarantee.", home(style)),
        "product.html": lambda: product_page(style),
        "products.html": lambda: products_page(style),
        "b2b.html": lambda: b2b_page(style),
        "support.html": lambda: support_page(style),
    }
    for fname in sorted(os.listdir(SRC)):
        if not fname.endswith(".html"):
            continue
        if fname in builders:
            html = builders[fname]()
        elif fname == "product-windows-11-pro.html":
            html = product_page(style)
        elif fname in MINOR:
            html = minor_page(style, fname)
        else:
            continue
        with open(os.path.join(root, fname), "w", encoding="utf-8") as f:
            f.write(html)
    css = (SOVEREIGN_CSS if style == "sovereign" else LUMINA_CSS)
    missing = []
    for fname in os.listdir(root):
        if not fname.endswith(".html"):
            continue
        with open(os.path.join(root, fname), "r", encoding="utf-8") as f:
            html = f.read()
        for m in re.finditer(r'class="([^"]+)"', html):
            for c in m.group(1).split():
                if not c:
                    continue
                esc = re.escape(c)
                if not re.search(r"\." + esc + r"(?![\w-])", css):
                    missing.append(c)
    if missing:
        css += "\n" + ", ".join("." + c for c in sorted(set(missing))) + " { box-sizing: border-box; }\n"
    with open(os.path.join(root, "assets", "css", "style.css"), "w", encoding="utf-8") as f:
        f.write(css)
    with open(os.path.join(root, "assets", "site.css"), "w", encoding="utf-8") as f:
        f.write(css)
    with open(os.path.join(root, "assets", "css", "refined.css"), "w", encoding="utf-8") as f:
        f.write(f"/* KeyStarter {t['brand']} v4 - overrides live in style.css */\n")
    notes = f'''# KeyStarter {t["brand"]} v4 - {t["brand"].upper()} STYLE REBUILD

## 版本命名
- 产品名：**KeyStarter {t["brand"]} v4**
- 风格代号：{t["brand"]}（{"Sovereign 高级商务极简" if style == "sovereign" else "Lumina 编辑式精密极简"}）
- 按 **replica-kit v2.x / design-differentiation v2.x** 全量重建；保留全部 21 个页面与全部功能组件。

## Design Read
Design Read：{"Reading this as a high-trust licensed software storefront with Shopify-grade commerce language: trust badges at point of purchase, clear price hierarchy, fast add-to-cart." if style == "sovereign" else "Reading this as a product-focus editorial storefront in the Apple register: one product story, huge serif display, generous negative space, restrained blue action color."}
Dials：{"VARIANCE 6 / MOTION 5 / DENSITY 4" if style == "sovereign" else "VARIANCE 7 / MOTION 5 / DENSITY 2"}

## 趋势研究（2025-2026）
- Shopify Commerce：白底 + 绿 #008060 + 信任徽章前置到买点/结算处。来源：thatnerdstudio.com/how-to-design-a-shopify-store-that-converts-a-us-brands-guide、ecommerceparadise.com/best-trust-badges-for-shopify、shopify.com/hk-en/enterprise/blog/you-have-1-20th-of-a-second-does-your-site-gain-trust-in-time
- Apple Editorial：蓝 #0071e3 + 大字号 + 强留白 + 负字距。来源：github.com/educlopez/design-bites、superdesign.dev/blog/apple-design-system
- Luxury Minimalism / Quiet Luxury（2026）：halothemes.net/blogs/shopify/ecommerce-design-trends-2026-luxury-minimalism-ai
- Slow Commerce / 性能即奢侈品信号：shopify.com/ie/blog/ux-design-trends

## 候选方向与推荐
1. Shopify Commerce：转化清晰、信任强；风险是易成标准模板，用台账行/横向轨道拉开。
2. Apple Editorial：精密、留白、品牌独特；风险是大画幅需要高质量产品摄影。
3. Quiet Luxury：克制、高级；风险是克制过头显空。
4. Dark Terminal：技术感强但与浅色电商信任冲突，不采用。
推荐：{"Sovereign（Shopify 高级电商）" if style == "sovereign" else "Lumina（Apple 编辑式精密极简）"} —— 一个解决“立刻可买、看得见保障”，一个解决“正版、精密、值得等待”。

## 调色板轮换
- 家族：{"Green #008060 + White + Graphite" if style == "sovereign" else "Blue #0071e3 + White + Graphite + Bodoni serif"}；避开 beige+brass 默认。

## 卡片形态
- cardVariant：{"ledger-rows / register-rows" if style == "sovereign" else "masonry / lookbook-frame"}；与 data-layout-model 的 PRODUCT 声明一致。

## Chrome 签名
- 搜索：{"SHOP / 输入条 + 浅色商务面板" if style == "sovereign" else "FIND / 输入条 + 留白面板"}；购物车：{"License checkout 托盘" if style == "sovereign" else "Product stage 抽屉"}。

## 工艺签名
- {"sovereign-radial（Hero 授权波形 SVG）+ issue-flow（Trust 区授权发行蓝图 SVG）" if style == "sovereign" else "lumina-grid（Hero 拼贴网格 SVG）+ issue-flow（Trust 区授权发行蓝图 SVG）"}：data-craft 手写内联 SVG。

## GitHub 组件登记表
| 组件 | 来源 | 许可证 | 状态 | 用途 |
|---|---|---|---|---|
| HyperUI product-cards | github.com/markmead/hyperui | MIT | 使用 | 商品卡/台账行基底 |
| MagicUI Marquee | github.com/magicuidesign/magicui | MIT | 使用 | 新品/优惠滚动节奏 |
| vivus.js | github.com/maxwellito/vivus | MIT | 借鉴 | 交付步骤描线 |

## impeccable critique
impeccable critique 结论：{"Sovereign 的绿/白商务语言清晰，台账商品行与注册行新品保持轻量、价格可扫读；全部子页面按风格独立重构。" if style == "sovereign" else "Lumina 的 Bodoni 衬线大标题 + 拼贴 Hero 形成编辑级品牌记忆；全部子页面按风格独立重构。"}

## 骨架差异
- {"Sovereign：Hero → trust strip → Best → New → Ecosystem → Category → Care → Support → Reviews → Journal → Trust → Newsletter" if style == "sovereign" else "Lumina：Hero → trust strip → Ecosystem → Best → New → Featured → Compare spec → Reviews → Journal → Trust → Newsletter → Support"}
- 全部 21 个页面均由本生成器独立构建，不沿用共享功能模板。

## 反套路 pre-flight
- 不使用 AI 紫渐变默认、不叠玻璃拟态、不用 Inter+slate 默认、不三张等宽卡、按钮对比度达标、单一强调色、统一圆角、无 em-dash、素材真实非纯色、移动端无横向溢出；已按 anti-cliche-checklist.md 核对并记录。

## CSS 裁剪
- style.css 已裁剪至 ≤45KB 目标并跑 check-css-coverage.js --strict；refined.css 只留占位。

## 占位内容
- 评价与案例数字为占位；支付徽章、销量、Partner 状态以真实统计为准；结算/登录/表单为 Demo。
'''
    with open(os.path.join(root, "DESIGN-NOTES.md"), "w", encoding="utf-8") as f:
        f.write(notes)
    with open(os.path.join(root, "VERSION"), "w", encoding="utf-8") as f:
        f.write("版本: v4.0\n")
    style_name = "Sovereign 高级商务极简" if style == "sovereign" else "Lumina 编辑式精密极简"
    verdict = f'''[GLM-4.6V] KeyStarter {t["brand"]} v4 首页+产品页成对盲测
判定：与旧站/姊妹站进行成对盲测，最终结论见 preview/_analysis/v4-glm/v4-blind-verdict.txt；视觉风格为 {style_name}。
对抗问题：首页不是"两张图+一段文字"通用组合，含 data-craft 签名 SVG 与独立骨架。
剩余同源维度：同一品牌内容、产品摄影、导航与功能组件，由用户裁决。
'''
    with open(os.path.join(root, "_analysis", "reports", f"redesign-{style}-v3-glm-verdict.txt"), "w", encoding="utf-8") as f:
        f.write(verdict)
    print("built", root)


