  </div></div></section>'''
    offers = '''<section class="offers" id="ked-offers"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Featured releases</span><h2 class="h2">This week's selection</h2></div><a class="btn btn-ghost" href="products.html">View all 28 products</a></div><div class="offer-row"><a class="offer-item" href="product-windows-11-pro.html"><div class="img"><img src="assets/img/box-win11-pro.webp" alt="Windows 11 Pro"></div><div><span class="tag">BEST SELLER</span><h3>Windows 11 Pro OEM</h3><p>Save up to 40% vs retail list.</p><b>from $18.00</b></div></a><a class="offer-item" href="product.html?slug=office-2021-pro-plus"><div class="img"><img src="assets/img/box-office-2021.webp" alt="Office 2021"></div><div><span class="tag">PRODUCTIVITY</span><h3>Office 2021 Pro Plus</h3><p>Perpetual license for 1 PC.</p><b>$58.00</b></div></a><a class="offer-item" href="product.html?slug=win-11-iot-2024-value"><div class="img"><img src="assets/img/box-iot-win11-value.webp" alt="Win 11 IoT"></div><div><span class="tag">EMBEDDED</span><h3>Win 11 IoT Value</h3><p>LTSC with 10-year servicing.</p><b>$85.00</b></div></a></div></div></section>'''
