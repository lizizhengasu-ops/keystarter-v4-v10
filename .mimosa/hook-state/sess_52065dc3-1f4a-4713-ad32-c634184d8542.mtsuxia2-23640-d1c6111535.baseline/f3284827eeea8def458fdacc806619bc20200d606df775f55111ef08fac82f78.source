    blocks = "\n".join(f'<section class="content-block"><h3>{h}</h3>{b}</section>' for h, b in sections)
    if style == "console":
        body = f'''<div class="wrap"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>{eyebrow}</span></div><div class="minor-layout"><aside class="minor-side"><span class="eyebrow">KeyStarter</span><h2>{eyebrow}</h2><a href="products.html">Products</a><a href="b2b.html">Enterprise</a><a href="support.html">Help desk</a><a href="blog.html">Journal</a><a href="contact.html">Contact</a></aside><div class="minor-main"><span class="eyebrow">{eyebrow}</span><h1 class="h2">{title}</h1><p class="lead">{intro}</p>{blocks}</div></div></div>'''
    else:
        body = f'''<div class="wrap"><div class="breadcrumb"><a href="index.html">Home</a> <span>/</span> <span>{eyebrow}</span></div><div class="minor-editorial"><span class="eyebrow">{eyebrow}</span><h1 class="h1">{title}</h1><p class="lead">{intro}</p><div class="minor-rule"></div>{blocks}<div class="minor-nav"><a href="products.html">Browse products</a><a href="support.html">Support</a><a href="contact.html">Contact</a></div></div></div>'''
    return page(style, f"{title} | KeyStarter", intro, body, canonical=f"https://keys-starter.com/{fname.replace('.html','')}")


CONSOLE_CSS = r'''
[data-theme="console"] { --ks-bg:#ffffff; --ks-ink:#10130f; --ks-muted:#5f6b66; --ks-line:#e5ebe8; --ks-card:#ffffff; --ks-accent:#008060; --ks-accent-ink:#ffffff; --ks-soft:#f4f7f5; --ks-warn:#b45309; --ks-font:"Manrope",sans-serif; --ks-mono:"IBM Plex Mono",monospace; --ks-radius:10px; --ks-shadow:0 1px 2px rgba(16,19,15,.04),0 18px 44px -34px rgba(16,19,15,.3); --ks-header:rgba(255,255,255,.94); }
@font-face{font-family:"Manrope";src:url("../fonts/manrope-500.woff2") format("woff2");font-weight:500;font-display:swap;}
@font-face{font-family:"Manrope";src:url("../fonts/manrope-700.woff2") format("woff2");font-weight:700;font-display:swap;}
@font-face{font-family:"Manrope";src:url("../fonts/manrope-800.woff2") format("woff2");font-weight:800;font-display:swap;}
@font-face{font-family:"IBM Plex Mono";src:url("../fonts/ibm-plex-mono-400.woff2") format("woff2");font-weight:400;font-display:swap;}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:var(--ks-font);background:var(--ks-bg);color:var(--ks-ink);line-height:1.55;-webkit-font-smoothing:antialiased}img{max-width:100%;display:block}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}.section{padding:64px 0}.section.tight{padding:44px 0}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:28px}.section-head h1,.section-head h2,.section-head h3{margin:6px 0 0}.eyebrow{font-family:var(--ks-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ks-accent);font-weight:600}.h1{font-size:clamp(42px,5.6vw,76px);line-height:1;letter-spacing:-.05em;margin:12px 0;font-weight:800}.h2{font-size:clamp(26px,3vw,40px);line-height:1.05;letter-spacing:-.03em;margin:0;font-weight:800}.h3{font-size:18px;line-height:1.2;margin:8px 0;font-weight:700}.lead{font-size:17px;color:var(--ks-muted);max-width:640px}.muted{color:var(--ks-muted)}.icon{width:18px;height:18px;vertical-align:middle}.lg{width:24px;height:24px}
.announce{position:relative;z-index:20;font-size:12px;padding:8px 18px;text-align:center;border-bottom:1px solid var(--ks-line);background:var(--ks-card);color:var(--ks-muted);display:flex;gap:14px;justify-content:center;flex-wrap:wrap}.announce a{color:var(--ks-accent);font-weight:600}.promo-msg{font-family:var(--ks-mono);letter-spacing:.08em;font-size:10px;color:var(--ks-ink)}.ksc-announce{border-bottom:1px solid rgba(0,128,96,.18);background:#f0f7f3}.ksc-announce .promo-msg{color:var(--ks-accent)}.ksc-ver{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);border:1px solid rgba(0,128,96,.25);border-radius:999px;padding:3px 8px}
.header{position:sticky;top:0;z-index:50;background:var(--ks-header);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--ks-line)}.header-in{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:20px}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:17px}.brand small{display:block;font-family:var(--ks-mono);font-size:9px;letter-spacing:.1em;color:var(--ks-muted);font-weight:500}.brand-logo{width:28px;height:28px;object-fit:contain}.nav{display:flex;gap:4px;font-size:14px}.nav a{padding:8px 11px;border-radius:8px;color:var(--ks-muted)}.nav a:hover{color:var(--ks-ink);background:var(--ks-soft)}.header-actions{display:flex;align-items:center;gap:6px}.header-actions button{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:8px;color:var(--ks-muted)}.header-actions button:hover{background:var(--ks-soft);color:var(--ks-ink)}.count{font-size:11px;margin-left:3px}.lang{position:relative}.lang>button{width:auto;padding:0 8px;gap:4px}.lang .menu{display:none;position:absolute;right:0;top:calc(100% + 6px);background:var(--ks-card);border:1px solid var(--ks-line);border-radius:10px;box-shadow:var(--ks-shadow);padding:6px;min-width:150px;z-index:80}.lang.open .menu{display:grid}.lang .menu button{text-align:left;padding:8px 10px;border-radius:6px}.burger{display:none}.ksc-status{display:inline-flex;align-items:center;gap:6px;font-family:var(--ks-mono);font-size:10px;letter-spacing:.08em;color:var(--ks-accent);border:1px solid rgba(0,128,96,.25);border-radius:999px;padding:5px 10px}.ksc-status::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ks-accent)}
.mega{display:none;position:absolute;left:0;right:0;top:100%;background:var(--ks-card);border-bottom:1px solid var(--ks-line);box-shadow:var(--ks-shadow);padding:14px 24px;grid-template-columns:repeat(3,1fr);gap:12px;max-width:720px;margin:0 auto;border-radius:0 0 12px 12px}.header:hover .mega{display:grid}.mega a{display:flex;align-items:center;gap:10px;padding:10px;border-radius:8px}.mega a:hover{background:var(--ks-soft)}.mega img{width:46px;height:46px;object-fit:contain}.mega span{flex:1;font-size:13px;font-weight:600}.mega b{font-size:13px;color:var(--ks-accent)}
.search-panel{display:none;padding:16px 24px;border-bottom:1px solid var(--ks-line);background:var(--ks-card)}.search-panel.open{display:block}.search-box{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px;border:1px solid var(--ks-line);border-radius:10px;padding:10px 14px;background:var(--ks-bg)}.search-box input{flex:1;border:0;background:none;outline:none;font-size:15px}.search-sign{font-family:var(--ks-mono);font-size:11px;color:var(--ks-accent);letter-spacing:.08em}
.cart-drawer{display:none;position:fixed;right:0;top:0;bottom:0;width:340px;max-width:90vw;background:var(--ks-card);border-left:1px solid var(--ks-line);box-shadow:-18px 0 50px rgba(16,19,15,.12);padding:28px;z-index:100}.cart-drawer.open{display:block}.cart-drawer h3{margin:0 0 8px}.cart-drawer p{color:var(--ks-muted);font-size:14px;margin-bottom:22px}.ksc-drawer{border-left:4px solid var(--ks-accent)}.ksc-drawer h3{color:var(--ks-accent)}
.age-gate{position:fixed;inset:0;z-index:200;display:grid;place-content:center;background:rgba(16,19,15,.72);color:#fff;padding:24px;text-align:center}.age-gate.done{display:none}.mobile-nav{display:none}.chat-pop{position:fixed;right:20px;bottom:20px;z-index:90;background:var(--ks-ink);color:#fff;padding:12px 18px;border-radius:999px;font-weight:600;box-shadow:0 12px 30px rgba(16,19,15,.25)}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,16px);background:var(--ks-ink);color:#fff;padding:11px 16px;border-radius:8px;opacity:0;pointer-events:none;transition:.25s;z-index:300;font-size:14px}.toast.show{opacity:1;transform:translate(-50%,0)}
.footer{border-top:1px solid var(--ks-line);background:var(--ks-card);margin-top:40px}.footer-in{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;padding:48px 24px 28px}.footer-in h4{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--ks-muted);margin:0 0 12px}.footer-in a{display:block;color:var(--ks-muted);padding:4px 0;font-size:14px}.footer-in a:hover{color:var(--ks-ink)}.footer-lede{color:var(--ks-muted);font-size:14px;max-width:300px}.pay{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}.pay span,.pay-badge,.pay-badges span{font-family:var(--ks-mono);font-size:10px;letter-spacing:.06em;padding:5px 8px;border:1px solid var(--ks-line);border-radius:5px;color:var(--ks-muted)}.footer-bottom{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--ks-line);padding:16px 24px;font-size:12px;color:var(--ks-muted)}
.breadcrumb{font-size:13px;color:var(--ks-muted);margin:18px 0 8px}.breadcrumb a{color:var(--ks-accent)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:8px;padding:10px 16px;font-size:14px;font-weight:600;transition:.16s}.btn-lg{padding:13px 20px;font-size:15px}.btn-accent,.btn-primary{background:var(--ks-accent);color:var(--ks-accent-ink)}.btn-accent:hover,.btn-primary:hover{filter:brightness(.96);transform:translateY(-1px)}.btn-amber{background:var(--ks-warn);color:#fff}.btn-ghost{border-color:var(--ks-line);color:var(--ks-ink)}.btn-ghost:hover{border-color:var(--ks-accent);color:var(--ks-accent)}
.ksc-hero{padding:96px 0 48px;background:radial-gradient(120% 90% at 50% 0%,rgba(0,128,96,.1),transparent 60%),linear-gradient(180deg,#fbfdfc,#fff);overflow:hidden}.ksc-hero-in{max-width:1080px;margin:0 auto;text-align:center;position:relative}.ksc-hero-in .h1{font-size:clamp(44px,5.6vw,80px)}.ksc-hero-in .lead{margin:20px auto 0}.ksc-cta{display:flex;gap:12px;justify-content:center;margin-top:24px;flex-wrap:wrap}.ksc-console{width:min(820px,100%);margin:44px auto 0;background:var(--ks-card);border:1px solid var(--ks-line);border-radius:16px;box-shadow:var(--ks-shadow);padding:24px;text-align:left}.ksc-console-head{display:flex;justify-content:space-between;gap:10px;font-family:var(--ks-mono);font-size:10px;letter-spacing:.12em;color:var(--ks-muted);padding-bottom:14px;border-bottom:1px solid var(--ks-line)}.ksc-console-head b{color:var(--ks-accent)}.ksc-console-head i{font-style:normal}.ksc-console-key{font-family:var(--ks-mono);font-size:15px;letter-spacing:.08em;background:var(--ks-soft);border-radius:10px;padding:14px;margin:16px 0;text-align:center}.ksc-console-rows{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px}.ksc-console-rows span{color:var(--ks-muted);font-family:var(--ks-mono)}.ksc-console-rows b{text-align:right}.ksc-craft{color:var(--ks-accent);opacity:.4}.ksc-craft svg{width:100%;height:78px}.ksc-marquee{overflow:hidden;margin-top:44px;border-top:1px solid var(--ks-line);border-bottom:1px solid var(--ks-line);background:var(--ks-card);padding:14px 0}.ksc-marquee-track{display:flex;gap:34px;width:max-content;white-space:nowrap;animation:ksc-scroll 26s linear infinite}.ksc-marquee-track span{font-family:var(--ks-mono);font-size:12px;letter-spacing:.1em;color:var(--ks-muted)}.ksc-marquee-track i{font-style:normal;color:var(--ks-accent)}@keyframes ksc-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.trust-strip{display:flex;gap:28px;justify-content:center;flex-wrap:wrap;padding:22px 24px;background:var(--ks-soft);border-bottom:1px solid var(--ks-line);font-size:13px;color:var(--ks-muted)}.trust-strip b{color:var(--ks-ink);font-size:16px}
.ksc-best{padding:88px 0}.index-rows{display:grid}.ksc-row{display:grid;grid-template-columns:80px 120px 1fr 130px 140px auto;gap:18px;align-items:center;border:1px solid var(--ks-line);border-bottom:0;padding:16px 18px;background:var(--ks-card)}.ksc-row:first-child{border-radius:12px 12px 0 0}.ksc-row:last-child{border-bottom:1px solid var(--ks-line);border-radius:0 0 12px 12px}.ksc-row:hover{background:var(--ks-soft)}.ksc-row .num{font-family:var(--ks-mono);color:var(--ks-muted);font-size:13px}.ksc-row .img{width:110px;height:110px;display:grid;place-content:center;background:var(--ks-soft);border-radius:10px;position:relative}.ksc-row img{max-height:100px;object-fit:contain}.ksc-row .badge{position:absolute;top:6px;left:6px;background:var(--ks-accent);color:#fff;font-family:var(--ks-mono);font-size:8px;padding:3px 6px;border-radius:5px}.ksc-row h3{font-size:16px;margin:0 0 4px}.ksc-row small{color:var(--ks-muted)}.ksc-row .status{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent)}.ksc-row .price{font-size:19px;font-weight:800}.ksc-row .actions{display:flex;gap:8px}
.spec-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.ksc-spec{border:1px solid var(--ks-line);border-radius:14px;background:var(--ks-card);padding:14px}.ksc-spec .img{height:150px;display:grid;place-content:center;background:var(--ks-soft);border-radius:10px}.ksc-spec img{max-height:140px;object-fit:contain}.ksc-spec>span{font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent)}.ksc-spec h3{font-size:15px;margin:10px 0 4px}.ksc-spec small{color:var(--ks-muted)}.ksc-spec .price{display:flex;justify-content:space-between;align-items:center;margin-top:10px}.ksc-spec .price b{font-size:18px}.ksc-spec .price em{font-style:normal;color:var(--ks-accent);font-size:12px}
.ksc-ecosystem{background:linear-gradient(180deg,var(--ks-soft),#fff);padding:84px 0}.ksc-ecosystem .wrap{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center}.ksc-timeline{display:grid;gap:10px}.ksc-tl{border-left:2px solid var(--ks-accent);padding:4px 0 4px 18px}.ksc-tl b{display:block;font-size:14px}.ksc-tl small{color:var(--ks-muted)}
.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.topic-grid a{border:1px solid var(--ks-line);border-radius:10px;padding:14px;text-align:center;color:var(--ks-muted);background:var(--ks-card)}.topic-grid a:hover{border-color:var(--ks-accent);color:var(--ks-accent)}.step-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step-item{border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card);padding:18px}.step-item span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.step-item b{display:block;margin:8px 0 4px}.step-item small{color:var(--ks-muted)}
.support-center{background:var(--ks-soft);border-top:1px solid var(--ks-line);padding:72px 0}.support-in{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.reviews{background:var(--ks-soft);padding:84px 0}.review-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.review-card{border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card);box-shadow:var(--ks-shadow);padding:20px}.review-card .stars{color:#f59e0b}.review-card p{font-size:14px;line-height:1.6}.review-card .who{display:block;color:var(--ks-muted);font-family:var(--ks-mono);font-size:10px;letter-spacing:.08em;margin-top:10px}.journal{background:#fff;padding:84px 0}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.blog-card{border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card);box-shadow:var(--ks-shadow);overflow:hidden}.blog-card .img{height:150px;overflow:hidden;background:var(--ks-soft)}.blog-card .img img{width:100%;height:100%;object-fit:cover}.blog-card .tag{display:block;font-family:var(--ks-mono);font-size:10px;color:var(--ks-accent);padding:12px 14px 0}.blog-card h3{font-size:15px;margin:6px 14px}.blog-card p{color:var(--ks-muted);font-size:13px;padding:0 14px 14px;margin:0}
.trust{background:#fff;padding:70px 0}.trust-in{display:grid;grid-template-columns:auto 1fr auto;gap:30px;align-items:center;background:linear-gradient(120deg,#f0f7f3,#fff);border:1px solid rgba(0,128,96,.14);border-radius:18px;padding:36px 40px}.ksc-craft{color:var(--ks-accent);opacity:.4}.ksc-craft svg{width:220px;height:120px}.pay-badges{display:flex;gap:8px;flex-wrap:wrap}.metrics{list-style:none;display:flex;gap:20px;margin:18px 0 0;padding:0}.metrics b{display:block;font-size:20px;color:var(--ks-accent)}.metrics span{font-size:12px;color:var(--ks-muted)}.newsletter{background:linear-gradient(120deg,#f0f7f3,#fff);padding:70px 0}.newsletter-in{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}.newsletter-in h3{margin:0}.newsletter-in form{display:flex;gap:10px}.newsletter-in input{border:1px solid var(--ks-line);border-radius:10px;padding:10px 12px;width:260px;background:var(--ks-card)}
.prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.prod-card{border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card);padding:14px}.prod-card .img{height:150px;display:grid;place-content:center;background:var(--ks-soft);border-radius:10px;position:relative}.prod-card img{max-height:138px;object-fit:contain}.prod-card .badge{position:absolute;top:8px;left:8px;background:var(--ks-accent);color:#fff;font-family:var(--ks-mono);font-size:9px;padding:4px 8px;border-radius:6px}.prod-card h3{font-size:15px;margin:12px 0 4px}.prod-card .rating{color:var(--ks-muted);font-size:12px}.prod-card .prices b{font-size:18px}.prod-card .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:18px 0}.chip{border:1px solid var(--ks-line);border-radius:999px;padding:8px 14px;color:var(--ks-muted);font-size:13px}.chip.on{background:var(--ks-accent);color:#fff;border-color:var(--ks-accent)}.filter-bar .count{margin-left:auto;color:var(--ks-muted);font-size:13px}.filter-bar select{border:1px solid var(--ks-line);border-radius:8px;padding:8px 10px}
.row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.stat-card{border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card);padding:22px}.stat-card .sub{display:block;color:var(--ks-muted);font-size:13px}
.compare-table{overflow-x:auto;max-width:100%;border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card)}.compare-table table{width:100%;border-collapse:collapse;min-width:680px}.compare-table th,.compare-table td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--ks-line);font-size:14px}.compare-table thead th{background:var(--ks-soft);font-size:13px}
.b2b-split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;padding:40px 0}.ksc-b2b-list{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px}.ksc-b2b-list div{border:1px solid var(--ks-line);border-radius:12px;padding:18px}.ksc-b2b-list b{display:block}.ksc-b2b-list small{color:var(--ks-muted)}.b2b-quick{background:var(--ks-card);border:1px solid var(--ks-line);border-radius:16px;box-shadow:var(--ks-shadow);padding:26px;display:grid;gap:12px}.b2b-quick h3{margin:0}.b2b-quick input,.b2b-quick select{border:1px solid var(--ks-line);border-radius:10px;padding:11px 12px}
.support-hero{text-align:center;padding:70px 0 20px}.support-hero .lead{margin:14px auto 24px}.support-hero .search-box{max-width:640px}.faq{display:grid;gap:12px}.faq details{border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card);padding:16px 18px}.faq summary{cursor:pointer;font-weight:700}.faq p{color:var(--ks-muted);margin:10px 0 0}
.minor-layout{display:grid;grid-template-columns:260px 1fr;gap:48px;padding:40px 0 70px}.minor-side{position:sticky;top:96px;align-self:start;display:grid;gap:8px}.minor-side a{color:var(--ks-muted);padding:8px 0;border-bottom:1px solid var(--ks-line)}.minor-side a:hover{color:var(--ks-accent)}.minor-main{max-width:760px}.content-block{border:1px solid var(--ks-line);border-radius:12px;background:var(--ks-card);padding:22px;margin-top:18px}.content-block h3{margin:0 0 8px}.content-block p{color:var(--ks-muted);margin:0}
#pdp-root[data-page-model="console-checkout-v5"] .pdp{grid-template-columns:1fr 1fr;gap:38px}#pdp-root[data-page-model="console-checkout-v5"] .pdp-media{border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-soft);min-height:430px}#pdp-root[data-page-model="console-checkout-v5"] .pdp-info{padding:10px 0}.ksc-buy{background:var(--ks-card);border:1px solid var(--ks-line);border-radius:14px;padding:26px;box-shadow:var(--ks-shadow)}.ksc-qty{display:flex;align-items:center;gap:10px;margin:16px 0}.ksc-qty label{font-family:var(--ks-mono);font-size:11px;color:var(--ks-muted);text-transform:uppercase}.ksc-qty select{border:1px solid var(--ks-line);border-radius:8px;padding:8px 10px}.ksc-pdp-bar{display:flex;gap:10px;align-items:center;font-family:var(--ks-mono);font-size:11px;color:var(--ks-muted);margin-bottom:18px}.ksc-pdp-bar b{color:var(--ks-accent)}.ksc-pdp-bar i{font-style:normal;margin-left:auto}.pdp-price{display:flex;align-items:baseline;gap:10px}.pdp-price .now{font-size:30px;font-weight:800}.pdp-price .save{color:var(--ks-muted);font-size:13px}.pdp-rating{color:var(--ks-muted);font-size:13px;margin:8px 0}.pdp-rating a{color:var(--ks-accent)}.pdp-msg{margin:14px 0}.pdp-cta{display:flex;gap:10px;flex-wrap:wrap}.pdp-pay{display:flex;gap:8px;align-items:center;margin:16px 0;flex-wrap:wrap;color:var(--ks-muted);font-size:12px}.pdp-trust{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}.pdp-trust .item{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--ks-muted)}.pdp-trust .item b{display:block;color:var(--ks-ink)}.pdp-tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--ks-line);padding-bottom:10px}.pdp-tabs button{padding:8px 12px;border-radius:8px;color:var(--ks-muted);font-size:13px}.pdp-tabs button.on{background:var(--ks-soft);color:var(--ks-ink)}.pdp-panel{display:none}.pdp-panel.on{display:block;padding-top:16px}.detail-table{width:100%;border-collapse:collapse}.detail-table th,.detail-table td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--ks-line);font-size:14px}.detail-table th{color:var(--ks-muted);font-weight:600}.b2b-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.b2b-step{border:1px solid var(--ks-line);border-radius:12px;padding:16px}.b2b-step span{font-family:var(--ks-mono);color:var(--ks-accent);font-size:11px}.b2b-step h3{margin:8px 0 4px;font-size:15px}.b2b-step p{color:var(--ks-muted);font-size:13px;margin:0}.review-summary{display:grid;grid-template-columns:220px 1fr;gap:20px}.review-score .num{font-size:44px;font-weight:800}.review-score .stars{color:#f59e0b}
@media (max-width:960px){.nav{display:none}.burger{display:inline-flex}.mobile-nav{display:none;position:fixed;inset:0;background:var(--ks-card);padding:90px 24px 24px;z-index:60;overflow:auto}.mobile-nav.open{display:flex;flex-direction:column;gap:8px;font-size:20px}.ksc-console{width:100%}.ksc-ecosystem .wrap,.support-in,.b2b-split{grid-template-columns:1fr}.ksc-row{grid-template-columns:70px 1fr}.ksc-row .img{grid-row:1/span 4}.ksc-row .price{grid-column:2}.ksc-row .actions{grid-column:1/-1}.ksc-row .status{display:none}.spec-grid,.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row{grid-template-columns:repeat(2,1fr)}.footer-in{grid-template-columns:1fr 1fr}.minor-layout{grid-template-columns:1fr}.minor-side{position:static}.trust-in{grid-template-columns:1fr}#pdp-root[data-page-model="console-checkout-v5"] .pdp{grid-template-columns:1fr}.b2b-steps{grid-template-columns:repeat(2,1fr)}}
@media (max-width:620px){.wrap{padding:0 16px}.h1{font-size:42px}.ksc-status{display:none}.ksc-console-rows{grid-template-columns:1fr}.spec-grid,.prod-grid,.blog-grid,.review-list,.row,.topic-grid,.step-row,.b2b-steps{grid-template-columns:1fr}.footer-in{grid-template-columns:1fr}.newsletter-in form{flex-direction:column}.newsletter-in input{width:100%}.trust-in{padding:26px}}
'''


def main():
    build_only = {s.strip() for s in os.environ.get("BUILD_ONLY", "").split(",") if s.strip()}
    for style in OUT:
        if build_only and style not in build_only:
            continue
        write_site(style)


if __name__ == "__main__":
    main()
