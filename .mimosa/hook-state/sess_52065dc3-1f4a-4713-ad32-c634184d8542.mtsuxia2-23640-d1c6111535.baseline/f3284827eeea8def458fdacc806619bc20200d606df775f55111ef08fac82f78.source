    <a class="{p}-slip" href="product.html?slug=office-2021-pro-plus"><img src="assets/img/box-office-2021.webp" alt="Office 2021"><div><b>Office 2021 Pro Plus</b><small>PERPETUAL LICENSE</small></div><i>$58.00</i><em>NEW &rarr;</em></a>
