def page(style, title, desc, body, extra="", canonical="https://keys-starter.com/"):
    t = THEMES[style]
    return f'''<!doctype html>
<html lang="en" data-theme="{style}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content="{desc}">
  <link rel="canonical" href="{canonical}">
  <link rel="alternate" hreflang="en" href="{canonical}">
  <link rel="alternate" hreflang="ja" href="{canonical}?lang=ja">
  <link rel="alternate" hreflang="ko" href="{canonical}?lang=ko">
  <link rel="alternate" hreflang="es" href="{canonical}?lang=es">
  <link rel="alternate" hreflang="pt" href="{canonical}?lang=pt">
  <link rel="alternate" hreflang="fr" href="{canonical}?lang=fr">
  <link rel="alternate" hreflang="x-default" href="{canonical}">
  <link rel="stylesheet" href="assets/css/style.css">
  <link rel="stylesheet" href="assets/css/refined.css">
  <script type="application/ld+json">{{"@context":"https://schema.org","@type":"WebSite","name":"KeyStarter","url":"https://keys-starter.com/","potentialAction":{{"@type":"SearchAction","target":"https://keys-starter.com/products?q={{search_term_string}}","query-input":"required name=search_term_string"}}}}</script>
</head>
<body>
{chrome(style)}
<main>
{body}
</main>
{footer(style)}
<button class="chat-pop" type="button">Support</button>
<div class="toast"></div>
{extra}
<script src="assets/js/gsap.min.js"></script>
