def product_page(style):
    p = THEMES[style]["prefix"]
    model = THEMES[style]["pdp_model"]
    if style in ("console", "editorial"):
        return product_page_v5(style)
    media = '''<div class="pdp-media"><img id="p-img" src="assets/img/box-win11-pro.webp" alt="Product"><div class="thumb"><span class="on"><img id="p-thumb" src="assets/img/box-win11-pro.webp" alt="Product"></span></div></div>'''
