#!/bin/bash
set -e
cd /var/www/keystarter-frontend
mkdir -p assets
[ -f index.html ] && cp index.html index.html.bak
echo Backup done

echo '' | base64 -d > index.html
echo 'index.html OK'

echo '' | base64 -d > assets/index-BVFQ89G8.css
echo 'assets/index-BVFQ89G8.css OK'

echo '' | base64 -d > assets/index-CUAKS8Vy.js
echo 'assets/index-CUAKS8Vy.js OK'

echo '=== Deploy complete! ==='
echo 'Ctrl+F5 hard refresh'
