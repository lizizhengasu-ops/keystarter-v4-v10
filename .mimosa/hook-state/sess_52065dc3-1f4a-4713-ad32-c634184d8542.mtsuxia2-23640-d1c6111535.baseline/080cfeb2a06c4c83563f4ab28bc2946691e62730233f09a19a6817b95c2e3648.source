import {useParams, Link} from "react-router-dom";
import {useState, useEffect} from "react";
import {useCart} from "../CartContext";
import {fetchProducts} from "../api/woocommerce";
import { usePageTitle } from "../usePageTitle";

export default function ProductPage() {
  const {slug} = useParams();
  const cart = useCart();
  const [allProducts, setAllProducts] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [quantity, setQuantity] = useState(1);
  useEffect(() => {
    fetchProducts()
      .then(data => { setAllProducts(data); setLoading(false); })
      .catch(err => { setError(err.message); setLoading(false); });
  }, []);

  const p = allProducts.find(x => x.slug === slug) || null;
  const title = p ? p.name + " - KeyStarter" : "Product";
  usePageTitle(title);
  const savings = p ? Math.round((1 - p.price / p.originalPrice) * 100) : 0;

  if (loading) return (
    <div className="bg-[#f5f5f7] text-[#1d1d1f] antialiased min-h-screen flex items-center justify-center">
      <div className="text-sm text-[#86868b]">Loading...</div>
    </div>
  );

  if (error || !p) return (
    <div className="bg-[#f5f5f7] text-[#1d1d1f] antialiased">
      <div className="max-w-7xl mx-auto px-6 py-20 text-center">
        <h2 className="text-xl font-bold mb-2">Product not found</h2>
        <p className="text-sm text-[#86868b] mb-4">{error || "This product does not exist."}</p>
        <Link to="/store" className="text-sm text-[#0078d4] hover:underline">Browse all products</Link>
      </div>
    </div>
  );

  return (
    <div className="bg-[#f5f5f7] text-[#1d1d1f] antialiased">
      <div className="max-w-7xl mx-auto px-6 py-4 text-xs text-[#86868b]">
        <Link to="/" className="hover:text-[#0078d4] transition">Home</Link>
        <span className="mx-2">/</span>
        <Link to="/store" className="hover:text-[#0078d4] transition">Store</Link>
        <span className="mx-2">/</span>
        <span className="text-[#1d1d1f]">{p.name}</span>
      </div>
      <div className="max-w-7xl mx-auto px-6 pb-16 grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <div className="w-full aspect-[4/3] rounded-2xl bg-gradient-to-br from-[#0078D4]/10 to-[#005A9E]/10 flex items-center justify-center">
            <span className="text-8xl font-bold text-[#0078D4]/20">{p.name[0]}</span>
          </div>
        </div>
        <div>
          <div className="text-[10px] text-[#0078d4] font-semibold uppercase tracking-wider mb-2">Genuine Digital License</div>
          <h1 className="text-3xl font-bold mb-2">{p.name}</h1>
          <p className="text-sm font-medium text-[#86868b] mb-3">{p.category.charAt(0).toUpperCase() + p.category.slice(1)}</p>
          <div className="flex items-center gap-2 mb-4">
            <span className="text-2xl font-extrabold text-[#0078d4]">${p.price.toFixed(2)}</span>
            {p.originalPrice > p.price && (
              <>
                <span className="text-xs text-[#86868b] line-through">${p.originalPrice.toFixed(2)}</span>
                <span className="text-[10px] bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded">Save {savings}%</span>
              </>
            )}
          </div>
          <p className="text-sm text-[#86868b] mb-6">{p.desc}</p>

          <div className="mb-6">
            <div className="text-sm font-semibold mb-3">Quantity</div>
            <div className="flex items-center gap-2">
              <button onClick={() => setQuantity(Math.max(1, quantity - 1))}
                className="w-8 h-8 rounded-lg border border-[#e8e8ed] bg-white text-sm font-semibold hover:bg-[#f5f5f7]">-</button>
              <span className="w-12 text-center text-sm font-semibold">{quantity}</span>
              <button onClick={() => setQuantity(quantity + 1)}
                className="w-8 h-8 rounded-lg border border-[#e8e8ed] bg-white text-sm font-semibold hover:bg-[#f5f5f7]">+</button>
            </div>
          </div>

          <button onClick={() => cart.add({slug: p.slug, name: p.name, price: p.price}, quantity)}
            className="v5-btn w-full bg-[#0078d4] hover:bg-[#0062b1] text-white font-semibold py-3.5 rounded-xl transition mb-2">
            Add to Cart - ${(p.price * quantity).toFixed(2)}
          </button>
          <p className="text-[10px] text-[#86868b] text-center">Genuine product - Instant delivery - Secure checkout</p>

          {p.features && p.features.length > 0 && (
            <div className="mt-8 border-t border-[#e8e8ed] pt-6">
              <h3 className="text-base font-bold mb-4">Product Details</h3>
              {p.features.map((f, i) => (
                <div key={i} className="flex justify-between py-2 border-b border-[#f5f5f7] text-xs">
                  <span className="font-medium">{f}</span>
                </div>
              ))}
              {p.compatibility && (
                <div className="flex justify-between py-2 border-b border-[#f5f5f7] text-xs">
                  <span className="text-[#86868b]">Compatibility</span>
                  <span className="font-medium">{p.compatibility}</span>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
