def fetch_image(entry):
    for attempt in range(3):
        try:
            resp = requests.get(entry["src"], headers=HEADERS, timeout=30, allow_redirects=True)
            if resp.status_code != 200:
                raise RuntimeError("HTTP " + str(resp.status_code))
            img = Image.open(BytesIO(resp.content))
            img.load()
            has_alpha = img.mode in ("RGBA", "LA") or (img.mode == "P" and "transparency" in img.info)
            ext = ".png" if has_alpha else ".jpg"
            out_path = IMG / (entry["name"] + ext)
            if has_alpha:
                img.convert("RGBA").save(out_path, "PNG")
            else:
                img.convert("RGB").save(out_path, "JPEG", quality=92)
            entry["file"] = out_path.name
            entry["local"] = "images/" + out_path.name
            return True
        except Exception as exc:
            if attempt == 2:
                print("FAIL", entry["name"], entry["src"], repr(exc), flush=True)
            else:
                time.sleep(1.2)
    return False


def build_html(sources):
    total = sum(len(v) for v in sources.values())
    parts = []
    parts.append("<!DOCTYPE html>")
    parts.append('<html lang="zh"><head><meta charset="utf-8">')
    parts.append('<meta name="viewport" content="width=device-width, initial-scale=1">')
    parts.append("<title>KeyStarter Product Image Library</title>")
    parts.append("<style>")
    parts.append(
        "body{font-family:Segoe UI,Arial,sans-serif;background:#f5f5f7;color:#1d1d1f;margin:0;padding:28px}"
        "h1{font-size:26px;margin:0 0 6px}.sub{color:#86868b;font-size:14px;margin-bottom:26px}"
        "section{margin-bottom:34px}h2{font-size:18px;margin:0 0 12px}h2 span{color:#7c3aed;font-size:13px;margin-left:6px}"
        ".grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}"
        ".card{background:#fff;border:1px solid #e8e8ed;border-radius:8px;overflow:hidden;display:flex;flex-direction:column}"
        ".imgbox{aspect-ratio:4/3;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}"
        ".imgbox img{max-width:100%;max-height:100%;object-fit:contain}.meta{padding:10px 12px;border-top:1px solid #f0f0f2}"
        ".t{font-size:12px;line-height:1.4;min-height:34px}a{color:#7c3aed;font-size:11px;text-decoration:none}"
    )
    parts.append("</style></head><body>")
    parts.append("<h1>KeyStarter \u4ea7\u54c1\u56fe\u7247\u5e93</h1>")
    parts.append(
        '<div class="sub">\u5171 %d \u5f20\u5019\u9009\u56fe \u00b7 Amazon / \u5b98\u65b9\u7ea2\u8272\u914d\u7f6e / \u7535\u5546\u7248\u672c\u7bb1\u88c5\u56fe \u00b7 2026-07-31</div>'
        % total
    )
    for label, key, entries in GROUPS:
        good = [e for e in entries if e.get("file")]
        if not good:
            continue
        parts.append("<section>")
        parts.append('<h2>%s <span>%d</span></h2>' % (html.escape(label), len(good)))
        parts.append('<div class="grid">')
        for e in good:
            parts.append('<div class="card">')
            parts.append(
                '<div class="imgbox"><img src="images/%s" alt="%s" loading="lazy"></div>'
                % (html.escape(e["file"]), html.escape(e["title"]))
            )
            parts.append('<div class="meta"><div class="t">%s</div>' % html.escape(e["title"]))
            parts.append(
                '<a href="%s" target="_blank" rel="noopener">Source</a></div></div>'
                % html.escape(e["src"])
            )
        parts.append("</div></section>")
    parts.append("</body></html>")
    (LIB / "preview.html").write_text("\n".join(parts), encoding="utf-8")


def main():
    used = set()
    sources = {}
    for label, key, entries in GROUPS:
        for entry in entries:
            ok = fetch_image(entry)
            if ok:
                used.add(entry["file"])
        sources[key] = [e for e in entries if e.get("file")]

    for old in IMG.iterdir():
        if old.is_file() and old.name not in used:
            old.unlink()

    (LIB / "sources.json").write_text(
        json.dumps(sources, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    build_html(sources)
    total = sum(len(v) for v in sources.values())
    print("TOTAL_IMAGES:", total)
    for label, key, entries in GROUPS:
        good = sum(1 for e in entries if e.get("file"))
        print(key, good)


if __name__ == "__main__":
    main()
