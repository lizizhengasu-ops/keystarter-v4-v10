#!/usr/bin/env node
import{execSync}from"child_process";
import{fileURLToPath}from"url";
import path from"path";
var __dirname=path.dirname(fileURLToPath(import.meta.url));
var cwd=path.resolve(__dirname,"..");
try{
  var out=execSync("npm run precommit",{cwd:cwd,stdio:"pipe"});
  console.log(out.toString());
  console.log("[pre-commit] PASSED");
  process.exit(0);
}catch(e){
  var out=e.stdout?e.stdout.toString():"";
  console.log(out||e.message);
  console.log("[pre-commit] FAILED - fix issues or use --no-verify to skip");
  process.exit(1);
}
