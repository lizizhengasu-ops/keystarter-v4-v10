      {/* CARD - dark tile */}
      <section className="tile-wrapper theme-dark section-in" style={{background:"#1c1c1e",padding:"48px 20px",textAlign:"center"}}>
        <div className="tile-content" style={{display:"flex",flexDirection:"column",alignItems:"center"}}>
          <div className="tile-copy-wrapper">
            <h2 style={{fontSize:34,fontWeight:600,color:"#f5f5f7",lineHeight:1.47059,marginBottom:8}}>Pay over time with mifan Card.</h2>
            <p style={{fontSize:24,fontWeight:600,color:"#86868b",lineHeight:1.17648,marginBottom:16,letterSpacing:"0.216px"}}>Get 3% Daily Cash back. 0% APR financing available.</p>
            <a className="hero-link-large" style={{color:"#2997ff",fontSize:"24px",fontWeight:600}}>Learn more</a>
          </div>
        </div>
      </section>


      {/* CARE+ - warranty tile */}
      <section className="scale-in" style={{padding:"48px 20px",background:"#fff",textAlign:"center",borderBottom:"1px solid #f0f0f2"}}>
        <h2 style={{fontSize:24,fontWeight:600,lineHeight:1.33349,marginBottom:8,color:"#1d1d1f"}}>mifan Care+</h2>
        <p style={{fontSize:15,color:"#6e6e73",maxWidth:600,margin:"0 auto 16px",lineHeight:1.6}}>Get unlimited repairs, priority support, and express replacement. Starting at $7.99/mo.</p>
        <a style={{fontSize:15,fontWeight:400,color:"#0071e3",textDecoration:"none",cursor:"pointer"}}>Learn more {">"}</a>
      </section>


      {/* COMPARE */}
      <section className="scale-in section-title" style={{padding:"48px 20px",background:"#fff",textAlign:"center"}}>
        <h2 style={{fontSize:34,fontWeight:600,lineHeight:1.47059,marginBottom:12}}>Which mPhone is right for you?</h2>
        <p style={{fontSize:17,color:"#6e6e73",marginBottom:20}}>Compare specs across every generation. From the original to the latest Pro.</p>
        <a href="/store" className="btn-link" style={{fontSize:17}}>Compare all models {">"}</a>
      </section>


      {/* NEWSLETTER - dark */}
      <section className="scale-in" style={{padding:"48px 20px",background:"#000",color:"#f5f5f7",textAlign:"center"}}>
        <h2 className="section-title" style={{fontSize:24,fontWeight:600,lineHeight:1.33349,marginBottom:8,color:"#1d1d1f"}}>Stay in the loop.</h2>
        <p style={{fontSize:14,color:"#86868b",marginBottom:20,maxWidth:400,margin:"0 auto 20px"}}>Get the latest news, updates, and offers from mifan.</p>
        <div style={{display:"flex",gap:8,maxWidth:400,margin:"0 auto",justifyContent:"center"}}>
          <input type="email" placeholder="Email address" style={{flex:1,padding:"10px 16px",borderRadius:12,border:"1px solid #38383a",background:"#1c1c1e",color:"#f5f5f7",fontSize:14,outline:"none",fontFamily:"inherit"}} />
          <div className="btn-primary" style={{padding:"10px 20px",fontSize:14}}>Sign Up</div>
        </div>
