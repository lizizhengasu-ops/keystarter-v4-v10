        <div style={{display:"flex",gap:16,overflowX:"auto",padding:"0 0 16px 20px",maxWidth:1068,margin:"0 auto",scrollSnapType:"x mandatory"}}>
          {[{n:"mPhone 11 Pro",c:"#1d1d1f",img:"/products/mphone-11-pro.jpg",d:"Triple cameras",s:"mphone-11-pro"},{n:"mPhone X",c:"#000",img:"/products/mphone-x.jpg",d:"All-screen OLED",s:"mphone-x"},{n:"mPhone 6",c:"#ff9500",img:"/products/mphone-6.jpg",d:"Retina HD display",s:"mphone-6"},{n:"mPhone 5S",c:"#ffd60a",img:"/products/mphone-5s.jpg",d:"Touch ID",s:"mphone-5s"}].map((g,i) => (
            <Link key={i} to={"/product/"+g.s} style={{flex:"0 0 260",background:"#fff",borderRadius:18,padding:"24px",border:"1px solid #e6e6ea",textAlign:"center",textDecoration:"none",color:"inherit",display:"block",transition:"all 0.3s"}} className="card-hover">
              <div style={{width:120,height:180,background:"#f5f5f7",borderRadius:12,margin:"0 auto 16px",display:"flex",alignItems:"center",justifyContent:"center"}}>
