      {/* FAQ */}
      <section className="section-in" style={{padding:"48px 20px",background:"#fff"}}>
        <h2 style={{fontSize:34,fontWeight:600,lineHeight:1.47059,textAlign:"center",marginBottom:32,color:"#1d1d1f"}}>Frequently Asked Questions</h2>
        <div style={{maxWidth:700,margin:"0 auto"}}>
          {[
            {q:"What is mPhone 11 Pro?",a:"mPhone 11 Pro features a triple-camera system, ProMotion XDR display, and the A13 Bionic chip ? our most advanced chip ever."},
            {q:"How does trade-in work?",a:"You can trade in your current phone for credit toward a new mPhone. Get - depending on the model and condition."},
            {q:"Is financing available?",a:"Yes, we offer 0% APR financing for qualified buyers. Payments as low as .62 per month."},
            {q:"What is the return policy?",a:"You have 14 days to return your mPhone for a full refund. Items must be in original condition."},
            {q:"Does mPhone come with a warranty?",a:"Every mPhone comes with a 1-year limited warranty. Extend coverage with mifan Care+."},
            {q:"Can I switch from Android?",a:"Yes. The Move to mifan app makes switching easy ? it transfers your contacts, photos, and more."}
          ].map((f,i) => (
