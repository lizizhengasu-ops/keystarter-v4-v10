import {Link} from 'react-router-dom';
import PhoneSVG from '../components/PhoneSVG';
import {useCart} from '../CartContext';
export default function HomePage() {
  const cart = useCart();
  return (
    <>
      {/* HERO */}
      <section className="section section-hero" style={{background:"linear-gradient(180deg,#f5f5f7 0%,#fefefe 100%)",display:"flex",justifyContent:"center",padding:"48px 0 56px",overflow:"clip"}}>
        <div className="tile-wrapper" style={{display:"flex",justifyContent:"center",width:"100%",minHeight:620}}>
          <div className="tile-content" style={{display:"flex",flexDirection:"column",alignItems:"center",textAlign:"center",padding:"0 20px"}}>
            <div className="tile-image-wrapper"><div className="hero-image"><PhoneSVG color="#1d1d1f" large={true} image="/products/mphone-11-pro.jpg" /></div></div>
            <div className="tile-copy-wrapper" style={{marginTop:28}}>
              <h2 className="hero-title" style={{fontSize:34,lineHeight:1.47059,fontWeight:600,color:"#1d1d1f",marginBottom:4}}>mPhone 11 Pro</h2>
              <p className="hero-subtitle" style={{fontSize:24,fontWeight:600,color:"#1d1d1f",lineHeight:1.16667,marginBottom:8,letterSpacing:"0.216px"}}>Pro cameras. Pro performance.</p>
              <p style={{fontSize:17,color:"#6e6e73",maxWidth:500,lineHeight:1.47059,marginBottom:8}}>Triple-camera system. ProMotion XDR display. A13 Bionic chip.</p>
              <p style={{fontSize:17,color:"#6e6e73",maxWidth:500,lineHeight:1.47059,marginBottom:16}}>From $999. Free delivery. No-interest financing available.</p>
              <p style={{fontSize:17,color:"#1d1d1f",marginBottom:20}}>From $999</p>
              <div className="hero-cta tile-ctas" style={{display:"flex",gap:18,justifyContent:"center"}}>
                <div onClick={() => cart.add({slug:"mphone-11-pro",name:"mPhone 11 Pro",price:999})} className="btn-primary" tabIndex={0} role="button" onKeyDown={e=>e.key==="Enter"&&cart.add({slug:"mphone-11-pro",name:"mPhone 11 Pro",price:999})}>Buy</div>
                <Link to="/product/mphone-11-pro" className="hero-link-large" tabIndex={0}>Learn more</Link>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* PRODUCTS */}
      <section style={{padding:"48px 20px 56px",background:"#fff"}}>
        <h2 style={{fontSize:34,fontWeight:600,textAlign:"center",marginBottom:32,lineHeight:1.47059}}>The mPhone lineup</h2>
        <div className="card-grid" style={{maxWidth:1068,margin:"0 auto",display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:16}}>
          {[{n:"mPhone 11 Pro",p:999,s:"mphone-11-pro",c:"#1d1d1f",d:"Pro cameras.",img:"/products/mphone-11-pro.jpg"},{n:"mPhone X",p:899,s:"mphone-x",c:"#000",d:"All-screen OLED.",img:"/products/mphone-x.jpg"},{n:"mPhone 6",p:699,s:"mphone-6",c:"#ff9500",d:"Bigger than bigger.",img:"/products/mphone-6.jpg"},{n:"mPhone 5S",p:599,s:"mphone-5s",c:"#ffd60a",d:"Touch ID. Gold.",img:"/products/mphone-5s.jpg"},{n:"mPhone 5",p:499,s:"mphone-5",c:"#007aff",d:"Lightning fast.",img:"/products/mphone-5.jpg"},{n:"mPhone 4S",p:449,s:"mphone-4s",c:"#2c2c2e",d:"Siri arrives.",img:"/products/mphone-4s.jpg"},{n:"mPhone 4",p:399,s:"mphone-4",c:"#1c1c1e",d:"Retina display.",img:"/products/mphone-4.jpg"},{n:"mPhone 3GS",p:349,s:"mphone-3gs",c:"#48484a",d:"Video recording.",img:"/products/mphone-3gs.jpg"}].map((x,i) => (
            <div key={i} onClick={() => cart.add({slug:x.s,name:x.n,price:x.p})} className="card-item card-hover" tabIndex={0} role="button" onKeyDown={e=>e.key==="Enter"&&cart.add({slug:x.s,name:x.n,price:x.p})} style={{background:"#f5f5f7",borderRadius:18,overflow:"hidden",cursor:"pointer",border:"1px solid #e6e6ea",display:"block",boxShadow:"0 2px 12px rgba(0,0,0,0.06)"}}>
            <div style={{padding:20,textAlign:"center",minHeight:170,display:"flex",alignItems:"center",justifyContent:"center"}}><PhoneSVG color={x.c} image={x.img} /></div>
              <div style={{padding:"16px 14px",textAlign:"center",background:"#fff"}}>
                <h3 style={{fontSize:17,fontWeight:600,color:"#1d1d1f",marginBottom:2}}>{x.n}</h3>
                <p style={{fontSize:11,color:"#6e6e73",marginBottom:4}}>{x.d}</p>
