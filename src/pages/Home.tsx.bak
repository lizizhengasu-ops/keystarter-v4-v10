      </section>



      

      

      {/* VIDEO - mPhone 11 Pro film */}
      <section className="section-in" style={{padding:"48px 20px",background:"#000",textAlign:"center"}}>
        <h2 style={{fontSize:34,fontWeight:600,lineHeight:1.47059,color:"#f5f5f7",marginBottom:8}}>See mPhone 11 Pro in action</h2>
        <p style={{fontSize:17,fontWeight:300,color:"#86868b",marginBottom:24,lineHeight:1.47059}}>Watch the product film.</p>
        <div className="card-hover" style={{maxWidth:700,margin:"0 auto",background:"#1c1c1e",borderRadius:18,padding:"80px 20px",border:"1px solid #38383a",cursor:"pointer",position:"relative",overflow:"hidden"}} role="button" tabIndex={0} aria-label="Play product film" onKeyDown={e=>e.key==="Enter"&&alert('Video would play')}>
          <div style={{width:60,height:60,borderRadius:"50%",background:"#0071e3",display:"flex",alignItems:"center",justifyContent:"center",margin:"0 auto 16px",transition:"transform 0.3s"}} className="play-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
          <p style={{fontSize:14,color:"#86868b"}}>Play film ? 1:30</p>
        </div>
      </section>
      

      {/* PRODUCT SPECS */}
      <section className="section-in" style={{padding:"48px 20px",background:"#fff"}}>
        <h2 style={{fontSize:34,fontWeight:600,lineHeight:1.47059,textAlign:"center",marginBottom:32,color:"#1d1d1f"}}>mPhone 11 Pro Tech Specs</h2>
        <div style={{maxWidth:800,margin:"0 auto",display:"grid",gridTemplateColumns:"repeat(2,1fr)",gap:12}}>
          {[
            {t:"Chip",d:"A13 Bionic chip with third-generation Neural Engine"},
            {t:"Display",d:"6.1-inch Super Retina XDR display with ProMotion"},
            {t:"Camera",d:"Triple 12MP system: Ultra Wide, Wide, Telephoto"},
            {t:"Battery",d:"Up to 20 hours video playback. Fast charge capable."},
            {t:"Storage",d:"64GB / 256GB / 512GB internal storage options"},
            {t:"Water Resistance",d:"IP68 rating ? water resistant to 6 meters for 30 minutes"}
          ].map((s,i) => (
            <div key={i} className="card-hover" style={{background:"#f5f5f7",borderRadius:14,padding:"20px",border:"1px solid #e6e6ea"}}>
              <p style={{fontSize:13,fontWeight:600,color:"#0071e3",marginBottom:4,textTransform:"uppercase",letterSpacing:".05em"}}>{s.t}</p>
              <p style={{fontSize:14,color:"#1d1d1f",lineHeight:1.47059}}>{s.d}</p>
            </div>
          ))}
        </div>
      </section>
      {/* CUSTOMER REVIEWS */}
      <section className="section-in" style={{padding:"48px 20px",background:"#f5f5f7"}}>
        <h2 style={{fontSize:34,fontWeight:600,lineHeight:1.47059,textAlign:"center",marginBottom:32,color:"#1d1d1f"}}>What Our Customers Say</h2>
        <div className="stagger-grid" style={{maxWidth:900,margin:"0 auto",display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:16}}>
          {[
            {n:"Sarah M.",t:"mPhone 11 Pro",r:5,c:"Best phone I have ever owned! The camera is incredible and the battery lasts all day."},
            {n:"James K.",t:"mPhone X",r:5,c:"Smooth upgrade from my old phone. Face ID works flawlessly and the OLED display is stunning."},
            {n:"Lisa C.",t:"mPhone 6",r:4,c:"Great value for the price. Solid performance and the Retina HD display looks beautiful."}
          ].map((r,i) => (
            <div key={i} className="stagger-item card-hover" style={{background:"#fff",borderRadius:18,padding:"28px 24px",border:"1px solid #e6e6ea"}}>
              <p style={{color:"#f5a623",fontSize:16,marginBottom:8,letterSpacing:3}}>{'\u2605'.repeat(r.r)}{'\u2606'.repeat(5-r.r)}</p>
              <p style={{fontSize:14,color:"#6e6e73",lineHeight:1.47059,marginBottom:12,fontStyle:"italic"}}>"{r.c}"</p>
              <p style={{fontSize:13,color:"#1d1d1f",fontWeight:600}}>{r.n}</p>
